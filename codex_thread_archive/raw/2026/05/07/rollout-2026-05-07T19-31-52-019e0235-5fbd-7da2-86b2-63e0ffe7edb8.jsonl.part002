align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 48px;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.local-chat-header strong {\n  font-size: 14px;\n}\n\n.local-chat-header .action-button {\n  min-width: 62px;\n  min-height: 32px;\n}\n\n.local-chat-list {\n  display: flex;\n  max-height: calc(100vh - 270px);\n  flex-direction: column;\n  gap: 10px;\n  padding: 12px;\n  overflow: auto;\n}\n\n.local-chat-message {\n  width: fit-content;\n  max-width: 82%;\n  padding: 9px 11px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--surface-soft);\n  font-size: 13px;\n  line-height: 1.45;\n","exit_code":0,"duration":{"secs":0,"nanos":12916},"formatted_output":"","status":"completed"}}
