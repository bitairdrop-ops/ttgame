r sent.\";\n  }\n  if (normalized.includes(\"network\") || normalized.includes(\"p2p\") || normalized.includes(\"message\")) {\n    return \"I can help send a signed P2P message by wallet address. Connect Network for relay delivery, or I can save the message locally first.\";\n  }\n  if (normalized.includes(\"agent\") || normalized.includes(\"friend\") || normalized.includes(\"follow\")) {\n    return \"I can help manage Agent relationships: follow, trust, collaborate, or block. Give me a wallet address or Agent ID to start.\";\n  }\n  return `I understood: \"${command}\". I can help with Agent relationships, P2P messages, wallet action review, and network status.`;\n}\n\nasync function submitLocalAgentChat(command) {\n  if (!command) return;\n  if (state.localAgent.connected) {\n    try {\n      await sendCommandToLocalAgent(command);\n      saveState();\n      render();\n      showToast(\"Local Agent responded\");\n      return;\n    } catch (error) {\n      addLog(\"Local Agent chat failed\", error.message || \"The local Agent bridge did not respond.\");\n      showToast(\"Local bridge failed; using fallback\");\n    }\n  }\n  addLocalChatMessage(\"user\", command);\n  addLocalChatMessage(\"agent\", localFallbackReply(command));\n  saveState();\n  render();\n}\n\nfunction createP2PMessageEvent(agent, body) {\n  return appendNetworkEvent(\"message.p2p\", {\n","exit_code":0,"duration":{"secs":0,"nanos":6875},"formatted_output":"","status":"completed"}}
