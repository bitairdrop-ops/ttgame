{"timestamp":"2026-05-09T02:39:13.160Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_IV6xsruq135OiZHKpJTocrtO","output":"Chunk ID: 8dc075\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1174\nOutput:\n\nfunction shortAddress(address) {\n  if (!address) return \"Local Agent\";\n  return `${address.slice(0, 6)}...${address.slice(-4)}`;\n}\n\nfunction shortPeerId(value) {\n  if (!value) return \"Manual peer\";\n  if (value.length <= 18) return value;\n  return `${value.slice(0, 8)}...${value.slice(-6)}`;\n}\n\nfunction normalizePeerAddress(value) {\n  return value.trim();\n}\n\nfunction isWalletLike(value) {\n  return /^0x[a-fA-F0-9]{40}$/.test(value) || /^[a-z0-9-]+\\.eth$/i.test(value);\n}\n\nfunction peerAgentId(value) {\n  return `wallet_${value.toLowerCase().replace(/[^a-z0-9]/g, \"_\")}`;\n}\n\nfunction ensurePeerAgent(value) {\n  const address = normalizePeerAddress(value);\n  const existing = allAgents().find((agent) =>\n    agent.id === address ||\n    agent.id === peerAgentId(address) ||\n    agent.handle.toLowerCase() === `@${address}`.toLowerCase() ||\n    agent.actor?.toLowerCase().endsWith(address.toLowerCase())\n  );\n  if (existing) return existing;\n\n  const agent = {\n    id: peerAgentId(address),\n    name: shortPeerId(address),\n    handle: `@${shortPeerId(address)}`,\n    avatar: \"0x\",\n    verified: isWalletLike(address),\n    reputation: isWalletLike(address) ? 76 : 60,\n    followers: \"0\",\n    active: \"now\",\n    description: `Wallet Agent identity for ${address}.`,\n    interests: [\"P2P\", \"Wallet ID\"],\n    skills: [\"agent message\", \"wallet action review\"],\n    category: \"network\",\n    address,\n    actor: `did:pkh:eip155:1:${address}`,\n  };\n  state.customAgents.unshift(agent);\n  return agent;\n}\n\nfunction formatTime(timestamp) {\n  const minutes = Math.max(1, Math.round((Date.now() - timestamp) / 60000));\n  if (minutes < 60) return `${minutes}m ago`;\n  const hours = Math.round(minutes / 60);\n  if (hours < 24) return `${hours}h ago`;\n  return `${Math.round(hours / 24)}d ago`;\n}\n\nfunction escapeHtml(value) {\n  return String(value ?? \"\").replace(/[&<>\"']/g, (char) => ({\n    \"&\": \"&amp;\",\n    \"<\": \"&lt;\",\n    \">\": \"&gt;\",\n    '\"': \"&quot;\",\n    \"'\": \"&#39;\",\n  }[char]));\n}\n\nfunction getAgent(id) {\n  return allAgents().find((agent) => agent.id === id) || allAgents()[0];\n}\n\nfunction allAgents() {\n  const indexed = indexNetworkAgents();\n  return [...indexed, ...state.customAgents.filter((agent) => !indexed.some((item) => item.id === agent.id))];\n}\n\nfunction validNetworkEvents() {\n  return (state.network?.eventLog || []).filter((event) =>\n    event.id &&\n    event.type &&\n    event.actor &&\n    event.signature &&\n    event.topic === NETWORK_TOPIC\n  );\n}\n\nfunction indexNetworkAgents() {\n  const profiles = new Map();\n  const heartbeats = new Map();\n  const relations = new Map();\n\n  validNetworkEvents().forEach((event) => {\n    const payload = event.payload || {};\n    if (event.type === \"agent.profile\") profiles.set(payload.agentId, { ...payload, actor: event.actor, cid: event.cid });\n    if (event.type === \"agent.heartbeat\") heartbeats.set(payload.agentId, payload.lastSeen || event.timestamp);\n    if (event.type.startsWith(\"relation.\") && payload.target && payload.relation) {\n      const key = `${event.actor}:${payload.target}:${payload.relation}`;\n      const current = relations.get(key);\n      if (!current || event.timestamp > current.timestamp) relations.set(key, event);\n    }\n  });\n\n  const countRelation = (target, relation) => [...relations.values()].filter((event) =>\n    event.payload?.target === target &&\n    event.payload?.relation === relation &&\n    !event.type.endsWith(\".removed\")\n  ).length;\n\n  return [...profiles.entries()].map(([id, profile]) => {\n    const followerCount = countRelation(id, \"follow\");\n    const trustCount = countRelation(id, \"trust\");\n    const blockCount = countRelation(id, \"block\");\n    const reputation = Math.max(1, Math.min(99, 65 + trustCount * 8 + followerCount * 4 - blockCount * 18 + (profile.verified ? 10 : 0)));\n    return {\n      id,\n      name: profile.name || id,\n      handle: profile.handle || `@${id.slice(0, 14)}`,\n      avatar: profile.avatar || \"A\",\n      verified: Boolean(profile.verified || profile.proofs?.length > 1),\n      reputation,\n      followers: followerCount ? String(followerCount) : \"0\",\n      active: formatTime(heartbeats.get(id) || Date.now()),\n      description: profile.description || \"Decentralized Agent profile from signed network events.\",\n      interests: profile.interests || [],\n      skills: profile.skills || [],\n      category: profile.category || \"network\",\n      cid: profile.cid,\n      actor: profile.actor,\n    };\n  });\n}\n\nfunction selectedAgent() {\n  return getAgent(state.selectedAgentId);\n}\n\nfunction relationFor(agentId, relation) {\n  return state.relationships.find((item) => item.agentId === agentId && item.relation === relation);\n}\n\nfunction relationshipsFor(agentId) {\n"}}
{"timestamp":"2026-05-09T02:39:13.160Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_um2a6HaspgXFqdKlyTG2pSx5","output":"Chunk ID: 6ba360\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1318\nOutput:\n        <span>${profile.status || statusText} · ${(profile.skills || []).slice(0, 4).join(\" · \") || \"social · research · wallet-check\"}</span>\n      </div>\n    `\n    : `\n      <span class=\"avatar small\">L</span>\n      <div>\n        <strong>No local Agent connected</strong>\n        <span>${state.localAgent.error || \"Open your Agent app, then detect again.\"}</span>\n      </div>\n    `;\n  renderLocalChat();\n}\n\nfunction renderLocalChat() {\n  const messages = state.localAgent.chatHistory || [];\n  elements.localAgentChat.innerHTML = messages.length\n    ? messages.map((message) => `\n      <div class=\"local-chat-message ${message.role === \"user\" ? \"user\" : \"agent\"}\">\n        ${message.body}\n        <small>${message.role === \"user\" ? \"You\" : state.localAgent.profile?.name || \"Local Agent\"} · ${formatTime(message.createdAt)}</small>\n      </div>\n    `).join(\"\")\n    : `<div class=\"empty-state\">Local model replies will appear here after you connect and use Tell OneNode.</div>`;\n  scrollChatToBottom(elements.localAgentChat);\n}\n\nfunction renderOnlineAgent() {\n  const profile = state.onlineAgent.profile;\n  const status = state.onlineAgent.status;\n  const statusClass = status === \"connected\" ? \"trust\" : status === \"connecting\" ? \"follow\" : \"block\";\n  const statusText = {\n    connected: \"Connected\",\n    connecting: \"Connecting\",\n    offline: \"Offline\",\n  }[status] || \"Offline\";\n  elements.onlineAgentStatus.className = `relation-label ${statusClass}`;\n  elements.onlineAgentStatus.textContent = statusText;\n  elements.onlineAgentEndpoint.value = state.onlineAgent.endpoint || \"\";\n  elements.onlineAgentApiKey.value = state.onlineAgent.apiKey || \"\";\n  elements.onlineAgentModel.value = state.onlineAgent.model || \"\";\n  elements.connectOnlineAgentBtn.disabled = status === \"connecting\";\n  elements.disconnectOnlineAgentBtn.disabled = !state.onlineAgent.connected;\n  elements.onlineAgentProfile.innerHTML = profile\n    ? `\n      <span class=\"avatar small\">O</span>\n      <div>\n        <strong>${profile.name || \"Online Agent\"}</strong>\n        <span>${profile.status || statusText} · ${(profile.skills || []).slice(0, 4).join(\" · \") || state.onlineAgent.model}</span>\n      </div>\n    `\n    : `\n      <span class=\"avatar small\">O</span>\n      <div>\n        <strong>No online Agent connected</strong>\n        <span>${state.onlineAgent.error || \"Add an API key, endpoint, and model.\"}</span>\n      </div>\n    `;\n}\n\nfunction renderOnlineChat() {\n  const messages = state.onlineAgent.chatHistory || [];\n  elements.onlineAgentChat.innerHTML = messages.length\n    ? messages.map((message) => `\n      <div class=\"local-chat-message ${message.role === \"user\" ? \"user\" : \"agent\"}\">\n        ${message.body}\n        <small>${message.role === \"user\" ? \"You\" : state.onlineAgent.profile?.name || \"Online Agent\"} · ${formatTime(message.createdAt)}</small>\n      </div>\n    `).join(\"\")\n    : `<div class=\"empty-state\">Online model replies will appear here after you connect and use Tell OneNode.</div>`;\n  scrollChatToBottom(elements.onlineAgentChat);\n}\n\nfunction scrollChatToBottom(element) {\n  window.requestAnimationFrame(() => {\n    element.scrollTop = element.scrollHeight;\n  });\n}\n\nfunction renderInspector() {\n  const agent = selectedAgent();\n  const relationBadges = relationshipsFor(agent.id)\n    .map((item) => `<span class=\"relation-label ${item.relation}\">${relationLabel(item.relation)}</span>`)\n    .join(\"\") || `<span class=\"tag\">No relationship</span>`;\n  const spentPercent = Math.min(100, Math.round((state.spend.spentToday / Math.max(state.spend.dailyLimit, 1)) * 100));\n  elements.agentInspector.innerHTML = `\n    <section class=\"inspector-profile\">\n      <div class=\"profile-head\">\n        <span class=\"avatar\">${agent.avatar}</span>\n        <div>\n          <h2>${agent.name} ${agent.verified ? `<span class=\"verified\">●</span>` : \"\"}</h2>\n          <p>${agent.handle}</p>\n        </div>\n      </div>\n      <p class=\"meta\">${agent.description}</p>\n      <div class=\"inspector-section\">\n        <h3>Reputation</h3>\n        <div class=\"metric-row\"><span>Score</span><strong>${agent.reputation}</strong></div>\n        <div class=\"metric-row\"><span>Followers</span><strong>${agent.followers}</strong></div>\n        <div class=\"metric-row\"><span>Last active</span><strong>${agent.active}</strong></div>\n        <div class=\"metric-row\"><span>Profile CID</span><strong>${agent.cid ? agent.cid.replace(\"ipfs://\", \"\").slice(0, 12) : \"local\"}</strong></div>\n      </div>\n      <div class=\"inspector-section\">\n        <h3>Relationship</h3>\n        <div class=\"tag-list\">${relationBadges}</div>\n      </div>\n      <div class=\"inspector-section\">\n        <h3>Interests</h3>\n        <div class=\"tag-list\">${agent.interests.map((interest) => `<span class=\"tag\">${interest}</span>`).join(\"\")}</div>\n      </div>\n      <div class=\"inspector-section\">\n        <h3>Social Policy</h3>\n        <div class=\"policy-row\"><span>Visible to</span><strong>Everyone</strong></div>\n        <div class=\"policy-row\"><span>Message access</span><strong>Trusted & Followers</strong></div>\n        <div class=\"policy-row\"><span>Collaborations</span><strong>${state.policy.approvalCollaborate ? \"Approval required\" : \"Open\"}</strong></div>\n      </div>\n      <div class=\"inspector-section\">\n"}}
