{"timestamp":"2026-05-08T04:25:15.436Z","type":"response_item","payload":{"type":"custom_tool_call","status":"completed","call_id":"call_gvd8lR74V9PugGyO3TSjkGHh","name":"apply_patch","input":"*** Begin Patch\n*** Update File: script.js\n@@\n let state = loadState();\n+let lastRenderedView = \"\";\n const walletRuntime = {\n@@\n function renderShell() {\n@@\n   elements.navItems.forEach((item) => item.classList.toggle(\"active\", item.dataset.view === state.view));\n   elements.panels.forEach((panel) => panel.classList.toggle(\"active\", panel.dataset.panel === state.view));\n+  if (lastRenderedView !== state.view) {\n+    const activePanel = document.querySelector(`.panel[data-panel=\"${state.view}\"]`);\n+    window.requestAnimationFrame(() => {\n+      window.scrollTo({ top: 0, left: 0 });\n+      if (activePanel) activePanel.scrollTop = 0;\n+    });\n+    lastRenderedView = state.view;\n+  }\n   elements.appShell.classList.toggle(\"agent-workspace-view\", [\"localAgent\", \"onlineAgent\"].includes(state.view));\n*** End Patch\n"}}
