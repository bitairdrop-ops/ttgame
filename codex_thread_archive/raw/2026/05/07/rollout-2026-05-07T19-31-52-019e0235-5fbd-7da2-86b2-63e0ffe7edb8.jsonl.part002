te.localAgent.endpoint || \"\";\n  elements.connectLocalAgentBtn.disabled = status === \"connecting\" || status === \"detecting\";\n  elements.detectLocalAgentBtn.disabled = status === \"connecting\" || status === \"detecting\";\n  elements.disconnectLocalAgentBtn.disabled = !state.localAgent.connected;\n  elements.localAgentProfile.innerHTML = profile\n    ? `\n      <span class=\"avatar small\">${(profile.name || \"L\").slice(0, 1).toUpperCase()}</span>\n      <div>\n        <strong>${profile.name || \"Local Agent\"}</strong>\n        <span>${profile.status || statusText} · ${(profile.skills || []).slice(0, 4).join(\" · \") || \"social · research · wallet-check\"}</span>\n      </div>\n    `\n    : `\n      <span class=\"avatar small\">L</span>\n      <div>\n        <strong>No local Agent connected</strong>\n        <span>${state.localAgent.error || \"Open your Agent app, then detect again.\"}</span>\n      </div>\n    `;\n  renderLocalChat();\n}\n\nfunction renderLocalChat() {\n  const messages = state.localAgent.chatHistory || [];\n  elements.localAgentChat.innerHTML = messages.length\n    ? messages.map((message) => `\n      <div class=\"local-chat-message ${message.role === \"user\" ? \"user\" : \"agent\"}\">\n        ${message.body}\n        <small>${message.role === \"user\" ? \"You\" : state.localAgent.profile?.name || \"Local Agent\"} · ${formatTime(message.createdAt)}</small>\n      </div>\n    `).join(\"\")\n    : `<div class=\"empty-state\">Local model replies will appear here after you connect and use Tell OneNode.</div>`;\n}\n\nfunction renderOnlineAgent() {\n  const profile = state.onlineAgent.profile;\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(payload),\n    });\n  }\n  const text = response.reply || response.message || response.result || \"Local Agent completed the action.\";\n  addLocalChatMessage(\"agent\", text);\n  addLog(\"Local Agent action\", text);\n  if (response.suggestedRelations?.length) {\n    response.suggestedRelations.slice(0, 3).forEach((item) => {\n      const agent = allAgents().find((candidate) => candidate.id === item.agentId || candidate.handle === item.agentId);\n      if (agent && item.relation) {\n        state.relationships.unshift({\n          agentId: agent.id,\n          relation: item.relation,\n          note: item.reason || \"Suggested by Local Agent.\",\n          createdAt: Date.now(),\n        });\n      }\n    });\n  }\n  return true;\n}\n\nfunction render() {\n  renderShell();\n  renderDiscover();\n  renderContacts();\n  renderMessages();\n  renderLog();\n  renderNetwork();\n  renderWallet();\n  renderLocalAgent();\n  renderOnlineAgent();\n  renderOnlineChat();\n  renderInspector();\n}\n\nfunction renderShell() {\n  if (!viewCopy[state.view] || !elements.navItems.some((item) => item.dataset.view === state.view)) {\n    state.view = \"discover\";\n  }\n  elements.navItems.forEach((item) => item.classList.toggle(\"active\", item.dataset.view === state.view));\n  elements.panels.forEach((panel) => panel.classList.toggle(\"active\", panel.dataset.panel === state.view));\n  const [title, subtitle] = viewCopy[state.view];\n  elements.viewTitle.textContent = title;\n  elements.viewSubtitle.textContent = subtitle;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n}\n\n.local-chat {\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.96);\n  overflow: hidden;\n}\n\n.local-chat-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 48px;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.local-chat-header strong {\n  font-size: 14px;\n}\n\n.local-chat-header .action-button {\n  min-width: 62px;\n  min-height: 32px;\n}\n\n.local-chat-list {\n  display: flex;\n  max-height: calc(100vh - 270px);\n  flex-direction: column;\n  gap: 10px;\n  padding: 12px;\n  overflow: auto;\n}\n\n.local-chat-message {\n  width: fit-content;\n  max-width: 82%;\n  padding: 9px 11px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--surface-soft);\n  font-size: 13px;\n  line-height: 1.45;\n"}}
