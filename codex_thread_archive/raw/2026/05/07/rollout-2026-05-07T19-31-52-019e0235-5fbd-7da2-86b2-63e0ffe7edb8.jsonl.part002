{"timestamp":"2026-05-09T02:39:49.285Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_9oPEciEp1dluliudTZHLVm4r","output":"Chunk ID: c46a67\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 865\nOutput:\n  return LEGACY_DEMO_AGENT_IDS.has(String(id || \"\"));\n}\n\nfunction isLegacyDemoEvent(event) {\n  const payload = event?.payload || {};\n  return (\n    isLegacyDemoAgentId(payload.agentId) ||\n    isLegacyDemoAgentId(payload.target) ||\n    LEGACY_DEMO_AGENT_IDS.has(String(event?.actor || \"\").split(\":\").pop()) ||\n    String(event?.actor || \"\").includes(\"peer-agent_\")\n  );\n}\n\nfunction ensureNetworkBootstrap(targetState) {\n  if (targetState.network.bootstrapVersion === NETWORK_BOOTSTRAP_VERSION) return;\n  targetState.network.eventLog = (targetState.network.eventLog || []).filter((event) => !isLegacyDemoEvent(event));\n  targetState.network.bootstrapVersion = NETWORK_BOOTSTRAP_VERSION;\n  targetState.network.syncedAt = Date.now();\n}\n\nfunction purgeDemoAgents(targetState) {\n  if (targetState.demoPurgeVersion === DEMO_PURGE_VERSION) return;\n  targetState.network.eventLog = (targetState.network.eventLog || []).filter((event) => !isLegacyDemoEvent(event));\n  targetState.customAgents = (targetState.customAgents || []).filter((agent) => !isLegacyDemoAgentId(agent.id));\n  targetState.relationships = (targetState.relationships || []).filter((item) => !isLegacyDemoAgentId(item.agentId));\n  targetState.messages = (targetState.messages || []).filter((item) => !isLegacyDemoAgentId(item.agentId));\n  if (isLegacyDemoAgentId(targetState.selectedAgentId)) targetState.selectedAgentId = \"\";\n  targetState.demoPurgeVersion = DEMO_PURGE_VERSION;\n}\n\nfunction applyLayoutMigration(targetState) {\n  if (targetState.layoutVersion === LAYOUT_VERSION) return;\n  targetState.view = \"status\";\n  targetState.layoutVersion = LAYOUT_VERSION;\n}\n\nfunction loadState() {\n  try {\n    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));\n    if (!saved) {\n      const nextState = defaultState();\n      ensureNetworkBootstrap(nextState);\n      purgeDemoAgents(nextState);\n      applyLayoutMigration(nextState);\n      return nextState;\n    }\n    const nextState = {\n      ...defaultState(),\n      ...saved,\n      wallet: { ...defaultState().wallet, ...saved.wallet },\n      localAgent: { ...defaultState().localAgent, ...saved.localAgent },\n      onlineAgent: { ...defaultState().onlineAgent, ...saved.onlineAgent },\n      spend: { ...defaultState().spend, ...saved.spend },\n      policy: { ...defaultState().policy, ...saved.policy },\n      network: {\n        ...defaultState().network,\n        ...saved.network,\n        nostr: { ...defaultState().network.nostr, ...saved.network?.nostr },\n        eventLog: saved.network?.eventLog || [],\n      },\n      customAgents: saved.customAgents || [],\n      relationships: saved.relationships || [],\n      messages: saved.messages || [],\n      log: saved.log || [],\n    };\n    if (saved.contactsResetVersion !== CONTACTS_RESET_VERSION) {\n      nextState.relationships = [];\n      nextState.messages = [];\n      nextState.customAgents = [];\n      nextState.log = (nextState.log || []).filter((item) => item.title?.startsWith(\"Local Agent\") || item.title?.includes(\"Local model\"));\n      nextState.contactsResetVersion = CONTACTS_RESET_VERSION;\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextState));\n    }\n    ensureNetworkBootstrap(nextState);\n    purgeDemoAgents(nextState);\n    applyLayoutMigration(nextState);\n    return nextState;\n  } catch {\n    const nextState = defaultState();\n    ensureNetworkBootstrap(nextState);\n    purgeDemoAgents(nextState);\n    applyLayoutMigration(nextState);\n    return nextState;\n  }\n}\n\n"}}
{"timestamp":"2026-05-09T02:39:49.285Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_ROHM72CK8qNAKdhyGUEk47b7","output":"Chunk ID: d5c741\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 601\nOutput:\nelements.messageForm.addEventListener(\"submit\", async (event) => {\n  event.preventDefault();\n  const body = elements.messageInput.value.trim();\n  const manualPeer = normalizePeerAddress(elements.peerAddressInput.value);\n  if (!body) return;\n  let agent = elements.recipientSelect.value ? getAgent(elements.recipientSelect.value) : null;\n  if (!agent && manualPeer) agent = ensurePeerAgent(manualPeer);\n  if (!agent) {\n    showToast(\"Enter a peer wallet address\");\n    return;\n  }\n  const eventEnvelope = createP2PMessageEvent(agent, body);\n  if (!relationFor(agent.id, \"follow\")) {\n    state.relationships.unshift({\n      agentId: agent.id,\n      relation: \"follow\",\n      note: `P2P peer added from message. Event ${eventEnvelope.cid}.`,\n      createdAt: Date.now(),\n      eventId: eventEnvelope.id,\n      cid: eventEnvelope.cid,\n    });\n  }\n  const agentId = agent.id;\n  state.selectedAgentId = agentId;\n  state.messages.push({\n    id: `msg_${crypto.randomUUID()}`,\n    agentId,\n    direction: \"outbound\",\n    body,\n    createdAt: Date.now(),\n    eventId: eventEnvelope.id,\n    cid: eventEnvelope.cid,\n    signature: eventEnvelope.signature,\n  });\n  addLog(\"Signed P2P message sent\", `Your Agent sent a signed message to ${agent.name}. Event ${eventEnvelope.cid}.`);\n  try {\n    const relayResult = await publishNostrP2PMessage(agent, body, eventEnvelope);\n    if (relayResult.published) {\n      showToast(`P2P sent through ${relayResult.sent} Nostr relay${relayResult.sent > 1 ? \"s\" : \"\"}`);\n    } else {\n      showToast(\"Signed locally. Connect Nostr to deliver.\");\n    }\n  } catch (error) {\n    addLog(\"Nostr publish failed\", error.message || \"The local event was saved but relay publish failed.\");\n    showToast(\"Saved locally; Nostr publish failed\");\n  }\n  elements.messageInput.value = \"\";\n  elements.peerAddressInput.value = \"\";\n  saveState();\n  render();\n});\nelements.agentInspector.addEventListener(\"click\", (event) => {\n  const button = event.target.closest(\"[data-message-agent]\");\n  if (!button) return;\n  state.selectedAgentId = button.dataset.messageAgent;\n  setView(\"messages\");\n});\nelements.connectWalletBtn.addEventListener(\"click\", connectWallet);\nelements.connectNostrBtn.addEventListener(\"click\", connectNostrRelays);\nelements.disconnectNostrBtn.addEventListener(\"click\", () => disconnectNostrRelays(true));\nelements.copyReceiveAddressBtn.addEventListener(\"click\", async () => {\n"}}
