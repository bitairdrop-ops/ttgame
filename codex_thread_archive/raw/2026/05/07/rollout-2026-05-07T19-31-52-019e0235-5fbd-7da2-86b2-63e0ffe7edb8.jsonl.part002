{"timestamp":"2026-05-09T02:40:46.377Z","type":"response_item","payload":{"type":"custom_tool_call","status":"completed","call_id":"call_wwgB5WF7f4IlH9QN6YWJmeOp","name":"apply_patch","input":"*** Begin Patch\n*** Update File: script.js\n@@\n function escapeHtml(value) {\n   return String(value ?? \"\").replace(/[&<>\"']/g, (char) => ({\n@@\n   }[char]));\n }\n+\n+function hashNumber(value) {\n+  return String(value || \"\").split(\"\").reduce((hash, char) => ((hash << 5) - hash + char.charCodeAt(0)) | 0, 0);\n+}\n+\n+function marketAssets() {\n+  const savedAssets = state.investment?.assets;\n+  return Array.isArray(savedAssets) && savedAssets.length ? savedAssets : MARKET_ASSETS;\n+}\n+\n+function assetChange(asset) {\n+  if (Number.isFinite(asset.change24h)) return asset.change24h / 100;\n+  if (!asset.previous) return 0;\n+  return (asset.price - asset.previous) / asset.previous;\n+}\n+\n+function simulatedPortfolioForAgent(agent) {\n+  const assets = marketAssets();\n+  const seed = Math.abs(hashNumber(agent.id || agent.handle || agent.name));\n+  const picks = [assets[seed % assets.length], assets[(seed + 2) % assets.length], assets[(seed + 4) % assets.length]].filter(Boolean);\n+  const rawWeights = picks.map((_, index) => 20 + ((seed >> (index * 4)) % 50));\n+  const total = rawWeights.reduce((sum, value) => sum + value, 0) || 1;\n+  return picks.map((asset, index) => ({\n+    ...asset,\n+    weight: rawWeights[index] / total,\n+  }));\n+}\n+\n+function simulatedInvestmentPerformance(agent) {\n+  const portfolio = simulatedPortfolioForAgent(agent);\n+  const dailyReturn = portfolio.reduce((sum, asset) => sum + asset.weight * assetChange(asset), 0);\n+  const simulatedCapital = 10000;\n+  return {\n+    dailyReturn,\n+    dailyPnl: simulatedCapital * dailyReturn,\n+    portfolio,\n+    source: state.investment?.priceSource || \"fallback\",\n+  };\n+}\n+\n+function formatPercent(value) {\n+  const sign = value > 0 ? \"+\" : \"\";\n+  return `${sign}${(value * 100).toFixed(2)}%`;\n+}\n+\n+function formatUsd(value) {\n+  const sign = value > 0 ? \"+\" : value < 0 ? \"-\" : \"\";\n+  return `${sign}$${Math.abs(value).toFixed(0)}`;\n+}\n+\n+async function refreshMarketPrices() {\n+  if (state.investment?.marketUpdatedAt && Date.now() - state.investment.marketUpdatedAt < 10 * 60 * 1000) return;\n+  try {\n+    const response = await fetch(MARKET_PRICE_URL, { cache: \"no-store\" });\n+    if (!response.ok) throw new Error(`market ${response.status}`);\n+    const prices = await response.json();\n+    state.investment.assets = MARKET_ASSETS.map((asset) => {\n+      const live = prices[asset.id];\n+      const price = Number(live?.usd) || asset.price;\n+      const change24h = Number(live?.usd_24h_change);\n+      const previous = Number.isFinite(change24h) ? price / (1 + change24h / 100) : asset.previous;\n+      return { ...asset, price, previous, change24h };\n+    });\n+    state.investment.priceSource = \"live\";\n+    state.investment.marketUpdatedAt = Date.now();\n+    saveState();\n+    renderDiscover();\n+  } catch (error) {\n+    state.investment.assets = state.investment.assets?.length ? state.investment.assets : MARKET_ASSETS;\n+    state.investment.priceSource = \"fallback\";\n+    state.investment.marketUpdatedAt = Date.now();\n+    saveState();\n+  }\n+}\n \n function getAgent(id) {\n*** End Patch\n"}}
