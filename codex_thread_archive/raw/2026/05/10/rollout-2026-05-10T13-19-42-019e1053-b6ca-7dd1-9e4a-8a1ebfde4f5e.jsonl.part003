lkable_cell(_world_cell_for_position(player.global_position))\n   760\t\tvar goal := _nearest_walkable_cell(_world_cell_for_position(goal_position))\n   761\t\tif not _is_walkable_cell(start) or not _is_walkable_cell(goal):\n   762\t\t\treturn _codex_ai_safe_direction(fallback_direction)\n   763\t\tif start == goal:\n   764\t\t\treturn _codex_ai_safe_direction(fallback_direction)\n   765\t\tvar next_cell := _next_path_cell(start, goal)\n   766\t\tif next_cell == start:\n   767\t\t\treturn _codex_ai_safe_direction(fallback_direction)\n   768\t\treturn _codex_ai_safe_direction((_cell_center(next_cell) - player.global_position).normalized())\n   769\t\n   770\t\n   771\tfunc _codex_ai_safe_direction(direction: Vector2) -> Vector2:\n   772\t\tif direction.length_squared() <= 0.0:\n   773\t\t\treturn Vector2.ZERO\n   774\t\tvar base := direction.normalized()\n   775\t\tif not _codex_ai_direction_blocked(base):\n   776\t\t\treturn base\n   777\t\tvar candidates := [\n   778\t\t\tbase.rotated(PI * 0.5),\n   779\t\t\tbase.rotated(-PI * 0.5),\n   780\t\t\t(base + base.rotated(PI * 0.5)).normalized(),\n   781\t\t\t(base + base.rotated(-PI * 0.5)).normalized(),\n   782\t\t\t-base\n   783\t\t]\n   784\t\tfor candidate in candidates:\n   785\t\t\tif candidate.length_squared() > 0.0 and not _codex_ai_direction_blocked(candidate):\n   786\t\t\t\treturn candidate.normalized()\n   787\t\treturn Vector2.ZERO\n   788\t\n   789\t\n   790\tfunc _codex_ai_direction_blocked(direction: Vector2) -> bool:\n   791\t\tif direction.length_squared() <= 0.0:\n   792\t\t\treturn false\n   793\t\treturn player.test_move(player.global_transform, direction.normalized() * TILE_SIZE * 0.42)\n   794\t\n   795\t\n   796\tfunc _codex_ai_apply_external_command() -> bool:\n   797\t\tif not FileAccess.file_exists(CODEX_AI_COMMAND_PATH):\n   798\t\t\treturn false\n   799\t\tvar text := FileAccess.get_file_as_string(CODEX_AI_COMMAND_PATH)\n   800\t\tif text.is_empty() or text == codex_ai_last_command_text:\n  