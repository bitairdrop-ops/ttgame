ion\n   711\t\treturn best_position\n   712\t\n   713\t\n   714\tfunc _codex_ai_retreat_score(position: Vector2, exit_position: Vector2, analysis: Dictionary) -> float:\n   715\t\tvar nearest_enemy_distance := INF\n   716\t\tvar dangerous_lines := 0\n   717\t\tvar close_enemies := 0\n   718\t\n   719\t\tfor slime in slimes:\n   720\t\t\tif not is_instance_valid(slime) or bool(slime.get_meta(\"dying\", false)):\n   721\t\t\t\tcontinue\n   722\t\t\tvar distance := position.distance_to(slime.global_position)\n   723\t\t\tnearest_enemy_distance = minf(nearest_enemy_distance, distance)\n   724\t\t\tif distance <= CODEX_AI_TOO_CLOSE_RADIUS:\n   725\t\t\t\tclose_enemies += 1\n   726\t\t\tif distance <= CODEX_AI_DANGER_RADIUS and _has_clear_world_line(position, slime.global_position):\n   727\t\t\t\tdangerous_lines += 1\n   728\t\n   729\t\tvar current_distance := player.global_position.distance_to(position)\n   730\t\tvar exit_distance := position.distance_to(exit_position)\n"}}
