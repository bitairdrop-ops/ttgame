\", 4, [0, 1, 2, 3, 4, 5], PLAYER_ANIMATION_FPS)\n  3135\t\t_add_character_animation(frames, sheet, \"attack_down\", 0, [8, 9, 10, 11], PLAYER_ATTACK_FPS, false)\n  3136\t\t_add_character_animation(frames, sheet, \"attack_right\", 2, [8, 9, 10, 11], PLAYER_ATTACK_FPS, false)\n  3137\t\t_add_character_animation(frames, sheet, \"attack_up\", 4, [8, 9, 10, 11], PLAYER_ATTACK_FPS, false)\n  3138\t\t_add_character_animation(frames, sheet, \"attack_left\", 6, [8, 9, 10, 11], PLAYER_ATTACK_FPS, false)\n  3139\t\t_add_character_animation(frames, sheet, \"hurt_down\", 0, [19, 19, 19], PLAYER_ATTACK_FPS, false)\n  3140\t\t_add_character_animation(frames, sheet, \"hurt_right\", 2, [19, 19, 19], PLAYER_ATTACK_FPS, false)\n  3141\t\t_add_character_animation(frames, sheet, \"hurt_up\", 4, [19, 19, 19], PLAYER_ATTACK_FPS, false)\n  3142\t\t_add_character_animation(frames, sheet, \"hurt_left\", 6, [19, 19, 19], PLAYER_ATTACK_FPS, false)\n  3143\t\n  3144\t\treturn frames\n  3145\t\n  3146\t\n  3147\tfunc _add_player_animation(frames: SpriteFrames, name: String, row: int, columns: Array[int], speed: float, loops := true) -> void:\n  3148\t\t_add_character_animation(frames, player_sheet, name, row, columns, speed, loops)\n  3149\t\n  3150\t\n  3151\tfunc _add_character_animation(frames: SpriteFrames, sheet: Texture2D, name: String, row: int, columns: Array[int], speed: float, loops := true) -> void:\n  3152\t\tframes.add_animation(name)\n  3153\t\tframes.set_animation_loop(name, loops)\n  3154\t\tframes.set_animation_speed(name, speed)\n  3155\t\tfor column in columns:\n  3156\t\t\tframes.add_frame(name, _character_frame_texture(sheet, column, row))\n  3157\t\n  3158\t\n  3159\tfunc _player_frame_texture(column: int, row: int) -> Texture2D:\n  3160\t\treturn _character_frame_texture(player_sheet, column, row)\n  3161\t\n  3162\t\n  3163\tfunc _character_frame_texture(sheet: Texture2D, column: int, row: int) -> Texture2D:\n  3164\t\tvar frame := AtlasTexture.new()\n  3165\t\tframe.atlas = sheet\n  3166\t\tframe.region = Rect2(\n  3167\t\t\tcolumn * PLAYER_FRAME_SIZE,\n  3168\t\t\trow * PLAYER_FRAME_SIZE,\n  3169\t\t\tPLAYER_FRAME_SIZE,\n  3170\t\t\tPLAYER_FRAME_SIZE\n  3171\t\t)\n  3172\t\treturn frame\n  3173\t\n  3174\t\n  3175\tfunc _update_player_animation(input_vector: Vector2) -> void:\n  3176\t\tif player_attacking or player_hurt or player_dead:\n  3177\t\t\treturn\n  3178\t\n  3179\t\tif input_vector.length_squared() > 0.0:\n  3180\t\t\tif absf(input_vector.x) > absf(input_vector.y):\n  3181\t\t\t\tplayer_facing = \"right\" if input_vector.x > 0.0 else \"left\"\n  3182\t\t\telse:\n  3183\t\t\t\tplayer_facing = \"down\" if input_vector.y > 0.0 else \"up\"\n  3184\t\t\t_play_player_animation(\"walk_%s\" % player_facing)\n  3185\t\telse:\n  3186\t\t\t_play_player_animation(\"idle_%s\" % player_facing)\n  3187\t\n  3188\t\n"}}
