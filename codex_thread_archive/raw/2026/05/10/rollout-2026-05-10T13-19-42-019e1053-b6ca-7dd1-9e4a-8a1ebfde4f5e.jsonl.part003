preview.add_child(enemy)\n  1872\t\t\t_start_menu_enemy_wander(enemy, preview.size)\n  1873\t\n  1874\t\n  1875\tfunc _create_menu_enemy_sprite(chapter: int) -> AnimatedSprite2D:\n  1876\t\tvar texture := _load_png_texture(_menu_enemy_path_for_chapter(chapter))\n  1877\t\tif not texture:\n  1878\t\t\treturn null\n  1879\t\tvar frames := _menu_enemy_frames_for_chapter(chapter, texture)\n  1880\t\tif not frames:\n  1881\t\t\treturn null\n  1882\t\tvar enemy := AnimatedSprite2D.new()\n  1883\t\tenemy.sprite_frames = frames\n  1884\t\tenemy.animation = _menu_enemy_animation(frames)\n  1885\t\tenemy.play()\n  1886\t\treturn enemy\n  1887\t\n  1888\t\n  1889\tfunc _menu_enemy_frames_for_chapter(chapter: int, texture: Texture2D) -> SpriteFrames:\n  1890\t\tvar frames: SpriteFrames\n  1891\t\tmatch chapter:\n  1892\t\t\tCHAPTER_FOREST:\n  1893\t\t\t\tframes = _build_forest_enemy_sprite_frames(texture)\n  1894\t\t\tCHAPTER_OCEAN:\n  1895\t\t\t\tframes = _build_ocean_enemy_sprite_frames(texture)\n  1896\t\t\tCHAPTER_VOLCANO:\n  1897\t\t\t\tframes = _build_volcano_enemy_sprite_frames(texture)\n  1898\t\t\t_:\n  1899\t\t\t\tframes = _build_slime_sprite_frames(texture)\n  1900\t\treturn frames\n  1901\t\n  1902\t\n  1903\tfunc _menu_enemy_animation(frames: SpriteFrames) -> String:\n  1904\t\tif frames.has_animation(\"move_down\"):\n  1905\t\t\treturn \"move_down\"\n  1906\t\tif frames.has_animation(\"move\"):\n  1907\t\t\treturn \"move\"\n  1908\t\tif frames.has_animation(\"idle_down\"):\n  1909\t\t\treturn \"idle_down\"\n  1910\t\treturn \"idle\"\n  1911\t\n  1912\t\n  1913\tfunc _start_menu_enemy_wander(enemy: AnimatedSprite2D, bounds: Vector2) -> void:\n  1914\t\tif not is_instance_valid(enemy) or enemy.get_parent() == null:\n  1915\t\t\treturn\n  1916\t\tvar target := _random_menu_enemy_position(bounds)\n  1917\t\tvar direction := target - enemy.position\n  1918\t\t_play_menu_enemy_walk(enemy, direction)\n  1919\t\tvar tween := create_tween()\n  1920\t\ttween.tween_property(enemy, \"position\", target, rng.randf_range(1.4, 2.5)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)\n  1921\t\ttween.tween_callback(_start_menu_enemy_wander.bind(enemy, bounds))\n  1922\t\n  1923\t\n  1924\tfunc _random_menu_enemy_position(bounds: Vector2) -> Vector2:\n  1925\t\treturn Vector2(\n  1926\t\t\trng.randf_range(42.0, bounds.x - 42.0),\n  1927\t\t\trng.randf_range(38.0, bounds.y - 18.0)\n  1928\t\t)\n  1929\t\n  1930\t\n  1931\tfunc _play_menu_enemy_walk(enemy: AnimatedSprite2D, direction: Vector2) -> void:\n  1932\t\tvar frames := enemy.sprite_frames\n  1933\t\tif frames.has_animation(\"move_down\"):\n  1934\t\t\tvar facing := \"down\"\n  1935\t\t\tif absf(direction.x) > absf(direction.y):\n  1936\t\t\t\tfacing = \"right\" if direction.x > 0.0 else \"left\"\n  1937\t\t\telse:\n  1938\t\t\t\tfacing = \"down\" if direction.y > 0.0 else \"up\"\n  1939\t\t\tvar animation := \"move_%s\" % facing\n  1940\t\t\tenemy.play(animation if frames.has_animation(animation) else \"move_down\")\n  1941\t\t\treturn\n  1942\t\tif frames.has_animation(\"move\"):\n  1943\t\t\tenemy.flip_h = direction.x < 0.0\n  1944\t\t\tenemy.play(\"move\")\n  1945\t\t\treturn\n  1946\t\tif frames.has_animation(\"idle_down\"):\n  1947\t\t\tenemy.play(\"idle_down\")\n  1948\t\n  1949\t\n  1950\tfunc _menu_map_path_for_chapter(chapter: int) -> String:\n  1951\t\tmatch chapter:\n  1952\t\t\tCHAPTER_FOREST:\n  1953\t\t\t\treturn FOREST_MAP_PATTERN % 1\n  1954\t\t\tCHAPTER_OCEAN:\n  1955\t\t\t\treturn OCEAN_MAP_PATTERN % 1\n  1956\t\t\tCHAPTER_VOLCANO:\n  1957\t\t\t\treturn VOLCANO_MAP_PATTERN % 1\n  1958\t\t\t_:\n  1959\t\t\t\treturn COMPLETE_MAP_PATTERN % 1\n  1960\t\n  1961\t\n  1962\tfunc _menu_map_texture_for_chapter(chapter: int) -> Texture2D:\n  1963\t\tvar texture := _load_png_texture(_menu_map_path_for_chapter(chapter))\n  1964\t\tif not texture:\n  1965\t\t\treturn null\n  1966\t\tvar crop_top := 118.0\n  1967\t\tvar cropped := AtlasTexture.new()\n  1968\t\tcropped.atlas = texture\n  1969\t\tcropped.region = Rect2(0.0, crop_top, texture.get_width(), texture.get_height() - crop_top)\n  1970\t\treturn cropped\n  1971\t\n  1972\t\n  1973\tfunc _menu_enemy_path_for_chapter(chapter: int) -> String:\n  1974\t\tmatch chapter:\n  1975\t\t\tCHAPTER_FOREST:\n  1976\t\t\t\treturn FOREST_ENEMY_LEVEL_SHEET_PATTERN % 1\n  1977\t\t\tCHAPTER_OCEAN:\n  1978\t\t\t\treturn OCEAN_ENEMY_LEVEL_SHEET_PATTERN % 1\n  1979\t\t\tCHAPTER_VOLCANO:\n  1980\t\t\t\treturn VOLCANO_ENEMY_LEVEL_SHEET_PATTERN % 1\n  1981\t\t\t_:\n  1982\t\t\t\treturn SLIME_LEVEL_SHEET_PATTERN % 1\n  1983\t\n  1984\t\n  1985\tfunc _chapter_menu_title(chapter: int) -> String:\n  1986\t\tmatch chapter:\n  1987\t\t\tCHAPTER_FOREST:\n  1988\t\t\t\treturn \"Chapter 2 - Forest\"\n  1989\t\t\tCHAPTER_OCEAN:\n  1990\t\t\t\treturn \"Chapter 3 - Tide Gate Reef\"\n  1991\t\t\tCHAPTER_VOLCANO:\n  1992\t\t\t\treturn \"Chapter 4 - Ash Gate\"\n  1993\t\t\t_:\n  1994\t\t\t\treturn \"Chapter 1 - Slime\"\n  1995\t\n  1996\t\n  1997\tfunc _chapter_accent_color(chapter: int) -> Color:\n  1998\t\tmatch chapter:\n  1999\t\t\tCHAPTER_FOREST:\n  2000\t\t\t\treturn Color(0.34, 0.85, 0.42, 1.0)\n  2001\t\t\tCHAPTER_OCEAN:\n  2002\t\t\t\treturn Color(0.36, 0.78, 1.0, 1.0)\n  2003\t\t\tCHAPTER_VOLCANO:\n  2004\t\t\t\treturn Color(1.0, 0.46, 0.2, 1.0)\n  2005\t\t\t_:\n  2006\t\t\t\treturn Color(0.72, 0.88, 0.68, 1.0)\n  2007\t\n  2008\t\n  2009\tfunc _chapter_map_tint(chapter: int) -> Color:\n  2010\t\tmatch chapter:\n  2011\t\t\tCHAPTER_FOREST:\n  2012\t\t\t\treturn Color(0.82, 1.0, 0.78, 1.0)\n  2013\t\t\tCHAPTER_OCEAN:\n  2014\t\t\t\treturn Color(0.78, 0.95, 1.0, 1.0)\n  2015\t\t\tCHAPTER_VOLCANO:\n  2016\t\t\t\treturn Color(1.0, 0.72, 0.48, 1.0)\n  2017\t\t\t_:\n  2018\t\t\t\treturn Color(0.9, 0.92, 0.86, 1.0)\n  2019\t\n  2020\t\n  2021\tfunc _start_chapter(chapter: int) -> void:\n  2022\t\tget_tree().set_meta(\"ai_challenge\", false)\n  2023\t\tget_tree().set_meta(\"chapter\", clampi(chapter, 1, CHAPTER_COUNT)