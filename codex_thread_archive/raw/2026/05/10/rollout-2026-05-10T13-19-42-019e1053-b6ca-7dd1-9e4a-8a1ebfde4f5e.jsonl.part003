) -> float:\n3319:\t\t\"archer\":\n3321:\t\t\"mage\":\n3327:func _companion_follow_offset(slot: int) -> Vector2:\n3365:func _companion_path_direction(ally: CharacterBody2D, goal_position: Vector2, fallback_direction: Vector2) -> Vector2:\n3367:\t\treturn _companion_safe_direction(ally, fallback_direction)\n3369:\tvar start := _nearest_walkable_cell(_world_cell_for_position(ally.global_position))\n3372:\t\treturn _companion_safe_direction(ally, fallback_direction)\n3374:\t\treturn _companion_safe_direction(ally, fallback_direction)\n3378:\t\treturn _companion_safe_direction(ally, fallback_direction)\n3380:\tvar direction := _cell_center(next_cell) - ally.global_position\n3381:\tif direction.length_squared() <= 4.0:\n3382:\t\treturn _companion_safe_direction(ally, fallback_direction)\n3383:\treturn _companion_safe_direction(ally, direction.normalized())\n3386:func _companion_safe_direction(ally: CharacterBody2D, direction: Vector2) -> Vector2:\n3387:\tif direction.length_squared() <= 0.0:\n3391:\tif not _companion_direction_blocked(ally, base):\n3402:\t\tif candidate.length_squared() > 0.0 and not _companion_direction_blocked(ally, candidate):\n3407:func _move_companion(ally: CharacterBody2D, direction: Vector2, delta: float) -> void:\n3408:\tvar move_dir := _companion_unstuck_direction(ally, direction)\n3409:\tvar before := ally.global_position\n3410:\tally.velocity = move_dir * COMPANION_SPEED\n3411:\tally.move_and_slide()\n3413:\tvar moved := before.distance_to(ally.global_position)\n3414:\tif move_dir.length_squared() > 0.0 and moved < COMPANION_STUCK_MOVE_EPSILON:\n3415:\t\tally.set_meta(\"stuck_time\", float(ally.get_meta(\"stuck_time\", 0.0)) + delta)\n3417:\t\tally.set_meta(\"stuck_time\", 0.0)\n3418:\t_update_companion_animation(ally, move_dir)\n3421:func _companion_unstuck_direction(ally: CharacterBody2D, direction: Vector2) -> Vector2:\n3422:\tvar safe := _companion_safe_direction(ally, direction)\n3423:\tif safe.length_squared() <= 0.0:\n3424:\t\tally.set_meta(\"stuck_time\", COMPANION_STUCK_TIME)\n3425:\tif float(ally.get_meta(\"stuck_time\", 0.0)) < COMPANION_STUCK_TIME:\n3427:\tif direction.length_squared() <= 0.0:\n3438:\tvar start_index := int(ally.get_meta(\"unstuck_turn\", 0)) % candidates.size()\n3439:\tally.set_meta(\"unstuck_turn\", start_index + 1)\n3442:\t\tif candidate.length_squared() > 0.0 and not _companion_direction_blocked(ally, candidate):\n3447:func _companion_direction_blocked(ally: CharacterBody2D, direction: Vector2) -> bool:\n3448:\tif direction.length_squared() <= 0.0:\n3450:\treturn ally.test_move(ally.global_transform, direction.normalized() * TILE_SIZE * 0.45)\n3517:func _update_companion_facing(ally: CharacterBody2D, direction: Vector2) -> void:\n3518:\tif direction.length_squared() <= 0.0:\n3525:\tally.set_meta(\"facing\", facing)\n3528:func _update_companion_animation(ally: CharacterBody2D, move_dir: Vector2) -> void:\n3529:\tif bool(ally.get_meta(\"attacking\", false)):\n3531:\tvar facing := String(ally.get_meta(\"facing\", \"down\"))\n3532:\tif move_dir.length_squared() > 0.0:\n3533:\t\t_play_companion_animation(ally, \"walk_%s\" % facing)\n3535:\t\t_play_companion_animation(ally, \"idle_%s\" % facing)\n3538:func _play_companion_animation(ally: CharacterBody2D, name: String) -> void:\n3539:\tvar anim := ally.get_node_or_null(\"CompanionAnimation\") as AnimatedSprite2D\n3547:func _start_companion_attack(ally: CharacterBody2D, target: CharacterBody2D) -> void:\n3548:\tally.set_meta(\"attacking\", true)\n3549:\tally.set_meta(\"attack_cooldown\", COMPANION_ATTACK_COOLDOWN)\n3550:\tally.velocity = Vector2.ZERO\n3551:\tvar facing := String(ally.get_meta(\"facing\", \"down\"))\n3552:\t_play_companion_animation(ally, \"attack_%s\" % facing)\n3553:\tmatch String(ally.get_meta(\"role\", \"melee\")):\n3554:\t\t\"archer\":\n3556:\t\t\tshot_timer.timeout.connect(_spawn_arrow.bind(ally, target))\n3557:\t\t\"mage\":\n3559:\t\t\tstaff_timer.timeout.connect(_cast_mage_staff.bind(ally, target))\n3560:\t\t\"warrior\":\n3561:\t\t\t_damage_slime(target, WARRIOR_ATTACK_DAMAGE)\n3563:\t\t\t_damage_slime(target, 1)\n3566:func _cast_mage_staff(ally: CharacterBody2D, target: CharacterBody2D) -> void:\n3567:\tif not is_instance_valid(ally) or not is_instance_valid(target):\n3571:\t_show_mage_freeze_bolt(ally.global_position, target.global_position)\n3573:\t_damage_slime(target, MAGE_ATTACK_DAMAGE)\n3576:func _spawn_arrow(ally: CharacterBody2D, target: CharacterBody2D) -> void:\n3579:\tvar direction := target.global_position - ally.global_position\n3580:\tif direction.length_squared() <= 0.0:\n3586:\tarrow.global_position = ally.global_position + direction * 14.0\n3612:\tif direction.length_squared() <= 0.0:\n3624:\tfireball.set_meta(\"damage\", int(slime.get_meta(\"damage\", 1)))\n3653:\tif direction.length_squared() <= 0.0:\n3665:\tbubble.set_meta(\"damage\", int(slime.get_meta(\"damage\", 1)))\n3729:\t\t\t\t_damage_player(int(arrow.get_meta(\"damage\", 1)), arrow.get_meta(\"source_enemy\", null))\n3736:\t\t\t_damage_slime(hit_slime, ARROW_DAMAGE)\n3824:func _on_companion_animation_finished(ally: CharacterBody2D) -> void:\n3825:\tif not is_instance_valid(ally):\n3827:\tvar anim := ally.get_node_or_null(\"CompanionAnimation\") as AnimatedSprite2D\n3830:\tally.set_meta(\"attacking\", false)\n3831:\tvar facing := String(ally.get_meta(\"facing\", \"down\"))\n3832:\t_play_companion_animation(ally, \"idle_%s\" % facing)\n3895:\t\t_damage_slime(nearest_slime, PLAYER_ATTACK_POWER)\n3903:\t\t_damage_slime(nearest_slime, ASSIST_NORMAL_DAMAGE)\n3920:\t_show_mage_freeze_bolt(player.global_position, target.global_position)\n3922:\t_damage_slime(target, PLAYER_MAGIC_DAMAGE)\n3938:\t_damage_slime(target, ASSIST_MOON_SLASH_DAMAGE)\n3986:func _damage_slime(slime: CharacterBody2D, amount: int) -> void:\n3994:\t_show_damage_popup(slime.global_position, amount)\n4014:\t\tcollision.set_deferred(\"disabled\", true)\n4054:func _show_mage_freeze_bolt(from_position: Vector2, to_position: Vector2