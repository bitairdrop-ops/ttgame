\t\t\tif bool(slime.get_meta(\"dying\", false)):\n  2481\t\t\t\tcontinue\n  2482\t\n  2483\t\t\tif _update_slime_freeze(slime, delta):\n  2484\t\t\t\tcontinue\n  2485\t\t\tif bool(slime.get_meta(\"attacking\", false)):\n  2486\t\t\t\tslime.velocity = Vector2.ZERO\n  2487\t\t\t\tcontinue\n  2488\t\n  2489\t\t\tvar state := String(slime.get_meta(\"state\"))\n  2490\t\t\tvar move_dir := slime.get_meta(\"move_dir\") as Vector2\n  2491\t\t\tvar home_x := float(slime.get_meta(\"home_x\"))\n  2492\t\t\tif bool(slime.get_meta(\"aggressive\", false)):\n  2493\t\t\t\tmove_dir = _aggressive_slime_chase_direction(slime)\n  2494\t\t\t\tstate = \"move\" if move_dir.length_squared() > 0.0 else \"idle\"\n  2495\t\t\t\tslime.set_meta(\"move_dir\", move_dir)\n  2496\t\t\t\tslime.set_meta(\"state\", state)\n  2497\t\t\telse:\n  2498\t\t\t\tvar state_time := float(slime.get_meta(\"state_time\")) - delta\n  2499\t\t\t\tif state_time <= 0.0:\n  2500\t\t\t\t\t_pick_next_slime_state(slime)\n  2501\t\t\t\telse:\n  2502\t\t\t\t\tslime.set_meta(\"state_time\", state_time)\n  2503\t\t\t\tstate = String(slime.get_meta(\"state\"))\n  2504\t\t\t\tmove_dir = slime.get_meta(\"move_dir\") as Vector2\n  2505\t\n  2506\t\t\tslime.velocity = _slime_velocity_with_player_spacing(slime, move_dir, state)\n  2507\t\t\tslime.move_and_slide()\n  2508\t\n  2509\t\t\tvar anim := slime.get_node_or_null(\"SlimeAnimation\") as AnimatedSprite2D\n  2510\t\t\tif anim:\n  2511\t\t\t\tanim.flip_h = false if _uses_directional_enemy_animation() else move_dir.x < 0.0\n  2512\t\t\t\tanim.play(_enemy_animation_name(slime, state, move_dir))\n  2513\t\n  2514\t\t\tif not bool(slime.get_meta(\"aggressive\", false)) and (slime.is_on_wall() or absf(slime.position.x - home_x) > SLIME_PATROL_DISTANCE):\n  2515\t\t\t\tmove_dir *= -1.0\n  2516\t\t\t\tslime.set_meta(\"move_dir\", move_dir)\n  2517\t\n  2518\t\t\t_update_slime_contact_attack(slime, delta)\n  2519\t\n  2520\t\n  2521\tfunc _update_slime_freeze(slime: CharacterBody2D, delta: float) -> bool:\n  2522\t\tvar freeze_time := float(slime.get_meta(\"freeze_time\", 0.0))\n  2523\t\tif freeze_time <= 0.0:\n  2524\t\t\treturn false\n  2525\t\n  2526\t\tfreeze_time = maxf(0.0, freeze_time - delta)\n  2527\t\tslime.set_meta(\"freeze_time\", freeze_time)\n  2528\t\tslime.set_meta(\"attacking\", false)\n  2529\t\tslime.velocity = Vector2.ZERO\n  2530\t\tvar anim := slime.get_node_or_null(\"SlimeAnimation\") as AnimatedSprite2D\n  2531\t\tif freeze_time > 0.0:\n  2532\t\t\tslime.modulate = Color(0.58, 0.9, 1.0)\n  2533\t\t\tif anim and anim.is_playing():\n  2534\t\t\t\tanim.pause()\n  2535\t\t\treturn true\n  2536\t\n  2537\t\tslime.modulate = Color.WHITE\n  2538\t\tif anim and not anim.is_playing():\n  2539\t\t\tanim.play(_enemy_animation_name(slime, String(slime.get_meta(\"state\", \"idle\")), slime.get_meta(\"move_dir\") as Vector2))\n  2540\t\treturn false\n  2541\t\n  2542\t\n  2543\tfunc _pick_next_slime_state(slime: CharacterBody2D) -> void:\n  2544\t\tif rng.randf() < 0.45:\n  2545\t\t\tslime.set_meta(\"state\", \"idle\")\n  2546\t\t\tslime.set_meta(\"state_time\", rng.randf_range(SLIME_MIN_STATE_TIME, SLIME_MAX_STATE_TIME))\n  2547\t\t\tslime.set_meta(\"move_dir\", Vector2.ZERO)\n  2548\t\t\treturn\n  2549\t\n  2550\t\tvar directions := [\n  2551\t\t\tVector2.LEFT,\n  2552\t\t\tVector2.RIGHT,\n  2553\t\t\tVector2.UP,\n  2554\t\t\tVector2.DOWN,\n  2555\t\t]\n  2556\t\tslime.set_meta(\"state\", \"move\")\n  2557\t\tslime.set_meta(\"state_time\", rng.randf_range(SLIME_MIN_STATE_TIME, SLIME_MAX_STATE_TIME))\n  2558\t\tslime.set_meta(\"move_dir\", directions[rng.randi_range(0, directions.size() - 1)])\n  2559\t\n  2560\t\n  2561\tfunc _aggressive_slime_chase_direction(slime: CharacterBody2D) -> Vector2:\n  2562\t\tvar to_player := player.global_position - slime.global_position\n  2563\t\tvar distance := to_player.length()\n  2564\t\tif distance > AGGRESSIVE_SLIME_CHASE_RANGE or distance <= SLIME_STOP_DISTANCE:\n  2565\t\t\treturn Vector2.ZERO\n  2566\t\treturn to_player.normalized()\n  2567\t\n  2568\t\n  2569\tfunc _slime_velocity_with_player_spacing(slime: CharacterBody2D, move_dir: Vector2, state: String) -> Vector2:\n  2570\t\tvar from_player := slime.global_position - player.global_position\n  2571\t\tvar distance := from_player.length()\n  2572\t\tif distance > 0.0 and distance < SLIME_SEPARATION_DISTANCE:\n  2573\t\t\tvar separation_speed := _enemy_move_speed() if _uses_directional_enemy_animation() else SLIME_SEPARATION_SPEED\n  2574\t\t\treturn from_player.normalized() * separation_speed\n  2575\t\tif bool(slime.get_meta(\"aggressive\", false)) and distance <= SLIME_STOP_DISTANCE:\n  2576\t\t\treturn Vector2.ZERO\n  2577\t\treturn move_dir * _enemy_move_speed() if state == \"move\" else Vector2.ZERO\n  2578\t\n  2579\t\n  2580\tfunc _enemy_move_speed() -> float:\n  2581\t\tif current_chapter == CHAPTER_FOREST:\n  2582\t\t\treturn PLAYER_SPEED\n  2583\t\tif current_chapter == CHAPTER_OCEAN:\n  2584\t\t\treturn PLAYER_SPEED * 0.92\n  2585\t\tif current_chapter == CHAPTER_VOLCANO:\n  2586\t\t\treturn PLAYER_SPEED * 0.82\n  2587\t\treturn SLIME_SPEED\n  2588\t\n  2589\t\n  2590\tfunc _update_slime_contact_attack(slime: CharacterBody2D, delta: float) -> void:\n  2591\t\tvar cooldown := maxf(0.0, float(slime.get_meta(\"attack_cooldown\")) - delta)\n  2592\t\tslime.set_meta(\"attack_cooldown\", cooldown)\n  2593\t\tif cooldown > 0.0:\n  2594\t\t\treturn\n  2595\t\n  2596\t\tvar attack_range := _enemy_attack_range()\n  2597\t\tif slime.global_position.distance_to(player.global_position) > attack_range:\n  2598\t\t\treturn\n  2599\t\n  2600\t\tif _uses_directional_enemy_animation():\n  2601\t\t\t_start_animated_enemy_attack(slime)\n  2602\t\t\treturn\n  2603\t\n  2604\t\t_damage_player(int(slime.get_meta(\"damage\", 1)), slime)\n  2605\t\tslime.set_meta(\"attack_cooldown\", SLIME_ATTACK_COOLDOWN)\n  2606\t\n  2607\t\n  2608\tfunc _enemy_attack_range() -> float:\n  2609\t\tif current_chapter == CHAPTER_VOLCANO:\n  2610\t\t\treturn VOLCANO_ENEMY_ATTACK_RANGE\n  2611\t\tif current_chapter == CHAPTER_OCEAN:\n  2612\t\t\treturn OCEAN_ENEMY_ATTACK_RANGE\n  2613\t\tif current_chapter == CHAPTER_FOREST:\n  2614\t\t\treturn FOREST_ENEMY_ATTACK_RANGE\n  2615\t\treturn SLIME_CONTACT_ATTACK_RANGE\n  2616\t\n  2617\t\n  2618\tfunc _enemy_attack_release_delay() -> float:\n  2619\t\tif current_chapter == CHAPTER_VOLCANO:\n  2620\t\t\treturn VOLCANO_ENEMY_ATTACK_RELEASE_DELAY\n  2621\t\treturn OCEAN_ENEMY_ATTACK_RELEASE_DELAY if current_chapter == CHAPTER_OCEAN else FOREST_ENEMY_ATTACK_RELEASE_DELAY\n  2622\t\n  2623\t\n  2624\tfunc _uses_directional_enemy_animation() -> bool:\n  2625\t\treturn current_chapter == CHAPTER_FOREST or current_chapter == CHAPTER_OCEAN or current_chapter == CHAPTER_VOLCANO\n"}}
