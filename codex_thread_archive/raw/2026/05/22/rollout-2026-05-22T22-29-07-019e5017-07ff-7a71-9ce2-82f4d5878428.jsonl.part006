{"timestamp":"2026-05-24T01:19:20.766Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_pYqOHfmx2NEcWVW6No1zjacf","output":"Chunk ID: 5d9655\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 986\nOutput:\n        ${icon(\"gamepad\")}\n        <span>GameG</span>\n      </button>\n      <nav class=\"nav\">\n        <button class=\"${active === \"Discover\" ? \"active\" : \"\"}\" onclick=\"setView('detail')\">Discover</button>\n        <button class=\"${active === \"My Games\" ? \"active\" : \"\"}\" onclick=\"setView('library')\">My Games</button>\n      </nav>\n      <label class=\"search\">\n        ${icon(\"search\")}\n        <input placeholder=\"Search games...\" />\n      </label>\n      ${\n        state.walletAddress\n          ? `<button class=\"ghost wallet-pill\" onclick=\"disconnectWallet()\" title=\"Disconnect wallet\">${icon(\"wallet\")}<span>${shortAddress(state.walletAddress)}</span></button>`\n          : `<button class=\"ghost wallet-pill\" onclick=\"setView('wallet')\">${icon(\"wallet\")}<span>Connect Wallet</span></button>`\n      }\n    </header>\n  `;\n}\n\nfunction art(className = \"\") {\n  return `<div class=\"game-art ${className}\"><img src=\"${demoImageUrl}\" alt=\"Quiet Dungeon Treasure game scene\" /></div>`;\n}\n\nfunction flow(active = \"demo\") {\n  const steps = [\n    [\"demo\", \"Demo\", icon(\"play\")],\n    [\"pay\", \"Pay\", icon(\"card\")],\n    [\"download\", \"Download\", icon(\"download\")],\n  ];\n\n  return `<div class=\"flow\">${steps\n    .map(([id, label, svg]) => `<span class=\"${id === active ? \"step active\" : \"step\"}\">${svg}${label}</span>`)\n    .join(\"<i></i>\")}</div>`;\n}\n\nfunction gameCard(game) {\n  const owned = state.walletAddress && (game.owned || (game.id === \"clockwork\" && state.purchasedClockwork));\n  return `\n    <article class=\"game-card ${game.tone}\">\n      <div class=\"cover\">${game.id === \"clockwork\" ? `<img src=\"${demoImageUrl}\" alt=\"\">` : \"\"}</div>\n      <div>\n        <h3>${game.title}</h3>\n        <p>${game.platforms}</p>\n      </div>\n      ${\n        owned\n          ? `<button class=\"mini success\" onclick=\"setView('library')\">${icon(\"download\")} Download</button>`\n          : `<button class=\"mini\" onclick=\"setView('demo')\">${icon(\"play\")} Play Demo</button>`\n      }\n      <span class=\"price\">${owned ? \"Owned\" : game.priceLabel || `$${game.price}`}</span>\n    </article>\n  `;\n}\n\nfunction detailView() {\n  return `\n    ${header(\"Discover\")}\n    <main class=\"shell\">\n      <section class=\"detail-grid\">\n        <div class=\"media-card\">\n          <span class=\"status-chip\">Demo ready</span>\n          ${art(\"hero-art\")}\n        </div>\n\n        <aside class=\"action-panel\">\n          <p class=\"eyeline\">Wallet required for full download</p>\n          <h1>Quiet Dungeon Treasure</h1>\n          <div class=\"price-line\"><span>0.5 USDT</span><small>Solana full build</small></div>\n          <p class=\"copy\">Play the live Web demo first. Download the full game after purchase.</p>\n          <div class=\"button-stack\">\n            <button class=\"primary play\" onclick=\"setView('demo')\">${icon(\"play\")} Play Demo</button>\n            ${\n              state.purchasedClockwork\n                ? `<button class=\"primary download\" onclick=\"setView('success')\">${icon(\"download\")} Download</button>`\n                : `<button class=\"secondary buy\" onclick=\"buy()\">${icon(\"card\")} Buy Full Game · 0.5 USDT</button>`\n            }\n          </div>\n          <p class=\"micro\">Demo is open. Full download requires Solana USDT wallet payment.</p>\n          ${flow(\"demo\")}\n        </aside>\n      </section>\n\n      <section class=\"related\">\n        ${gameCard(games[1])}\n        ${gameCard(games[3])}\n        ${\n          state.walletAddress\n            ? `<article class=\"owned-strip\">\n                <span>Paper City</span>\n                <strong>Owned</strong>\n                <button onclick=\"setView('library')\">${icon(\"download\")} Download</button>\n              </article>`\n            : `<article class=\"owned-strip locked\">\n                <span>My Games</span>\n                <strong>Wallet locked</strong>\n                <button onclick=\"setView('wallet')\">${icon(\"wallet\")} Connect</button>\n              </article>`\n        }\n      </section>\n    </main>\n"}}
