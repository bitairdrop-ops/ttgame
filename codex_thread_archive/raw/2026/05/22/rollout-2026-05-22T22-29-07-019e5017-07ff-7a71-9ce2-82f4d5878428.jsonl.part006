{"timestamp":"2026-05-23T11:21:35.662Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_nRI3zTnNm90jgIZ1qGBL3rTO","output":"Chunk ID: 1a9395\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 391\nOutput:\n    chain: config.chain,\n    recipient: config.recipient,\n    usdtMint: config.usdtMint,\n    reference: order.reference,\n    memo: order.memo,\n    status: order.status,\n    signature: order.signature || \"\",\n    explorerUrl: order.signature ? `https://solscan.io/tx/${order.signature}` : \"\",\n    solanaPayUrl: order.solanaPayUrl,\n    expiresAt: order.expiresAt,\n    error: order.error || \"\",\n  };\n}\n\nfunction createOrder(walletAddress, gameId) {\n  const id = `qdt_${Date.now()}_${shortId()}`;\n  const reference = base58(randomBytes(32));\n  const memo = `AIGAME:${id}`;\n  const params = new URLSearchParams({\n    amount: config.amountUsdt,\n    \"spl-token\": config.usdtMint,\n    reference,\n    label: \"GameG\",\n    message: `Unlock ${config.gameTitle}`,\n    memo,\n  });\n  const order = {\n    id,\n    gameId,\n    walletAddress,\n    reference,\n    memo,\n    status: \"waiting_payment\",\n    createdAt: new Date().toISOString(),\n    expiresAt: new Date(Date.now() + 20 * 60 * 1000).toISOString(),\n    solanaPayUrl: `solana:${config.recipient}?${params.toString()}`,\n  };\n  orders.set(id, order);\n  return order;\n}\n\nasync function rpc(method, params) {\n  const response = await fetch(rpcUrl, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body: JSON.stringify({ jsonrpc: \"2.0\", id: \"aigame-dock\", method, params }),\n  });\n  if (!response.ok) throw new Error(`Solana RPC ${response.status}`);\n  const payload = await response.json();\n  if (payload.error) throw new Error(payload.error.message || \"Solana RPC error\");\n  return payload.result;\n"}}
{"timestamp":"2026-05-23T11:21:35.662Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_EK76gwjp0qzWOyfBezFgL8UI","output":"Chunk ID: 3a7414\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 690\nOutput:\n  return payload.result;\n}\n\nfunction tokenDeltaForOwner(tx, owner) {\n  const pre = new Map();\n  const post = new Map();\n  for (const balance of tx.meta?.preTokenBalances || []) {\n    if (balance.mint === config.usdtMint && balance.owner === owner) {\n      pre.set(balance.accountIndex, BigInt(balance.uiTokenAmount.amount || \"0\"));\n    }\n  }\n  for (const balance of tx.meta?.postTokenBalances || []) {\n    if (balance.mint === config.usdtMint && balance.owner === owner) {\n      post.set(balance.accountIndex, BigInt(balance.uiTokenAmount.amount || \"0\"));\n    }\n  }\n  let delta = 0n;\n  for (const [accountIndex, amount] of post.entries()) {\n    delta += amount - (pre.get(accountIndex) || 0n);\n  }\n  return delta;\n}\n\nfunction hasSigner(tx, walletAddress) {\n  return (tx.transaction?.message?.accountKeys || []).some((account) => {\n    if (typeof account === \"string\") return account === walletAddress;\n    return account.pubkey === walletAddress && account.signer;\n  });\n}\n\nfunction includesMemo(tx, memo) {\n  return JSON.stringify(tx.transaction?.message?.instructions || []).includes(memo);\n}\n\nasync function verifyOnChain(order, submittedSignature = \"\") {\n  if (order.status === \"paid\") return order;\n  const signatures = [];\n  if (submittedSignature) signatures.push({ signature: submittedSignature });\n  const referenceSignatures = await rpc(\"getSignaturesForAddress\", [\n    order.reference,\n    { limit: 10 },\n  ]);\n  signatures.push(...referenceSignatures);\n\n  for (const item of signatures) {\n    const signature = item.signature || item;\n    const tx = await rpc(\"getTransaction\", [\n      signature,\n      { encoding: \"jsonParsed\", commitment: \"confirmed\", maxSupportedTransactionVersion: 0 },\n    ]);\n    if (!tx || tx.meta?.err) continue;\n    if (!hasSigner(tx, order.walletAddress)) continue;\n    if (!includesMemo(tx, order.memo)) continue;\n    const received = tokenDeltaForOwner(tx, config.recipient);\n    if (received >= config.amountBaseUnits) {\n      order.status = \"paid\";\n      order.signature = signature;\n      order.error = \"\";\n      order.paidAt = new Date().toISOString();\n      return order;\n    }\n    order.status = \"amount_mismatch\";\n    order.error = \"USDT amount is lower than required.\";\n    return order;\n  }\n  order.status = \"waiting_payment\";\n  order.error = \"Payment not found yet.\";\n  return order;\n}\n\nasync function serveStatic(req, res) {\n  const requestUrl = new URL(req.url, `http://${req.headers.host}`);\n  const pathname = decodeURIComponent(requestUrl.pathname === \"/\" ? \"/index.html\" : requestUrl.pathname);\n  const filepath = normalize(join(root, pathname));\n  if (!filepath.startsWith(root)) {\n    res.writeHead(403);\n    res.end(\"Forbidden\");\n    return;\n  }\n  try {\n    const data = await readFile(filepath);\n"}}
{"timestamp":"2026-05-23T11:21:35.662Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_PkJWiFxAjhIdju61fyNMhluU","output":"Chunk ID: 34a3d0\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 472\nOutput:\napp.js:60:const memoProgramId = \"MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr\";\napp.js:137:async function createPaymentOrder() {\napp.js:213:      programId: new web3.PublicKey(memoProgramId),\napp.js:214:      keys: [{ pubkey: new web3.PublicKey(order.reference), isSigner: false, isWritable: false }],\napp.js:215:      data: new TextEncoder().encode(order.memo),\napp.js:310:    const order = await createPaymentOrder();\napp.js:367:    await createPaymentOrder();\napp.js:696:                <div><span>Memo</span><code>${state.order.memo}</code></div>\napp.js:701:                <p>Order will be created with a unique memo and reference. The backend validates USDT mint, receiver wallet, amount, wallet signer, and memo before unlocking download.</p>\nserver.mjs:2:import { randomBytes } from \"node:crypto\";\nserver.mjs:70:  return base58(randomBytes(9));\nserver.mjs:83:    reference: order.reference,\nserver.mjs:84:    memo: order.memo,\nserver.mjs:88:    solanaPayUrl: order.solanaPayUrl,\nserver.mjs:94:function createOrder(walletAddress, gameId) {\nserver.mjs:96:  const reference = base58(randomBytes(32));\nserver.mjs:97:  const memo = `AIGAME:${id}`;\nserver.mjs:101:    reference,\nserver.mjs:104:    memo,\nserver.mjs:110:    reference,\nserver.mjs:111:    memo,\nserver.mjs:115:    solanaPayUrl: `solana:${config.recipient}?${params.toString()}`,\nserver.mjs:117:  orders.set(id, order);\nserver.mjs:160:function includesMemo(tx, memo) {\nserver.mjs:161:  return JSON.stringify(tx.transaction?.message?.instructions || []).includes(memo);\nserver.mjs:168:  const referenceSignatures = await rpc(\"getSignaturesForAddress\", [\nserver.mjs:169:    order.reference,\nserver.mjs:172:  signatures.push(...referenceSignatures);\nserver.mjs:182:    if (!includesMemo(tx, order.memo)) continue;\nserver.mjs:310:    json(res, 200, { order: publicOrder(createOrder(payload.walletAddress, payload.gameId)) });\n"}}
