{"timestamp":"2026-05-23T12:43:25.961Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_BestFwe0AvtEqG9ZCld6Wte8","output":"Chunk ID: 150c7b\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1804\nOutput:\n  const alphabet = \"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz\";\n  let value = 0n;\n  for (const byte of bytes) value = value * 256n + BigInt(byte);\n  let encoded = \"\";\n  while (value > 0n) {\n    const mod = value % 58n;\n    encoded = alphabet[Number(mod)] + encoded;\n    value /= 58n;\n  }\n  for (const byte of bytes) {\n    if (byte === 0) encoded = \"1\" + encoded;\n    else break;\n  }\n  return encoded || \"1\";\n}\n\nfunction currentSignerAddress() {\n  return (\n    state.walletAccount?.address ||\n    state.walletAccount?.publicKey?.toString?.() ||\n    state.walletSigner?.publicKey?.toString?.() ||\n    state.walletAddress\n  );\n}\n\nasync function buildUsdtPaymentTransaction(order) {\n  const web3 = await import(solanaWeb3SdkUrl);\n  const splToken = await import(solanaSplTokenSdkUrl);\n  const connection = new web3.Connection(solanaRpcUrl, \"confirmed\");\n  const payerAddress = currentSignerAddress();\n  if (payerAddress !== state.walletAddress) {\n    throw new Error(`Connected wallet is ${shortAddress(payerAddress)} but checkout expects ${shortAddress(state.walletAddress)}. Reconnect the correct MetaMask Solana account.`);\n  }\n  const payer = new web3.PublicKey(payerAddress);\n  const recipient = new web3.PublicKey(order.recipient);\n  const mint = new web3.PublicKey(order.usdtMint);\n  const sourceAta = await splToken.getAssociatedTokenAddress(mint, payer);\n  const recipientAta = await splToken.getAssociatedTokenAddress(mint, recipient);\n  const amount = BigInt(Math.round(Number(order.amount) * 10 ** 6));\n  const tx = new web3.Transaction();\n\n  const createAtaInstruction =\n    splToken.createAssociatedTokenAccountIdempotentInstruction ||\n    splToken.createAssociatedTokenAccountInstruction;\n  tx.add(createAtaInstruction(payer, recipientAta, recipient, mint));\n  tx.add(\n    splToken.createTransferCheckedInstruction(\n      sourceAta,\n      mint,\n      recipientAta,\n      payer,\n      amount,\n      6,\n    ),\n  );\n  tx.add(\n    new web3.TransactionInstruction({\n      programId: new web3.PublicKey(memoProgramId),\n      keys: [],\n      data: new TextEncoder().encode(order.memo),\n    }),\n  );\n\n  const latest = await connection.getLatestBlockhash(\"confirmed\");\n  tx.feePayer = payer;\n  tx.recentBlockhash = latest.blockhash;\n  return { tx, connection };\n}\n\nasync function restorePaymentSigner() {\n  if (state.walletSigner) return true;\n  state.paymentNotice = \"Opening MetaMask Solana to reconnect this wallet.\";\n  render();\n  const metaMaskWallet = await connectMetaMaskSolana();\n  if (metaMaskWallet.address !== state.walletAddress) {\n    throw new Error(`Connected wallet changed to ${shortAddress(metaMaskWallet.address)}. Use the same wallet that started checkout or restart checkout.`);\n  }\n  state.walletProvider = \"MetaMask Solana\";\n  state.walletSigner = metaMaskWallet.wallet;\n  state.walletAccount = metaMaskWallet.account;\n  localStorage.setItem(\"aigameDockWalletProvider\", state.walletProvider);\n  return true;\n}\n\nfunction signedTransactionBytes(result) {\n  const value = Array.isArray(result) ? result[0] : result;\n  const candidate =\n    value?.signedTransaction ||\n    value?.transaction ||\n    value?.signedTransactions?.[0] ||\n    value?.transactions?.[0];\n  if (candidate instanceof Uint8Array) return candidate;\n  if (candidate?.serialize) return candidate.serialize();\n  return null;\n}\n\nasync function sendWithWalletStandardSignOnly(tx, connection) {\n  const feature = state.walletSigner?.features?.[\"solana:signTransaction\"];\n  if (!feature || typeof feature.signTransaction !== \"function\" || !state.walletAccount) {\n    return \"\";\n  }\n  const txBytes = tx.serialize({ requireAllSignatures: false, verifySignatures: false });\n  const result = await feature.signTransaction({\n    account: state.walletAccount,\n    chain: solanaChain,\n    transaction: txBytes,\n  });\n  const signedBytes = signedTransactionBytes(result);\n  if (!signedBytes) return \"\";\n  return connection.sendRawTransaction(signedBytes, {\n    skipPreflight: true,\n    maxRetries: 5,\n  });\n}\n\nasync function sendWithInjectedWallet(tx, connection) {\n  const provider = state.walletSigner;\n  if (!provider) return \"\";\n  if (typeof provider.signTransaction === \"function\") {\n    const signed = await provider.signTransaction(tx);\n    const signature = await connection.sendRawTransaction(signed.serialize(), {\n      skipPreflight: true,\n      preflightCommitment: \"confirmed\",\n      maxRetries: 5,\n    });\n    return signature;\n  }\n  return \"\";\n}\n\nasync function verifyPaymentSignature(signature) {\n  if (!state.order) return;\n  const payload = await api(`/api/orders/${state.order.id}/verify`, {\n    method: \"POST\",\n    body: JSON.stringify({ signature }),\n  });\n  state.order = payload.order;\n  if (payload.order.status === \"paid\") {\n    setPaid(payload.order);\n    return true;\n  }\n  state.paymentError = payload.order.error || \"Payment submitted but not confirmed yet. Try Verify Payment again.\";\n  return false;\n}\n\nasync function payWithWallet() {\n  if (!state.walletAddress) {\n    state.walletError = \"Connect a Solana wallet before payment.\";\n    setView(\"wallet\");\n    return;\n  }\n  if (!state.walletSigner) {\n    state.paymentBusy = true;\n    state.paymentError = \"\";\n    state.paymentNotice = \"Opening MetaMask Solana to reconnect this wallet.\";\n    render();\n    try {\n      await restorePaymentSigner();\n    } catch (error) {\n      state.paymentBusy = false;\n      state.paymentError = error && error.message ? error.message : \"Reconnect MetaMask Solana before payment signing.\";\n      render();\n      return;\n    }\n    state.paymentBusy = false;\n  }\n  if (!state.order) {\n    const order = await createPaymentOrder();\n    if (!order) return;\n  }\n  state.paymentBusy = true;\n  state.paymentError = \"\";\n  state.paymentNotice = \"Preparing payment. MetaMask should open for confirmation.\";\n  render();\n  try {\n    await restorePaymentSigner();\n    const { tx, connection } = await buildUsdtPaymentTransaction(state.order);\n    state.paymentNotice = \"Opening MetaMask. Sign the real 0.5 USDT mainnet payment.\";\n    render();\n    let signature = await sendWithWalletStandardSignOnly(tx, connection);\n    if (!signature) signature = await sendWithInjectedWallet(tx, connection);\n    if (!signature) throw new Error(\"MetaMask Solana did not expose signTransaction. Reconnect MetaMask Solana and try again.\");\n    state.order.signature = signature;\n    state.paymentNotice = `Payment submitted: ${shortAddress(signature)}. Verifying on Solana...`;\n    render();\n    const paid = await verifyPaymentSignature(signature);\n    if (paid) return;\n  } catch (error) {\n    state.paymentError = error && error.message ? error.message : \"Wallet payment failed.\";\n  }\n  state.paymentBusy = false;\n  render();\n}\n\nasync function pay() {\n  await payWithWallet();\n}\n\nasync function verifyPayment() {\n  if (!state.order) return;\n  state.paymentBusy = true;\n  state.paymentError = \"\";\n  state.paymentNotice = \"\";\n  render();\n  try {\n    const payload = await api(`/api/orders/${state.order.id}/verify`, {\n      method: \"POST\",\n      body: JSON.stringify({ signature: state.manualSignature.trim() || state.order.signature || \"\" }),\n    });\n    state.order = payload.order;\n    if (payload.order.status === \"paid\") {\n"}}
{"timestamp":"2026-05-23T12:43:25.961Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_sDI29MlaVXjUeItbPWHuhFFe","output":"Chunk ID: fb0fad\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1044\nOutput:\n          <div><dt>Platforms</dt><dd>Web demo + macOS + Windows</dd></div>\n          <div><dt>Version</dt><dd>0.1.0</dd></div>\n          <div><dt>Price</dt><dd>0.5 USDT</dd></div>\n        </dl>\n      </section>\n\n      <section class=\"checkout-card\">\n        <h1>Pay with Solana USDT</h1>\n        ${flow(\"pay\")}\n        <div class=\"wallet-payment\">\n          <span class=\"wallet-icon\">${icon(\"wallet\")}</span>\n          <div>\n            <strong>${shortAddress(state.walletAddress)}</strong>\n            <p>${state.walletProvider || \"Solana wallet\"} login active. Payment unlocks the full build for this wallet.</p>\n            <code class=\"address-code\">${state.walletAddress}</code>\n          </div>\n        </div>\n        ${\n          state.order\n            ? `<div class=\"payment-box\">\n                <div><span>Amount</span><strong>${state.order.amount} ${state.order.token}</strong></div>\n                <div><span>Network</span><strong>${state.order.chain}</strong></div>\n                <div><span>USDT Mint</span><code>${state.order.usdtMint}</code></div>\n                <div><span>Official receiver wallet</span><code>${state.order.recipient}</code></div>\n                <div><span>Order memo</span><code>${state.order.memo}</code></div>\n                <div><span>Status</span><strong>${state.order.status}</strong></div>\n                ${state.order.signature ? `<div><span>Signature</span><code>${state.order.signature}</code></div>` : \"\"}\n              </div>`\n            : `<div class=\"payment-box muted-box\">\n                <p>Create an order first. Then pay from MetaMask Send on Solana Mainnet and paste the confirmed transaction signature to unlock download.</p>\n              </div>`\n        }\n        ${\n          state.order\n            ? `<div class=\"manual-pay-box\">\n                <h2>Real mainnet payment</h2>\n                <p>Open MetaMask Send manually. Select Solana Mainnet and USDT. Send exactly ${state.order.amount} USDT to official wallet ${state.order.recipient}. Paste the confirmed transaction signature below.</p>\n                <button class=\"primary pay\" onclick=\"copyManualPaymentDetails()\" ${state.paymentBusy ? \"disabled\" : \"\"}>${icon(\"card\")} Copy payment details</button>\n                <input class=\"signature-input\" placeholder=\"Paste Solana transaction signature\" value=\"${state.manualSignature}\" oninput=\"setManualSignature(this.value)\" />\n                <button class=\"secondary neutral\" onclick=\"verifyPayment()\" ${state.paymentBusy ? \"disabled\" : \"\"}>${icon(\"check\")} Verify pasted signature</button>\n                <button class=\"text-link\" onclick=\"copyPaymentAddress()\">Copy recipient address only</button>\n              </div>`\n            : `<div class=\"button-stack\">\n                <button class=\"primary pay\" onclick=\"createPaymentOrder()\" ${state.paymentBusy ? \"disabled\" : \"\"}>${icon(\"card\")} Create real payment order</button>\n                <button class=\"text-link\" onclick=\"connectWallet()\">Reconnect MetaMask Solana</button>\n              </div>`\n        }\n        ${state.paymentNotice ? `<p class=\"payment-notice\">${state.paymentNotice}</p>` : \"\"}\n        ${state.paymentError ? `<p class=\"wallet-error\">${state.paymentError}</p>` : \"\"}\n        ${\n          state.walletReadiness\n            ? `<div class=\"payment-box readiness-box\">\n                <div><span>SOL</span><strong>${state.walletReadiness.sol}</strong></div>\n                <div><span>USDT</span><strong>${state.walletReadiness.usdt}</strong></div>\n                <div><span>User USDT ATA</span><strong>${state.walletReadiness.hasUserUsdtTokenAccount ? \"Ready\" : \"Missing\"}</strong></div>\n                <div><span>Receiver USDT ATA</span><strong>${state.walletReadiness.hasReceiverUsdtTokenAccount ? \"Ready\" : \"Will be created\"}</strong></div>\n              </div>`\n            : \"\"\n        }\n        <button class=\"text-link\" onclick=\"setView('demo')\">Return to demo</button>\n        <p class=\"secure\">Only pay USDT on Solana. Do not send SOL, USDC, ETH, TRON USDT, or other tokens.</p>\n        <div class=\"after-payment\">${icon(\"download\")} After payment: Download full build</div>\n      </section>\n    </main>\n  `;\n}\n"}}
