{"timestamp":"2026-05-23T12:49:21.939Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_8jxsugUe7GMoge19TDS0ga8W","output":"Chunk ID: 9b464b\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1455\nOutput:\n      return order;\n    }\n    order.status = \"amount_mismatch\";\n    order.error = \"USDT amount is lower than required.\";\n    return order;\n  }\n  order.status = \"waiting_payment\";\n  order.error = \"Payment not found yet.\";\n  return order;\n}\n\nasync function serveStatic(req, res) {\n  const requestUrl = new URL(req.url, `http://${req.headers.host}`);\n  const pathname = decodeURIComponent(requestUrl.pathname === \"/\" ? \"/index.html\" : requestUrl.pathname);\n  const filepath = normalize(join(root, pathname));\n  if (!filepath.startsWith(root)) {\n    res.writeHead(403);\n    res.end(\"Forbidden\");\n    return;\n  }\n  try {\n    const data = await readFile(filepath);\n    res.writeHead(200, {\n      \"content-type\": mimeTypes[extname(filepath)] || \"application/octet-stream\",\n      \"cache-control\": \"no-cache\",\n    });\n    res.end(data);\n  } catch {\n    res.writeHead(404);\n    res.end(\"Not found\");\n  }\n}\n\nasync function handleApi(req, res, url) {\n  if (req.method === \"POST\" && url.pathname === \"/api/solana-rpc\") {\n    const payload = await body(req);\n    const controller = new AbortController();\n    const timeout = setTimeout(() => controller.abort(), 12_000);\n    try {\n      const response = await fetch(rpcUrl, {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify(payload),\n        signal: controller.signal,\n      });\n      const text = await response.text();\n      res.writeHead(response.status, {\n        \"content-type\": \"application/json; charset=utf-8\",\n        \"cache-control\": \"no-store\",\n      });\n      res.end(text);\n    } catch (error) {\n      json(res, 504, { error: error.name === \"AbortError\" ? \"Solana RPC timeout\" : \"Solana RPC failed\" });\n    } finally {\n      clearTimeout(timeout);\n    }\n    return;\n  }\n  if (req.method === \"GET\" && url.pathname === \"/api/config\") {\n    json(res, 200, {\n      gameId: config.gameId,\n      gameTitle: config.gameTitle,\n      amountUsdt: config.amountUsdt,\n      tokenDecimals: config.tokenDecimals,\n      tokenSymbol: config.tokenSymbol,\n      chain: config.chain,\n      recipient: config.recipient,\n      usdtMint: config.usdtMint,\n    });\n    return;\n  }\n  if (req.method === \"GET\" && url.pathname === \"/api/wallet-readiness\") {\n    const walletAddress = url.searchParams.get(\"wallet\");\n    if (!walletAddress) {\n      json(res, 400, { error: \"wallet query parameter is required.\" });\n      return;\n    }\n    const [solBalance, userTokenAccounts, receiverTokenAccounts] = await Promise.all([\n      rpc(\"getBalance\", [walletAddress, { commitment: \"confirmed\" }]),\n      rpc(\"getTokenAccountsByOwner\", [\n        walletAddress,\n        { mint: config.usdtMint },\n        { encoding: \"jsonParsed\" },\n      ]),\n      rpc(\"getTokenAccountsByOwner\", [\n        config.recipient,\n        { mint: config.usdtMint },\n        { encoding: \"jsonParsed\" },\n      ]),\n    ]);\n    const tokenAccount = userTokenAccounts.value?.[0] || null;\n    const rawUsdt = BigInt(tokenAccount?.account?.data?.parsed?.info?.tokenAmount?.amount || \"0\");\n    const hasReceiverTokenAccount = Boolean(receiverTokenAccounts.value?.length);\n    const needs = [];\n    if ((solBalance.value || 0) < 2_060_000) {\n      needs.push(\"Add SOL to this wallet for mainnet fees and possible receiver USDT account creation.\");\n    }\n    if (!tokenAccount) {\n      needs.push(\"Add SPL USDT on Solana to this wallet.\");\n    } else if (rawUsdt < config.amountBaseUnits) {\n      needs.push(`Add at least ${config.amountUsdt} USDT on Solana to this wallet.`);\n    }\n    json(res, 200, {\n      walletAddress,\n      solLamports: solBalance.value || 0,\n      sol: (Number(solBalance.value || 0) / 1_000_000_000).toFixed(9),\n      usdtBaseUnits: rawUsdt.toString(),\n      usdt: (Number(rawUsdt) / 1_000_000).toFixed(6),\n      hasUserUsdtTokenAccount: Boolean(tokenAccount),\n      hasReceiverUsdtTokenAccount: hasReceiverTokenAccount,\n      canPay: needs.length === 0,\n      needs,\n    });\n    return;\n  }\n  if (req.method === \"POST\" && url.pathname === \"/api/orders\") {\n    const payload = await body(req);\n    if (!payload.walletAddress || payload.gameId !== config.gameId) {\n      json(res, 400, { error: \"walletAddress and valid gameId are required.\" });\n      return;\n    }\n    json(res, 200, { order: publicOrder(createOrder(payload.walletAddress, payload.gameId)) });\n    return;\n  }\n  const verifyMatch = url.pathname.match(/^\\/api\\/orders\\/([^/]+)\\/verify$/);\n  if (req.method === \"POST\" && verifyMatch) {\n    const order = orders.get(verifyMatch[1]);\n    if (!order) {\n      json(res, 404, { error: \"Order not found.\" });\n      return;\n    }\n    const payload = await body(req);\n    try {\n      await verifyOnChain(order, payload.signature || \"\");\n      json(res, 200, { order: publicOrder(order) });\n    } catch (error) {\n      order.error = error.message || \"Payment verification failed.\";\n      json(res, 200, { order: publicOrder(order) });\n    }\n    return;\n  }\n  const simulateMatch = url.pathname.match(/^\\/api\\/orders\\/([^/]+)\\/simulate-paid$/);\n  if (req.method === \"POST\" && simulateMatch) {\n    const order = orders.get(simulateMatch[1]);\n    if (!order) {\n      json(res, 404, { error: \"Order not found.\" });\n      return;\n    }\n    order.status = \"paid\";\n    order.signature = `local-test-${shortId()}`;\n    order.error = \"\";\n    order.paidAt = new Date().toISOString();\n    json(res, 200, { order: publicOrder(order) });\n    return;\n  }\n  json(res, 404, { error: \"Unknown API route.\" });\n}\n\nconst server = createServer(async (req, res) => {\n  const url = new URL(req.url, `http://${req.headers.host}`);\n  try {\n    if (url.pathname.startsWith(\"/api/\")) {\n      await handleApi(req, res, url);\n      return;\n    }\n    await serveStatic(req, res);\n  } catch (error) {\n    json(res, 500, { error: error.message || \"Server error.\" });\n  }\n});\n\n"}}
