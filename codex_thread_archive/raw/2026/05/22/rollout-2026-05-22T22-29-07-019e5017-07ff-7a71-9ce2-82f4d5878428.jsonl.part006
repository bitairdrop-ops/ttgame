{"timestamp":"2026-05-23T11:16:09.614Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_c177PLaCpb0ivs0gLf8u0gYT","output":"Chunk ID: 02f8eb\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 738\nOutput:\n    const data = await readFile(filepath);\n    res.writeHead(200, {\n      \"content-type\": mimeTypes[extname(filepath)] || \"application/octet-stream\",\n      \"cache-control\": \"no-cache\",\n    });\n    res.end(data);\n  } catch {\n    res.writeHead(404);\n    res.end(\"Not found\");\n  }\n}\n\nasync function handleApi(req, res, url) {\n  if (req.method === \"POST\" && url.pathname === \"/api/solana-rpc\") {\n    const payload = await body(req);\n    const response = await fetch(rpcUrl, {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify(payload),\n    });\n    const text = await response.text();\n    res.writeHead(response.status, {\n      \"content-type\": \"application/json; charset=utf-8\",\n      \"cache-control\": \"no-store\",\n    });\n    res.end(text);\n    return;\n  }\n  if (req.method === \"GET\" && url.pathname === \"/api/config\") {\n    json(res, 200, {\n      gameId: config.gameId,\n      gameTitle: config.gameTitle,\n      amountUsdt: config.amountUsdt,\n      tokenDecimals: config.tokenDecimals,\n      tokenSymbol: config.tokenSymbol,\n      chain: config.chain,\n      recipient: config.recipient,\n      usdtMint: config.usdtMint,\n    });\n    return;\n  }\n  if (req.method === \"GET\" && url.pathname === \"/api/wallet-readiness\") {\n    const walletAddress = url.searchParams.get(\"wallet\");\n    if (!walletAddress) {\n      json(res, 400, { error: \"wallet query parameter is required.\" });\n      return;\n    }\n    const [solBalance, userTokenAccounts, receiverTokenAccounts] = await Promise.all([\n      rpc(\"getBalance\", [walletAddress, { commitment: \"confirmed\" }]),\n      rpc(\"getTokenAccountsByOwner\", [\n        walletAddress,\n        { mint: config.usdtMint },\n        { encoding: \"jsonParsed\" },\n      ]),\n      rpc(\"getTokenAccountsByOwner\", [\n        config.recipient,\n        { mint: config.usdtMint },\n        { encoding: \"jsonParsed\" },\n      ]),\n    ]);\n    const tokenAccount = userTokenAccounts.value?.[0] || null;\n    const rawUsdt = BigInt(tokenAccount?.account?.data?.parsed?.info?.tokenAmount?.amount || \"0\");\n    const hasReceiverTokenAccount = Boolean(receiverTokenAccounts.value?.length);\n    const needs = [];\n    if ((solBalance.value || 0) < 2_060_000) {\n      needs.push(\"Add SOL to this wallet for mainnet fees and possible receiver USDT account creation.\");\n    }\n    if (!tokenAccount) {\n      needs.push(\"Add SPL USDT on Solana to this wallet.\");\n    } else if (rawUsdt < config.amountBaseUnits) {\n      needs.push(`Add at least ${config.amountUsdt} USDT on Solana to this wallet.`);\n    }\n    json(res, 200, {\n      walletAddress,\n      solLamports: solBalance.value || 0,\n      sol: (Number(solBalance.value || 0) / 1_000_000_000).toFixed(9),\n      usdtBaseUnits: rawUsdt.toString(),\n      usdt: (Number(rawUsdt) / 1_000_000).toFixed(6),\n      hasUserUsdtTokenAccount: Boolean(tokenAccount),\n      hasReceiverUsdtTokenAccount: hasReceiverTokenAccount,\n      canPay: needs.length === 0,\n"}}
{"timestamp":"2026-05-23T11:16:09.614Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_baAqaS3PS5E23r3uZk11i6v6","output":"Chunk ID: ea91e8\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 550\nOutput:\nimport { createServer } from \"node:http\";\nimport { randomBytes } from \"node:crypto\";\nimport { readFile } from \"node:fs/promises\";\nimport { extname, join, normalize } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst root = fileURLToPath(new URL(\".\", import.meta.url));\nconst port = Number(process.env.PORT || 5180);\nconst rpcUrl = process.env.SOLANA_RPC_URL || \"https://solana-rpc.publicnode.com\";\n\nconst config = {\n  gameId: \"clockwork\",\n  gameTitle: \"Quiet Dungeon Treasure\",\n  amountUsdt: \"0.5\",\n  amountBaseUnits: 500_000n,\n  tokenDecimals: 6,\n  tokenSymbol: \"USDT\",\n  chain: \"Solana Mainnet\",\n  recipient: \"7MsAkdANC9d9MxRz1G1nndz1F8TnHnWsZBFp2EVQiYE9\",\n  usdtMint: \"Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB\",\n};\n\nconst orders = new Map();\nconst mimeTypes = {\n  \".html\": \"text/html; charset=utf-8\",\n  \".js\": \"text/javascript; charset=utf-8\",\n  \".css\": \"text/css; charset=utf-8\",\n  \".png\": \"image/png\",\n  \".jpg\": \"image/jpeg\",\n  \".jpeg\": \"image/jpeg\",\n  \".wasm\": \"application/wasm\",\n  \".pck\": \"application/octet-stream\",\n  \".zip\": \"application/zip\",\n};\n\nconst alphabet = \"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz\";\n\nfunction base58(bytes) {\n  let value = BigInt(`0x${Buffer.from(bytes).toString(\"hex\")}`);\n  let encoded = \"\";\n  while (value > 0n) {\n    const mod = value % 58n;\n    encoded = alphabet[Number(mod)] + encoded;\n    value /= 58n;\n  }\n  for (const byte of bytes) {\n    if (byte === 0) encoded = \"1\" + encoded;\n    else break;\n  }\n  return encoded || \"1\";\n}\n\nfunction json(res, status, payload) {\n  const data = JSON.stringify(payload);\n  res.writeHead(status, {\n    \"content-type\": \"application/json; charset=utf-8\",\n    \"cache-control\": \"no-store\",\n  });\n  res.end(data);\n}\n\nasync function body(req) {\n  const chunks = [];\n  for await (const chunk of req) chunks.push(chunk);\n  if (!chunks.length) return {};\n  return JSON.parse(Buffer.concat(chunks).toString(\"utf8\"));\n}\n\nfunction shortId() {\n  return base58(randomBytes(9));\n}\n\nfunction publicOrder(order) {\n  return {\n    id: order.id,\n    gameId: order.gameId,\n    walletAddress: order.walletAddress,\n    amount: config.amountUsdt,\n    token: config.tokenSymbol,\n    chain: config.chain,\n"}}
