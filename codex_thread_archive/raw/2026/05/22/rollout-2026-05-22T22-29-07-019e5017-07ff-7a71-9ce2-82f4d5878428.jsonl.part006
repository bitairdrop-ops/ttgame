op: 0;\n}\n\nh1 {\n  margin-bottom: 14px;\n  font-size: clamp(34px, 4vw, 56px);\n  line-height: 1;\n  letter-spacing: 0;\n}\n\n.action-panel h1 {\n  font-size: clamp(36px, 4.8vw, 64px);\n}\n\n.copy {\n  color: var(--muted);\n  font-size: 18px;\n  line-height: 1.55;\n}\n\n.price-line {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  margin-bottom: 18px;\n}\n\n.price-line span {\n  font-size: 36px;\n  font-weight: 820;\n}\n\n.price-line small,\n.micro,\n.secure {\n  color: var(--muted);\n}\n\n.button-stack {\n  display: grid;\n  gap: 14px;\n  margin: 22px 0 16px;\n}\n\n.primary,\n.secondary,\n.mini {\n  min-height: 54px;\n  border-radius: 8px;\n  border: 1px solid transparent;\n  color: var(--text);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  font-weight: 780;\n  text-decoration: none;\n}\n\n.primary.play,\n.primary.download {\n  background: linear-gradient(180deg, #17a9ff, #087ee7);\n  border-color: rgba(146, 218, 255, 0.42);\n  box-shadow: 0 18px 44px rgba(8, 126, 231, 0.28);\n}\n\n.primary.pay,\n.secondary.buy {\n  background: linear-gradient(180deg, rgba(234, 157, 23, 0.92), rgba(123, 76, 5, 0.88));\n  border-color: rgba(255, 191, 92, 0.42);\n  box-shadow: 0 18px 44px rgba(178, 105, 8, 0.2);\n}\n\n.secondary.neutral {\n  background: rgba(255, 255, 255, 0.055);\n  border-color: var(--line-strong);\n}\n\n"}}
