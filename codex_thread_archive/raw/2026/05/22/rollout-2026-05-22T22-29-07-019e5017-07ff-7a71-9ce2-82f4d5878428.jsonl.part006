{"timestamp":"2026-05-23T11:25:04.439Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_cJf2ZDy8S6qkIcinWNIoDIGO","output":"Chunk ID: bc3436\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 825\nOutput:\n        ${flow(\"pay\")}\n        <div class=\"wallet-payment\">\n          <span class=\"wallet-icon\">${icon(\"wallet\")}</span>\n          <div>\n            <strong>${shortAddress(state.walletAddress)}</strong>\n            <p>${state.walletProvider || \"Solana wallet\"} login active. Payment unlocks the full build for this wallet.</p>\n            <code class=\"address-code\">${state.walletAddress}</code>\n          </div>\n        </div>\n        ${\n          state.order\n            ? `<div class=\"payment-box\">\n                <div><span>Amount</span><strong>${state.order.amount} ${state.order.token}</strong></div>\n                <div><span>Network</span><strong>${state.order.chain}</strong></div>\n                <div><span>USDT Mint</span><code>${state.order.usdtMint}</code></div>\n                <div><span>Recipient</span><code>${state.order.recipient}</code></div>\n                <div><span>Memo</span><code>${state.order.memo}</code></div>\n                <div><span>Status</span><strong>${state.order.status}</strong></div>\n                ${state.order.signature ? `<div><span>Signature</span><code>${state.order.signature}</code></div>` : \"\"}\n              </div>`\n            : `<div class=\"payment-box muted-box\">\n                <p>Order will be created with a unique memo and reference. The backend validates USDT mint, receiver wallet, amount, wallet signer, and memo before unlocking download.</p>\n              </div>`\n        }\n        <div class=\"button-stack\">\n          <button class=\"primary pay\" onclick=\"pay()\" ${state.paymentBusy ? \"disabled\" : \"\"}>${icon(\"wallet\")} ${state.order ? \"Pay 0.5 USDT with Wallet\" : \"Create Payment Order\"}</button>\n          ${state.order ? `<button class=\"secondary neutral\" onclick=\"verifyPayment()\" ${state.paymentBusy ? \"disabled\" : \"\"}>${icon(\"check\")} Verify Payment</button>` : \"\"}\n          ${state.order ? `<button class=\"text-link\" onclick=\"copyPaymentAddress()\">Copy recipient address</button>` : \"\"}\n          <button class=\"text-link\" onclick=\"connectWallet()\">Reconnect MetaMask Solana</button>\n          ${state.order ? `<button class=\"text-link dev-link\" onclick=\"simulatePaid()\">Local test: mark paid</button>` : \"\"}\n        </div>\n        ${state.paymentNotice ? `<p class=\"payment-notice\">${state.paymentNotice}</p>` : \"\"}\n        ${state.paymentError ? `<p class=\"wallet-error\">${state.paymentError}</p>` : \"\"}\n        ${\n          state.walletReadiness\n            ? `<div class=\"payment-box readiness-box\">\n                <div><span>SOL</span><strong>${state.walletReadiness.sol}</strong></div>\n                <div><span>USDT</span><strong>${state.walletReadiness.usdt}</strong></div>\n                <div><span>User USDT ATA</span><strong>${state.walletReadiness.hasUserUsdtTokenAccount ? \"Ready\" : \"Missing\"}</strong></div>\n                <div><span>Receiver USDT ATA</span><strong>${state.walletReadiness.hasReceiverUsdtTokenAccount ? \"Ready\" : \"Will be created\"}</strong></div>\n              </div>`\n            : \"\"\n        }\n        <button class=\"text-link\" onclick=\"setView('demo')\">Return to demo</button>\n        <p class=\"secure\">Only pay USDT on Solana. Do not send SOL, USDC, ETH, TRON USDT, or other tokens.</p>\n        <div class=\"after-payment\">${icon(\"download\")} After payment: Download full build</div>\n"}}
