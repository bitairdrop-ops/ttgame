c[\"exitTarget\"] = _nearest_story_exit(Vector2(npc.get(\"position\", player.global_position)))\n\t\tvar body: CharacterBody2D = npc.get(\"body\", null)\n\t\tif body != null and is_instance_valid(body):\n\t\t\tbody.collision_layer = 0\n\t\t\tbody.collision_mask = 0\n\t_close_story_choice(false)\n\tdialogue_auto_hide_timer = STORY_DIALOGUE_RESULT_SECONDS\n\nfunc _close_story_choice(hide_dialogue: bool = true) -> void:\n\tstory_choice_open = false\n\tstory_choice_ready = false\n\tstory_dialogue_line_index = 0\n\tif dialogue_accept_button != null:\n\t\tdialogue_accept_button.visible = false\n\tif dialogue_reject_button != null:\n\t\tdialogue_reject_button.visible = false\n\tif hide_dialogue and dialogue_panel != null:\n\t\tdialogue_panel.visible = false\n\tdialogue_auto_hide_timer = 0.0\n\nfunc _update_dialogue_auto_hide(delta: float) -> void:\n\tif dialogue_auto_hide_timer <= 0.0 or story_choice_open:\n\t\treturn\n\tdialogue_auto_hide_timer = max(0.0, dialogue_auto_hide_timer - delta)\n\tif dialogue_auto_hide_timer <= 0.0 and dialogue_panel != null:\n\t\tdialogue_panel.visible = false\n\nfunc _apply_story_state_delta(delta: Dictionary) -> void:\n\tfor key in delta.keys():\n\t\tvar next_value := int(story_world_state.get(String(key), 0)) + int(delta[key])\n\t\tstory_world_state[String(key)] = max(0, next_value)\n\nfunc _nearest_story_exit(pos: Vector2) -> Vector2:\n\tvar margin := active_cell_px * 1.5\n\tvar left := Vector2(-margin, pos.y)\n\tvar right := Vector2(active_map_w * active_cell_px + margin, pos.y)\n\tvar top := Vector2(pos.x, -margin)\n\tvar bottom := Vector2(pos.x, active_map_h * active_cell_px + margin)\n\tvar exits := [left, right, top, bottom]\n\tvar best: Vector2 = exits[0]\n\tvar best_dist := INF\n\tfor exit_pos in exits:\n\t\tvar distance := pos.distance_to(exit_pos)\n\t\tif distance < best_dist:\n\t\t\tbest = exit_pos\n\t\t\tbest_dist = distance\n\treturn best\n\nfunc _story_actor_outside_map(pos: Vector2) -> bool:\n\tvar margin := active_cell_px * 0.5\n\treturn pos.x < -margin or pos.y < -margin or pos.x > active_map_w * active_cell_px + margin or pos.y > active_map_h * active_cell_px + margin\n\nfunc _remove_story_npc(npc: Dictionary) -> void:\n\tvar body: Node = npc.get(\"body\", null)\n\tif body != null and is_instance_valid(body):\n\t\tbody.queue_free()\n\tactive_npcs.erase(npc)\n\nfunc _asset_id_texture_path(asset_id: String) -> String:\n\tif asset_id == \"\":\n\t\treturn \"\"\n\tvar manifest := _json_dict(KENNEY_MAP_MANIFEST_JSON)\n\tfor item in manifest.get(\"assets\", []):\n\t\tif typeof(item) == TYPE_DICTIONARY and String(item.get(\"id\", \"\")) == asset_id:\n\t\t\tvar rel_path := String(item.get(\"file\", \"\"))\n\t\t\tif rel_path != \"\":\n\t\t\t\treturn \"res://\" + rel_path\n\treturn \"\"\n\nfunc _create_movable_npc_body(visual_node: Sprite2D, world_pos: Vector2, node_offset: Vector2) -> CharacterBody2D:\n\tvar body := CharacterBody2D.new()\n\tbody.name = \"MovableNPC_CharacterBody2D\"\n\tbody.position = world_pos\n\tbody.collision_layer = 1\n\tbody.collision_mask = 1\n\tbody.z_index = visual_node.z_index\n\tmap_root.add_child(body)\n\tvisual_node.get_parent().remove_child(visual_node)\n\tbody.add_child(visual_node)\n\tvisual_node.position = node_offset\n\n\tvar collision := CollisionShape2D.new()\n\tvar shape := CircleShape2D.new()\n\tshape.radius = max(5.0, active_cell_px * 0.35)\n\tcollision.shape = shape\n\tbody.add_child(collision)\n"}}
