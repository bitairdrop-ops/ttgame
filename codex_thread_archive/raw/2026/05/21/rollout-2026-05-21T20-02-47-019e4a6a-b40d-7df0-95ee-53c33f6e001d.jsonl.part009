et(\"lines\", []),\n\t\t\"lineIndex\": 0,\n\t\t\"position\": world_pos,\n\t\t\"interactionRadius\": active_cell_px * 1.5,\n\t\t\"behavior\": \"story_approach\",\n\t\t\"ai\": definition.get(\"ai\", {}),\n\t\t\"stats\": stats,\n\t\t\"home\": world_pos,\n\t\t\"target\": player.global_position,\n\t\t\"path\": [],\n\t\t\"pauseTimer\": 0.0,\n\t\t\"fleeTimer\": 0.0,\n\t\t\"fleeFrom\": world_pos,\n\t\t\"helpSignalTimer\": 0.0,\n\t\t\"repathTimer\": 0.0,\n\t\t\"stuckTimer\": 0.0,\n\t\t\"lastPosition\": world_pos,\n\t\t\"moveTimer\": 0.0,\n\t\t\"node\": sprite,\n\t\t\"body\": body,\n\t\t\"nodeOffset\": Vector2.ZERO,\n\t\t\"framePaths\": frame_paths,\n\t\t\"facing\": \"down\",\n\t\t\"animFrame\": 0,\n\t\t\"animTime\": 0.0,\n\t\t\"interactable\": true,\n\t}\n\tactive_npcs.append(npc)\n\treturn npc\n\nfunc _add_system_npc_marker(parent: Node2D) -> void:\n\tvar marker := Sprite2D.new()\n\tmarker.name = \"SystemNpcTalkMarker\"\n\tmarker.centered = true\n\tmarker.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n\tmarker.z_index = 30\n\tmarker.position = Vector2(0, -11)\n\tmarker.texture = _system_npc_marker_texture()\n\tparent.add_child(marker)\n\nfunc _system_npc_marker_texture() -> Texture2D:\n\tvar cache_key := \"__system_npc_marker_texture\"\n\tif atlas_cache.has(cache_key):\n\t\treturn atlas_cache[cache_key]\n\tvar image := Image.create(9, 9, false, Image.FORMAT_RGBA8)\n\timage.fill(Color(0, 0, 0, 0))\n\tvar pixels := {\n\t\tVector2i(4, 0): Color(1.0, 0.96, 0.42, 0.75),\n\t\tVector2i(3, 1): Color(1.0, 0.96, 0.42, 0.55),\n"}}
