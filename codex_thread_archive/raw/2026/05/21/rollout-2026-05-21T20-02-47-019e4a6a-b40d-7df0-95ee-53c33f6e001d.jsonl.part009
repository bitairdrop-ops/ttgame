/containers/api.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/containers/gotchas.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/do-storage/configuration.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/do-storage/patterns.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/do-storage/README.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/do-storage/testing.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/do-storage/api.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/do-storage/gotchas.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/email-workers/configuration.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/email-workers/patterns.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/email-workers/README.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/email-workers/api.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/email-workers/gotchas.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/c3/configuration.md\n/Users/vincet/.codex/plugins/cache/openai-curated/cloudflare/5e86d584/skills/cloudflare/references/c3/patterns.md\n"}}
