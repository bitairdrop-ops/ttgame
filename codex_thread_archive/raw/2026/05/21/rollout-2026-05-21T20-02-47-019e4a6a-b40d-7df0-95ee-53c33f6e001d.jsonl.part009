0;\n+  for (let index = 0; index < pixels.length; index += 4) {\n+    const alpha = pixels[index + 3] / 255;\n+    if (alpha <= 0.05) continue;\n+    r += pixels[index] * alpha;\n+    g += pixels[index + 1] * alpha;\n+    b += pixels[index + 2] * alpha;\n+    weight += alpha;\n+  }\n+  if (weight <= 0) return DEFAULT_MAP_BACKGROUND_COLOR;\n+  return `rgb(${canvasColorComponent(r / weight)}, ${canvasColorComponent(g / weight)}, ${canvasColorComponent(b / weight)})`;\n+}\n+\n+async function applyBackgroundAsset(asset) {\n+  const color = await averageAssetColor(asset);\n+  setMapBackground({\n+    assetId: asset.id,\n+    tileNo: assetTileNo(asset),\n+    color,\n+  });\n+  for (let y = 0; y < ROWS; y += 1) {\n+    for (let x = 0; x < COLS; x += 1) {\n+      terrain[y][x] = null;\n+    }\n+  }\n+  renderTerrain();\n+  statusText.textContent = `Changed the whole map ground color to ${assetLabel(asset)}.`;\n+}\n+\n function buildBoard() {\n   board.innerHTML = \"\";\n   cells.length = 0;\n@@ -413,10 +611,11 @@ function buildBoard() {\n }\n \n function renderTerrain() {\n+  board.style.setProperty(\"--map-background-color\", mapBackground.color || DEFAULT_MAP_BACKGROUND_COLOR);\n   for (const cell of cells) {\n     const x = Number(cell.dataset.x);\n     const y = Number(cell.dataset.y);\n-    const asset = assetById(terrain[y][x]) || defaultTile();\n+    const asset = assetById(terrain[y][x]);\n     cell.style.backgroundImage = asset ? `url(\"${assetUrl(asset)}\")` : \"\";\n   }\n }\n@@ -444,6 +643,9 @@ function buildPackageSelect() {\n }\n \n function assetPurpose(asset) {\n+  if (asset?.tileIndex && PURPOSE_OVERRIDE_BY_TILE_INDEX.has(asset.tileIndex)) {\n+    return PURPOSE_OVERRIDE_BY_TILE_INDEX.get(asset.tileIndex);\n+  }\n   const text = `${asset.package} ${asset.category} ${asset.id} ${asset.name}`.toLowerCase();\n   const path = asset.id.toLowerCase();\n   const tileNumber = Number((path.match(/(?:tile|maptile)_(\\d+)/) || [])[1]);\n@@ -456,6 +658,7 @@ function a