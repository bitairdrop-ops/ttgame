ExportCell(assetId) {\n   return {\n+    assetId: assetId || null,\n+    tileNo: assetTileNo(assetId),\n+  };\n+}\n+\n+function assetCatalogData() {\n+  return ASSETS.map((asset) => ({\n+    tileNo: asset.tileNo,\n+    tileIndex: asset.tileIndex,\n+    assetId: asset.id,\n+    name: asset.name,\n+    package: asset.package,\n+    category: asset.category,\n+    purpose: assetPurpose(asset),\n+    file: asset.file,\n+  }));\n+}\n+\n+function currentEditorMapData(options = {}) {\n+  const data = {\n     assetLibrary: MANIFEST_URL,\n+    tileNumbering: {\n+      prefix: UNIFIED_TILE_PREFIX,\n+      format: `${UNIFIED_TILE_PREFIX}-0001`,\n+      scope: \"current editor asset library\",\n+      count: ASSETS.length,\n+    },\n     cols: COLS,\n     rows: ROWS,\n     cell: CELL,\n     name: currentMapName,\n-    terrain: terrain.map((row) => [...row]),\n-    stamps: stamps.map((stamp) => ({ ...stamp })),\n+    background: { ...mapBackground },\n+    terrain: terrain.map((row) => row.map((assetId) => terrainExportCell(assetId))),\n+    stamps: stamps.map((stamp) => ({\n+      ...stamp,\n+      tileNo: stamp.tileNo || assetTileNo(stamp.assetId),\n+    })),\n   };\n+  if (options.includeCatalog) data.assetCatalog = assetCatalogData();\n+  return data;\n }\n \n function savedMaps() {\n@@ -1129,25 +1383,29 @@ function godotMapDataFromEditorMap(editorMap) {\n   const rows = Number(editorMap?.rows) || ROWS;\n   const cols = Number(editorMap?.cols) || COLS;\n   const sourceTerrain = Array.isArray(editorMap?.terrain) ? editorMap.terrain : [];\n+  const background = editorMap?.background?.color ? editorMap.background : mapBackground;\n   return {\n     format: \"GameGmetaGodotMap\",\n     version: 1,\n     cols,\n     rows,\n     cell: CELL,\n+    background: { ...background },\n     terrain: Array.from({ length: rows }, (_, y) => Array.from({ length: cols }, (_, x) => {\n       const sourceId = normalizeTerrainCell(sourceTerrain[y]?.[x]) || groundId;\n       const asset = assetById(sourceId) || assetById(groundId);\n       const assetId = asset?.id || groundId;\n       return {\n         assetId,\n+        tileNo: assetTileNo(assetId),\n         texture: asset?.file ? `res://${asset.file}` : \"\",\n-        blocking: !isBaseTerrainAsset(asset),\n+        blocking: isBlockingTerrainAsset(asset) || !isBaseTerrainAsset(asset),\n       };\n     })),\n     objects: (editorMap?.stamps || []).filter((stamp) => !isBaseTerrainAsset(assetById(stamp.assetId))).map((stamp) => ({\n       id: stamp.id,\n       assetId: stamp.assetId || null,\n+      tileNo: stamp.tileNo || assetTileNo(stamp.assetId),\n       texture: stampTexturePath(stamp),\n       x: stamp.x,\n       y: stamp.y,\n@@ -1402,7 +1660,7 @@ function downloadJson(data, filename) {\n }\n \n function exportMap() {\n-  copyJson(currentEditorMapData(), \"Map editor JSON copied to the clipboard.\");\n+  copyJson(currentEditorMapData({ includeCatalog: true }), \"Map editor JSON with unified tile numbers copied to the clipboard.\");\n }\n \n function exportGodotMap() {\n@@ -1509,7 +1767,8 @@ async function loadLibrary() {\n   const response = await fetch(`${MANIFEST_URL}?v=${encodeURIComponent(ASSET_CACHE_KEY)}`);\n   if (!response.ok) throw new Error(`Cannot read Kenney manifest: ${response.status}`);\n   const manifest = await response.json();\n-  ASSETS = tinyOnlyAssets(manifest.assets || []);\n+  ASSETS = assignUnifiedTileNumbers(tinyOnlyAssets(manifest.assets || []))\n+    .filter((asset) => !EDITOR_EXCLUDED_ASSET_IDS.has(asset.id));\n   PACKAGES = tinyOnlyPackages(manifest.packages || [], ASSETS);\n   if (!PACKAGES.some((pack) => pack.name === activePackage)) activePackage = PACKAGES[0]?.name || \"全部\";\n   const visibleCount = visibleLibraryAssets().length;\n"}}
