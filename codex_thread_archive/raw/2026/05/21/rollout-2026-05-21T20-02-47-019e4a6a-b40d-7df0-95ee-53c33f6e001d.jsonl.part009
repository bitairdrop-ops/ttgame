{"timestamp":"2026-06-02T14:27:51.265Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_vvsPEkKRZJmiOeyF7I0MxIil","output":"Chunk ID: 0353da\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 625\nOutput:\n\nfunction assetById(id) {\n  return ASSETS.find((asset) => asset.id === id);\n}\n\nfunction unifiedTileNo(index) {\n  return `${UNIFIED_TILE_PREFIX}-${String(index + 1).padStart(4, \"0\")}`;\n}\n\nfunction assignUnifiedTileNumbers(assets) {\n  return assets.map((asset, index) => ({\n    ...asset,\n    tileNo: unifiedTileNo(index),\n    tileIndex: index + 1,\n  }));\n}\n\nfunction assetTileNo(assetOrId) {\n  const asset = typeof assetOrId === \"string\" ? assetById(assetOrId) : assetOrId;\n  return asset?.tileNo || \"\";\n}\n\nfunction assetLabel(asset) {\n  if (!asset) return \"Unknown Asset\";\n  return asset.tileNo ? `${asset.tileNo} ${asset.name}` : asset.name;\n}\n\nfunction assetDisplayNumber(asset) {\n  return asset?.tileIndex ? String(asset.tileIndex).padStart(4, \"0\") : \"\";\n}\n\nfunction tinyOnlyAssets(assets) {\n  return assets.filter((asset) => {\n    const packageName = asset.package || \"\";\n    if (!EDITOR_PACKAGE_PREFIXES.some((prefix) => packageName.startsWith(prefix))) return false;\n    if (EDITOR_EXCLUDED_PACKAGES.has(packageName)) return false;\n    if (packageName === EDITOR_CURATED_TREE_PACKAGE) return true;\n    return assetPurpose(asset) !== \"植物-树木森林\";\n  });\n}\n\nfunction tinyOnlyPackages(packagesList, assets) {\n  const counts = new Map();\n  for (const asset of assets) counts.set(asset.package, (counts.get(asset.package) || 0) + 1);\n  return packagesList\n    .filter((pack) =>\n      EDITOR_PACKAGE_PREFIXES.some((prefix) => pack.name.startsWith(prefix)) &&\n      counts.has(pack.name) &&\n      !EDITOR_EXCLUDED_PACKAGES.has(pack.name)\n    )\n    .map((pack) => ({ ...pack, count: counts.get(pack.name) }));\n      statusText.textContent = \"Selection cleared.\";\n    }\n  });\n}\n\nasync function loadLibrary() {\n  loadHiddenLibraryAssets();\n  const response = await fetch(`${MANIFEST_URL}?v=${encodeURIComponent(ASSET_CACHE_KEY)}`);\n  if (!response.ok) throw new Error(`Cannot read Kenney manifest: ${response.status}`);\n  const manifest = await response.json();\n  ASSETS = assignUnifiedTileNumbers(tinyOnlyAssets(manifest.assets || []))\n    .filter((asset) => !EDITOR_EXCLUDED_ASSET_IDS.has(asset.id));\n  PACKAGES = tinyOnlyPackages(manifest.packages || [], ASSETS);\n  if (!PACKAGES.some((pack) => pack.name === activePackage)) activePackage = PACKAGES[0]?.name || \"全部\";\n  const visibleCount = visibleLibraryAssets().length;\n  assetLibraryMeta.textContent = `Tiny, AI, and curated assets ${visibleCount} / ${ASSETS.length}; ${PACKAGES.length} asset packs`;\n  selectedAsset = defaultTile();\n}\n"}}
