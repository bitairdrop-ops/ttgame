ementById(\"categoryTabs\");\nconst selectionLabel = document.getElementById(\"selectionLabel\");\nconst statusText = document.getElementById(\"statusText\");\nconst assetSearch = document.getElementById(\"assetSearch\");\nconst packageSelect = document.getElementById(\"packageSelect\");\nconst purposeSelect = document.getElementById(\"purposeSelect\");\nconst deleteAssetModeButton = document.getElementById(\"deleteAssetMode\");\nconst assetLibraryMeta = document.getElementById(\"assetLibraryMeta\");\nconst mapNameInput = document.getElementById(\"mapNameInput\");\nconst savedMapSelect = document.getElementById(\"savedMapSelect\");\n\nconst terrain = Array.from({ length: ROWS }, () => Array(COLS).fill(null));\nconst cells = [];\nconst stamps = [];\nlet selectedAsset = null;\nlet selectedStampId = null;\nlet activeCategory = \"地形\";\nlet activePurpose = \"全部用途\";\nlet activePackage = \"tiny-town\";\nlet stampSeq = 1;\nlet currentMapName = \"Demo\";\nlet assetDeleteMode = false;\nlet hiddenLibraryAssetIds = new Set();\nlet mapBackground = {\n  assetId: null,\n  tileNo: \"\",\n  color: DEFAULT_MAP_BACKGROUND_COLOR,\n};\n\nconst PURPOSE_ORDER = [\n  \"背景素材\",\n  \"地面-草地\",\n"}}
