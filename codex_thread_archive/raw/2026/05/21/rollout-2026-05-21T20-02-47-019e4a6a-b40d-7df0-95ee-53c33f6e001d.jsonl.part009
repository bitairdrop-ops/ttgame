{"timestamp":"2026-06-02T13:41:08.842Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_otGWvUYbQAXGFuxyse0imrLJ","output":"Chunk ID: 40614f\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1766\nOutput:\n\tinventory_counts[\"wood\"] = wood - wood_cost\n\tinventory_counts[\"stone\"] = stone - stone_cost\n\t_update_inventory_label()\n\treturn true\n\nfunc _nearest_enemy_actor(origin: Vector2, max_range: float, require_clear_line: bool = false) -> Dictionary:\n\tvar best: Dictionary = {}\n\tvar best_distance := max_range\n\tfor npc in active_npcs:\n\t\tif typeof(npc) != TYPE_DICTIONARY or not _is_actor_alive(npc):\n\t\t\tcontinue\n\t\tif String(npc.get(\"gameType\", \"\")) != \"enemy\" and String(npc.get(\"behavior\", \"\")) != \"hostile_ai\":\n\t\t\tcontinue\n\t\tvar pos := _actor_position(npc)\n\t\tvar distance := origin.distance_to(pos)\n\t\tif distance > best_distance:\n\t\t\tcontinue\n\t\tif require_clear_line and not _actor_line_clear(origin, pos):\n\t\t\tcontinue\n\t\tbest = npc\n\t\tbest_distance = distance\n\treturn best\n\nfunc _actor_line_clear(from_pos: Vector2, to_pos: Vector2) -> bool:\n\treturn not _projectile_hits_blocked_cell(from_pos, to_pos)\n\nfunc _apply_direct_damage_to_actor(actor: Dictionary, damage: float, label: String, color: Color, freeze_duration: float = 0.0) -> void:\n\tif actor.is_empty():\n\t\treturn\n\tvar stats: Dictionary = actor.get(\"stats\", {})\n\tvar defense := float(stats.get(\"defense\", 0.0))\n\tvar final_damage: float = max(1.0, damage - defense)\n\tvar current_hp := float(stats.get(\"hp\", stats.get(\"maxHp\", 1.0)))\n\tcurrent_hp = max(0.0, current_hp - final_damage)\n\tstats[\"hp\"] = current_hp\n\tactor[\"stats\"] = stats\n\tif freeze_duration > 0.0:\n\t\tactor[\"freezeTimer\"] = max(float(actor.get(\"freezeTimer\", 0.0)), freeze_duration)\n\t_show_status_popup(_actor_position(actor) + Vector2(-12, -24), \"%s -%d\" % [label, int(ceil(final_damage))], color)\n\tif current_hp <= 0.0:\n\t\t_kill_actor(actor)\n\telse:\n\t\t_show_actor_hp_bar(actor)\n\nfunc _show_laser_beam(from_pos: Vector2, to_pos: Vector2, color: Color) -> void:\n\tvar beam := Line2D.new()\n\tbeam.name = \"AllyLaserBeam\"\n\tbeam.z_index = 29\n\tbeam.width = 3.0\n\tbeam.default_color = color\n\tbeam.points = PackedVector2Array([from_pos, to_pos])\n\tmap_root.add_child(beam)\n\tvar tween := create_tween()\n\ttween.tween_property(beam, \"modulate:a\", 0.0, 0.14)\n\ttween.tween_callback(beam.queue_free)\n\nfunc _find_actor_in_facing_direction(max_range: float, half_width: float) -> Dictionary:\n\tif player == null:\n\t\treturn {}\n\tvar origin: Vector2 = player.global_position\n\tvar direction := _facing_vector()\n\tvar best: Dictionary = {}\n\tvar best_forward := INF\n\tfor npc in active_npcs:\n\t\tif typeof(npc) != TYPE_DICTIONARY:\n\t\t\tcontinue\n\t\tvar target_pos: Vector2 = _actor_position(npc)\n\t\tvar offset: Vector2 = target_pos - origin\n\t\tvar forward: float = offset.dot(direction)\n\t\tif forward < 0.0 or forward > max_range:\n\t\t\tcontinue\n\t\tvar lateral: float = abs(offset.cross(direction))\n\t\tif lateral <= half_width and forward < best_forward:\n\t\t\tbest = npc\n\t\t\tbest_forward = forward\n\treturn best\n\nfunc _find_actor_near_line(from_pos: Vector2, to_pos: Vector2, half_width: float) -> Dictionary:\n\tvar segment: Vector2 = to_pos - from_pos\n\tvar length_sq: float = segment.length_squared()\n\tif length_sq <= 0.01:\n\t\treturn {}\n\tfor npc in active_npcs:\n\t\tif typeof(npc) != TYPE_DICTIONARY:\n\t\t\tcontinue\n\t\tvar target_pos: Vector2 = _actor_position(npc)\n\t\tvar t: float = clamp((target_pos - from_pos).dot(segment) / length_sq, 0.0, 1.0)\n\t\tvar closest: Vector2 = from_pos + segment * t\n\t\tif closest.distance_to(target_pos) <= half_width:\n\t\t\treturn npc\n\treturn {}\n\nfunc _find_enemy_actor_near_line(from_pos: Vector2, to_pos: Vector2, half_width: float) -> Dictionary:\n\tvar segment: Vector2 = to_pos - from_pos\n\tvar length_sq: float = segment.length_squared()\n\tif length_sq <= 0.01:\n\t\treturn {}\n\tfor npc in active_npcs:\n\t\tif typeof(npc) != TYPE_DICTIONARY or not _is_actor_alive(npc):\n\t\t\tcontinue\n\t\tif String(npc.get(\"gameType\", \"\")) != \"enemy\" and String(npc.get(\"behavior\", \"\")) != \"hostile_ai\":\n\t\t\tcontinue\n\t\tvar target_pos: Vector2 = _actor_position(npc)\n\t\tvar t: float = clamp((target_pos - from_pos).dot(segment) / length_sq, 0.0, 1.0)\n\t\tvar closest: Vector2 = from_pos + segment * t\n\t\tif closest.distance_to(target_pos) <= half_width:\n\t\t\treturn npc\n\treturn {}\n\nfunc _actor_position(actor: Dictionary) -> Vector2:\n\tvar body: CharacterBody2D = actor.get(\"body\", null)\n\tif body != null and is_instance_valid(body):\n\t\treturn body.global_position\n\tvar node: Node2D = actor.get(\"node\", null)\n\tif node != null and is_instance_valid(node):\n\t\treturn node.global_position\n\treturn actor.get(\"position\", Vector2.ZERO)\n\nfunc _apply_damage_to_actor(actor: Dictionary, skill_id: String) -> void:\n\tif match_result != \"\":\n\t\treturn\n\tvar stats: Dictionary = actor.get(\"stats\", {})\n\tvar skill := _skill_template(skill_id)\n\tvar attacker_attack := float(player_stats.get(\"attack\", 10.0))\n\tvar damage_scale := float(skill.get(\"damageScale\", 1.0))\n\tvar defense := float(stats.get(\"defense\", 0.0))\n\tvar damage: float = max(1.0, attacker_attack * damage_scale - defense)\n\tvar current_hp := float(stats.get(\"hp\", stats.get(\"maxHp\", 1.0)))\n\tcurrent_hp = max(0.0, current_hp - damage)\n\tstats[\"hp\"] = current_hp\n\tactor[\"stats\"] = stats\n\t_hit_actor(actor, \"-%d\" % int(ceil(damage)))\n\tif player != null and String(actor.get(\"gameType\", \"\")) != \"destructible_object\":\n\t\t_trigger_npc_flee(actor, player.global_position)\n\tif current_hp <= 0.0:\n\t\t_kill_actor(actor)\n\telse:\n\t\t_show_actor_hp_bar(actor)\n\t_check_match_outcome()\n\nfunc _kill_actor(actor: Dictionary) -> void:\n\tvar death_behavior := String(Dictionary(actor.get(\"stats\", {})).get(\"deathBehavior\", \"disappear\"))\n\tvar body: Node = actor.get(\"body\", null)\n\tvar node: Node = actor.get(\"node\", null)\n\tvar death_position := _actor_position(actor)\n\tif String(actor.get(\"gameType\", \"\")) == \"destructible_object\":\n\t\t_grant_destructible_drop(actor, death_position)\n\tif death_behavior == \"disabled\":\n\t\tactor[\"pauseTimer\"] = 999.0\n\t\tactor[\"interactable\"] = false\n\t\tif node != null and is_instance_valid(node):\n\t\t\t(node as CanvasItem).modulate = Color(0.45, 0.45, 0.45)\n\t\t_show_status_popup(death_position + Vector2(0, -20), \"Down\", Color(0.9, 0.9, 0.9))\n\t\t_check_match_outcome()\n\t\treturn\n\t_remove_active_actor(actor)\n\tif body != null and is_instance_valid(body):\n\t\tbody.queue_free()\n\tif node != null and is_instance_valid(node) and (body == null or node.get_parent() != body):\n\t\tnode.queue_free()\n\t_show_status_popup(death_position + Vector2(0, -20), \"Defeated\", Color(1.0, 0.82, 0.45))\n\t_check_match_outcome()\n\nfunc _remove_active_actor(actor: Dictionary) -> void:\n\tif actor.has(\"blockedCell\"):\n\t\tvar blocked_cell = actor.get(\"blockedCell\")\n\t\tif typeof(blocked_cell) == TYPE_VECTOR2I:\n\t\t\tactive_blocked_cells.erase(blocked_cell)\n\tvar uid := int(actor.get(\"uid\", -1))\n\tfor i in range(active_npcs.size() - 1, -1, -1):\n\t\tvar other = active_npcs[i]\n\t\tif typeof(other) != TYPE_DICTIONARY:\n\t\t\tcontinue\n\t\tif uid >= 0 and int(other.get(\"uid\", -2)) == uid:\n\t\t\tactive_npcs.remove_at(i)\n\t\t\treturn\n\tactive_npcs.erase(actor)\n\nfunc _alive_friendly_npc_count() -> int:\n\tvar count := 0\n\tfor npc in active_npcs:\n\t\tif typeof(npc) != TYPE_DICTIONARY:\n\t\t\tcontinue\n\t\tif String(npc.get(\"gameType\", \"\")) == \"enemy\":\n\t\t\tcontinue\n\t\tif String(npc.get(\"gameType\", \"\")) == \"destructible_object\":\n\t\t\tcontinue\n"}}
