red_size.x / source_size.x, desired_size.y / source_size.y)\n\tmap_root.add_child(sprite)\n\tif blocked:\n\t\t_block_rect_cells(Rect2i(origin, footprint))\n\nfunc _build_editor_json_map() -> void:\n\tvar map_data := _json_dict(EDITOR_MAP_JSON)\n\tvar godot_map := _browser_editor_map_dict()\n\tvar runtime_data = current_map.get(\"runtime_data\", {})\n\tif typeof(runtime_data) == TYPE_DICTIONARY:\n\t\tgodot_map = runtime_data\n\tif godot_map.is_empty():\n\t\tgodot_map = _json_dict(GODOT_EDITOR_MAP_JSON)\n\tvar manifest := _json_dict(KENNEY_MAP_MANIFEST_JSON)\n\tvar game_rules := game_rules_cache\n\tif map_data.is_empty() and godot_map.is_empty():\n\t\treturn\n\tif manifest.is_empty():\n\t\treturn\n\n\tvar size_source := godot_map if not godot_map.is_empty() else map_data\n\tactive_map_w = max(1, int(size_source.get(\"cols\", MAP_W)))\n\tactive_map_h = max(1, int(size_source.get(\"rows\", MAP_H)))\n\tactive_cell_px = max(TILE, int(size_source.get(\"cell\", TILE)))\n\n\tvar asset_lookup: Dictionary = {}\n\tfor item in manifest.get(\"assets\", []):\n\t\tif typeof(item) == TYPE_DICTIONARY and item.has(\"id\"):\n\t\t\tasset_lookup[String(item.id)] = item\n\n\tif _is_world_overview_mode():\n\t\t_add_world_overview_background(godot_map)\n\t\t_add_world_overview_markers(godot_map)\n\t\t_border_editor_visible()\n\t\treturn\n\n\tvar editor_background_color := _editor_map_background_color(size_source)\n\t_add_editor_background_fill(editor_background_color)\n\tif not _editor_map_has_custom_background(size_source):\n\t\tfor fill_y in active_map_h:\n\t\t\tfor fill_x in active_map_w:\n\t\t\t\t_stamp_editor_asset(EDITOR_GROUND_ASSET_ID, asset_lookup, Vector2i(fill_x, fill_y), Vector2i(1, 1), false, -1)\n\n\tvar terrain_rows: Array = godot_map.get(\"terrain\", []) if not godot_map.is_empty() else map_data.get(\"terrain\", [])\n\tfor y in range(terrain_rows.size()):\n\t\tvar row = terrain_rows[y]\n\t\tif typeof(row) != TYPE_ARRAY:\n\t\t\tcontinue\n\t\tfor x in range(row.size()):\n\t\t\tvar cell = row[x]\n\t\t\tvar asset_id := _terrain_cell_asset_id(cell)\n\t\t\tvar cell_pos := Vector2i(x, y)\n\t\t\tif asset_id != \"\" and asset_id != EDITOR_GROUND_ASSET_ID:\n\t\t\t\t_stamp_editor_asset(asset_id, asset_lookup, cell_pos, Vector2i(1, 1), false, 0)\n\t\t\tif _terrain_cell_blocks(cell, asset_id):\n\t\t\t\t_block_cell_only(cell_pos)\n\n\tif godot_map.is_empty():\n\t\tfor stamp in map_data.get(\"stamps\", []):\n\t\t\tif typeof(stamp) != TYPE_DICTIONARY:\n\t\t\t\tcontinue\n\t\t\tvar asset_id := String(stamp.get(\"assetId\", \"\"))\n\t\t\tvar texture_path := _editor_stamp_texture_path(stamp, asset_lookup)\n\t\t\tvar origin := Vector2(float(stamp.get(\"x\", 0)), float(stamp.get(\"y\", 0)))\n\t\t\tvar footprint := Vector2(max(1.0, float(stamp.get(\"w\", 1))), max(1.0, float(stamp.get(\"h\", 1))))\n\t\t\tvar rule := _asset_game_rule(asset_id, game_rules)\n\t\t\tif _is_world_runtime_map() and _is_hostile_rule(rule):\n\t\t\t\tcontinue\n\t\t\t_apply_asset_game_rule(rule, origin)\n\t\t\tif String(rule.get(\"gameType\", \"\")) == \"enemy\":\n\t\t\t\tcontinue\n\t\t\tvar blocks := _asset_rule_blocks(rule, bool(stamp.get(\"blocking\", true)))\n\t\t\tif String(rule.get(\"gameType\", \"\")) == \"movable_npc\":\n\t\t\t\tblocks = false\n\t\t\tvar destructible := _is_destructible_editor_object(asset_id, rule)\n\t\t\tvar render_blocks := false if destructible else blocks\n\t\t\tvar stamp_node: Sprite2D = null\n\t\t\tif texture_path != \"\":\n\t\t\t\tstamp_node = _stamp_editor_texture(texture_path, origin, footprint, render_blocks, 6, \"EditorStamp\")\n\t\t\telse:\n\t\t\t\tstamp_node = _stamp_editor_asset(asset_id, asset_lookup, Vector2i(int(origin.x), int(origin.y)), Vector2i(int(ceil(footprint.x)), int(ceil(footprint.y))), render_blocks, 6)\n\t\t\t_register_rule_npc(rule, asset_id, origin, footprint, game_rules, stamp_node)\n\t\t\t_register_rule_pickup(rule, asset_id, origin, footprint, stamp_node)\n\t\t\t_register_destructible_object(asset_id, origin, footprint, rule, stamp_node)\n\telse:\n\t\tfor object in godot_map.get(\"objects\", []):\n\t\t\tif typeof(object) != TYPE_DICTIONARY:\n\t\t\t\tcontinue\n\t\t\tvar texture_path := String(object.get(\"texture\", \"\"))\n\t\t\tif texture_path == \"\":\n\t\t\t\tcontinue\n\t\t\tvar origin := Vector2(float(object.get(\"x\", 0)), float(object.get(\"y\", 0)))\n\t\t\tvar footprint := Vector2(max(1.0, float(object.get(\"w\", 1))), max(1.0, float(object.get(\"h\", 1))))\n\t\t\tvar asset_id := String(object.get(\"assetId\", \"\"))\n\t\t\tvar rule := _asset_game_rule(asset_id, game_rules)\n\t\t\tif _is_world_runtime_map() and _is_hostile_rule(rule):\n\t\t\t\tcontinue\n\t\t\t_apply_asset_game_rule(rule, origin)\n\t\t\tif String(rule.get(\"gameType\", \"\")) == \"enemy\":\n\t\t\t\tcontinue\n\t\t\tvar blocks := _asset_rule_blocks(rule, bool(object.get(\"blocking\", true)))\n\t\t\tif String(rule.get(\"gameType\", \"\")) == \"movable_npc\":\n\t\t\t\tblocks = false\n\t\t\tvar destructible := _is_destructible_editor_object(asset_id, rule)\n\t\t\tvar render_blocks := false if destructible else blocks\n\t\t\tvar object_node := _stamp_editor_texture(texture_path, origin, footprint, render_blocks, int(object.get(\"z\", 6)), \"GodotMapObject\")\n\t\t\t_register_rule_npc(rule, asset_id, origin, footprint, game_rules, object_node)\n\t\t\t_register_rule_pickup(rule, asset_id, origin, footprint, object_node)\n\t\t\t_register_destructible_object(asset_id, origin, footprint, rule, object_node)\n\n\t_border_editor_visible()\n\nfunc _editor_map_has_custom_background(map_data: Dictionary) -> bool:\n\tvar background = map_data.get(\"background\", {})\n\treturn typeof(background) == TYPE_DICTIONARY and String(background.get(\"color\", \"\")) != \"\"\n\nfunc _editor_map_background_color(map_data: Dictionary) -> Color:\n\tvar background = map_data.get(\"background\", {})\n\tif typeof(background) != TYPE_DICTIONARY:\n\t\treturn Color(\"#79bf63\")\n\treturn _parse_editor_color(String(background.get(\"color\", \"#79bf63\")), Color(\"#79bf63\"))\n\nfunc _parse_editor_color(value: String, fallback: Color) -> Color:\n\tvar text := value.strip_edges().to_lower()\n\tif text == \"\":\n\t\treturn fallback\n\tif text.begins_with(\"#\"):\n\t\treturn Color(text)\n\tif text.begins_with(\"rgb\"):\n\t\tvar open_index := text.find(\"(\")\n\t\tvar close_index := text.find(\")\")\n\t\tif open_index >= 0 and close_index > open_index:\n\t\t\tvar parts := text.substr(open_index + 1, close_index - open_index - 1).split(\",\")\n\t\t\tif parts.size() >= 3:\n\t\t\t\tvar red := clampf(float(String(parts[0]).strip_edges()) / 255.0, 0.0, 1.0)\n\t\t\t\tvar green := clampf(float(String(parts[1]).strip_edges()) / 255.0, 0.0, 1.0)\n\t\t\t\tvar blue := clampf(float(String(parts[2]).strip_edges()) / 255.0, 0.0, 1.0)\n\t\t\t\tvar alpha := 1.0\n\t\t\t\tif parts.size() >= 4:\n\t\t\t\t\talpha = clampf(float(String(parts[3]).strip_edges()), 0.0, 1.0)\n\t\t\t\treturn Color(red, green, blue, alpha)\n\treturn fallback\n\nfunc _add_editor_background_fill(color: Color) -> void:\n\tvar fill := ColorRect.new()\n\tfill.name = \"EditorBackgroundColor\"\n\tfill.position = Vector2.ZERO\n\tfill.size = Vector2(active_map_w * active_cell_px, active_map_h * active_cell_px)\n\tfill.color = color\n\tfill.z_index = -20\n\tmap_root.add_child(fill)\n\nfunc _browser_editor_map_dict() -> Dictionary:\n\tif not OS.has_feature(\"web\"):\n\t\treturn {}\n\tvar raw = JavaScriptBridge.eval(\"(function(){try{var h=location.hash||'';if(h.indexOf('#map=')===0){return decodeURIComponent(h.slice(5));}return window.__GAMEGMETA_BOOT_EDITOR_MAP__ || localStorage.getItem('%s') || window.name || '';}catch(e){try{return window.__GAMEGMETA_BOOT_EDITOR_MAP__ || window.name || '';}catch(_e){return '';}}})()\" % BROWSER_EDITOR_MAP_STORAGE_KEY, true)\n\tif typeof(raw) != TYPE_STRING:\n\t\treturn {}\n\tvar raw_text := String(raw)\n\tif raw_text == \"\":\n\t\treturn {}\n\tvar parsed = JSON.parse_string(raw_text)\n\tif typeof(parsed) != TYPE_DICTIONARY:\n\t\treturn {}\n\treturn parsed\n\nfunc _terrain_cell_asset_id(cell) -> String:\n\tif typeof(cell) == TYPE_DICTIONARY:\n\t\treturn String(cell.get(\"assetId\", \"\"))\n\treturn String(cell)\n\nfunc _terrain_cell_blocks(cell, asset_id: String) -> bool:\n\tif typeof(cell) == TYPE_DICTIONARY and bool(cell.get(\"blocking\", false)):\n\t\treturn true\n\tif _is_editor_blocking_terrain_asset(asset_id):\n\t\treturn true\n\treturn not _is_editor_walkable_terrain(asset_id)\n\nfunc _is_editor_walkable_terrain(asset_id: String) -> bool:\n\tif _is_editor_water_asset(asset_id):\n\t\treturn false\n\tif _is_editor_blocking_terrain_asset(asset_id):\n\t\treturn false\n\tif _is_editor_base_ground_or_road(asset_id):\n\t\treturn true\n\tmatch asset_id:\n\t\t\"tiny-town/Tiles/tile_0000\", \\\n\t\t\"tiny-town/Tiles/tile_0001\", \\\n\t\t\"tiny-town/Tiles/tile_0002\", \\\n\t\t\"tiny-town/Tiles/tile_0012\", \\\n\t\t\"tiny-town/Tiles/tile_0013\", \\\n\t\t\"tiny-town/Tiles/tile_0014\", \\\n"}}
{"timestamp":"2026-06-02T13:12:56.421Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_vFU0jPVbSAZleRfaTlWWiHO6","output":"Chunk ID: fee9fa\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 651\nOutput:\n  try {\n    pendingId = localStorage.getItem(PENDING_EDITOR_MAP_KEY) || \"\";\n    if (pendingId) localStorage.removeItem(PENDING_EDITOR_MAP_KEY);\n  } catch (_error) {\n    pendingId = \"\";\n  }\n  if (!pendingId) return false;\n  const record = savedMaps().find((item) => item.id === pendingId);\n  if (!record) return false;\n  applyMapData(record.data, record.name);\n  renderSavedMaps(record.id);\n  statusText.textContent = `Opened \"${record.name}\" from the world map. Click Enter Game to launch the current map.`;\n  return true;\n}\n\nfunction deleteSavedMap() {\n  const id = savedMapSelect.value;\n  const record = savedMaps().find((item) => item.id === id);\n  if (!record) {\n    statusText.textContent = \"No saved map is available to delete.\";\n    return;\n  }\n  const maps = savedMaps().filter((item) => item.id !== id);\n  if (!writeSavedMaps(maps)) {\n    statusText.textContent = \"Delete failed: this browser cannot write local storage.\";\n    return;\n  }\n  renderSavedMaps();\n  statusText.textContent = `Deleted saved map \"${record.name}\".`;\n}\n\nfunction stampTexturePath(stamp) {\n  const asset = assetById(stamp.assetId);\n  return asset?.file ? `res://${asset.file}` : \"\";\n}\n\nfunction godotMapDataFromEditorMap(editorMap) {\n  const groundId = defaultTile()?.id || GROUND_ASSET_ID;\n  const rows = Number(editorMap?.rows) || ROWS;\n  const cols = Number(editorMap?.cols) || COLS;\n  const sourceTerrain = Array.isArray(editorMap?.terrain) ? editorMap.terrain : [];\n  return {\n    format: \"GameGmetaGodotMap\",\n    version: 1,\n    cols,\n    rows,\n    cell: CELL,\n    background: { ...mapBackground },\n    terrain: Array.from({ length: rows }, (_, y) => Array.from({ length: cols }, (_, x) => {\n      const sourceId = normalizeTerrainCell(sourceTerrain[y]?.[x]) || groundId;\n      const asset = assetById(sourceId) || assetById(groundId);\n      const assetId = asset?.id || groundId;\n      return {\n        assetId,\n        tileNo: assetTileNo(assetId),\n        texture: asset?.file ? `res://${asset.file}` : \"\",\n        blocking: isBlockingTerrainAsset(asset) || !isBaseTerrainAsset(asset),\n      };\n    })),\n    objects: (editorMap?.stamps || []).filter((stamp) => !isBaseTerrainAsset(assetById(stamp.assetId))).map((stamp) => ({\n      id: stamp.id,\n      assetId: stamp.assetId || null,\n      tileNo: stamp.tileNo || assetTileNo(stamp.assetId),\n      texture: stampTexturePath(stamp),\n      x: stamp.x,\n      y: stamp.y,\n      w: stamp.w,\n      h: stamp.h,\n      blocking: Boolean(stamp.blocking),\n      z: 6,\n    })),\n  };\n}\n\nfunction godotMapData() {\n  return godotMapDataFromEditorMap(currentEditorMapData());\n"}}
