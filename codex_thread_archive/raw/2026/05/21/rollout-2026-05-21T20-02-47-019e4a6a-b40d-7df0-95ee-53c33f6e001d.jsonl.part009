2(randf_range(margin, max(margin, active_map_w * active_cell_px - margin)), active_map_h * active_cell_px - margin)\n\treturn Vector2(margin, randf_range(margin, max(margin, active_map_h * active_cell_px - margin)))\n\nfunc _update_story_npc_abilities(delta: float) -> void:\n\tif not _story_events_enabled_for_current_map() or player == null or match_result != \"\":\n\t\treturn\n\tfor npc in active_npcs.duplicate():\n\t\tif typeof(npc) != TYPE_DICTIONARY or not _is_actor_alive(npc):\n\t\t\tcontinue\n\t\tvar behavior := String(npc.get(\"behavior\", \"\"))\n\t\tif behavior == \"ally_laser_guard\":\n\t\t\t_update_ally_guard(npc, delta)\n\t\t\tcontinue\n\t\tif behavior == \"defense_tower_ai\":\n\t\t\t_update_defense_tower(npc, delta)\n\t\t\tcontinue\n\t\tvar ability_id := String(npc.get(\"abilityId\", \"\"))\n\t\tif ability_id == \"\":\n\t\t\tcontinue\n\t\tvar timer: float = max(0.0, float(npc.get(\"abilityTimer\", 0.0)) - delta)\n\t\tnpc[\"abilityTimer\"] = timer\n\t\tmatch ability_id:\n\t\t\tSTORY_ABILITY_NOAH_WARNING:\n\t\t\t\t_update_noah_warning(npc, timer)\n\t\t\tSTORY_ABILITY_WENWEN_GUARD:\n\t\t\t\tif timer <= 0.0:\n\t\t\t\t\t_spawn_wenwen_guard(npc)\n\t\t\t\t\tnpc[\"abilityTimer\"] = LILY_GUARD_SUMMON_INTERVAL\n\t\t\tSTORY_ABILITY_LINA_POTIONS:\n\t\t\t\tif timer <= 0.0:\n\t\t\t\t\t_lina_heal_injured_npc(npc)\n\t\t\t\t\tnpc[\"abilityTimer\"] = LINA_HEAL_INTERVAL\n\t\t\tSTORY_ABILITY_MIRA_FREEZE:\n\t\t\t\tif timer <= 0.0:\n\t\t\t\t\tif _mira_freeze_attack(npc):\n\t\t\t\t\t\tnpc[\"abilityTimer\"] = MIRA_FREEZE_COOLDOWN\n\t\t\t\t\telse:\n\t\t\t\t\t\tnpc[\"abilityTimer\"] = 0.45\n\t\t\tSTORY_ABILITY_THORN_TOWER:\n\t\t\t\tif timer <= 0.0:\n\t\t\t\t\t_spawn_thorn_tower(npc)\n\t\t\t\t\tnpc[\"abilityTimer\"] = THORN_TOWER_BUILD_INTERVAL\n\nfunc _update_noah_warning(npc: Dictionary, timer: float) -> void:\n\tif day_night_phase != \"night\" or timer > 0.0:\n\t\treturn\n\tvar enemy_count := _alive_enemy_count()\n\tif enemy_count > 0:\n\t\t_show_status_popup(_actor_position(npc) + Vector2(-20, -36), \"Noah: %d monsters\" % enemy_count, Color(1.0, 0.92, 0.44))\n\tnpc[\"abilityTimer\"] = NOAH_WARNING_INTERVAL\n\nfunc _spawn_wenwen_guard(owner: Dictionary) -> void:\n\tif _count_active_actors_by_behavior(\"ally_laser_guard\") >= LILY_GUARD_MAX_COUNT:\n\t\treturn\n\tvar owner_pos := _actor_position(owner)\n\tvar spawn_pos := _find_nearby_open_position(owner_pos, active_cell_px * 1.15)\n\tvar sprite := Sprite2D.new()\n\tsprite.name = \"WenwenLaserGuard\"\n\tsprite.centered = true\n\tsprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n\tsprite.z_index = 22\n\tsprite.scale = Vector2(PLAYER_VISUAL_SCALE, PLAYER_VISUAL_SCALE)\n\tvar texture_path := _asset_id_texture_path(WENWEN_GUARD_ASSET_ID)\n\tif texture_path != \"\":\n\t\tsprite.texture = _texture(texture_path)\n\tmap_root.add_child(sprite)\n\tvar body := _create_movable_npc_body(sprite, spawn_pos, Vector2.ZERO)\n\tactive_npc_serial += 1\n\tvar guard_uid := active_npc_serial\n\tactive_npcs.append({\n\t\t\"uid\": guard_uid,\n\t\t\"assetId\": WENWEN_GUARD_ASSET_ID,\n\t\t\"npcId\": \"wenwen_laser_guard\",\n\t\t\"displayName\": \"Lily Guard\",\n\t\t\"gameType\": \"ally_guard\",\n\t\t\"behavior\": \"ally_laser_guard\",\n\t\t\"interactable\": false,\n\t\t\"position\": spawn_pos,\n\t\t\"interactionRadius\": 0.0,\n\t\t\"ai\": {\"range\": WENWEN_GUARD_RANGE, \"attackCooldown\": WENWEN_GUARD_COOLDOWN},\n\t\t\"stats\": {\"maxHp\": 75.0, \"hp\": 75.0, \"attack\": WENWEN_GUARD_DAMAGE, \"defense\": 1.0, \"deathBehavior\": \"disappear\"},\n\t\t\"home\": spawn_pos,\n\t\t\"target\": spawn_pos,\n\t\t\"path\": [],\n\t\t\"pauseTimer\": 0.0,\n\t\t\"attackTimer\": randf_range(0.2, 0.8),\n\t\t\"node\": sprite,\n\t\t\"body\": body,\n\t\t\"nodeOffset\": Vector2.ZERO,\n\t\t\"framePaths\": {},\n\t\t\"facing\": \"down\",\n\t\t\"animFrame\": 0,\n\t\t\"animTime\": 0.0,\n\t})\n\towner[\"guardUid\"] = guard_uid\n\t_show_summon_effect(spawn_pos)\n\t_show_status_popup(spawn_pos + Vector2(-20, -32), \"Guard summoned\", Color(0.34, 1.0, 0.35))\n\nfunc _update_ally_guard(guard: Dictionary, delta: float) -> void:\n\tvar body: CharacterBody2D = guard.get(\"body\", null)\n\tif body == null or not is_instance_valid(body):\n\t\treturn\n\tbody.velocity = Vector2.ZERO\n\tguard[\"position\"] = body.position\n\tvar attack_timer: float = max(0.0, float(guard.get(\"attackTimer\", 0.0)) - delta)\n\tguard[\"attackTimer\"] = attack_timer\n\tif attack_timer > 0.0:\n\t\treturn\n\tvar target := _nearest_enemy_actor(body.position, WENWEN_GUARD_RANGE, true)\n\tif target.is_empty():\n\t\tguard[\"attackTimer\"] = 0.25\n\t\treturn\n\tvar target_pos := _actor_position(target)\n\t_play_guard_attack_frame(guard)\n\t_show_laser_beam(body.position, target_pos, Color(0.18, 1.0, 0.28, 0.96))\n\t_apply_direct_damage_to_actor(target, WENWEN_GUARD_DAMAGE, \"Laser\", Color(0.42, 1.0, 0.35))\n\tguard[\"attackTimer\"] = WENWEN_GUARD_COOLDOWN\n\nfunc _play_guard_attack_frame(guard: Dictionary) -> void:\n\tvar node: Sprite2D = guard.get(\"node\", null)\n\tif node == null or not is_instance_valid(node):\n\t\treturn\n\tvar attack_path := _asset_id_texture_path(WENWEN_GUARD_ATTACK_ASSET_ID)\n\tvar idle_path := _asset_id_texture_path(WENWEN_GUARD_ASSET_ID)\n\tif attack_path != \"\":\n\t\tnode.texture = _texture(attack_path)\n\tvar tween := create_tween()\n\ttween.tween_interval(0.18)\n\ttween.tween_callback(func() -> void:\n\t\tif node != null and is_instance_valid(node) and idle_path != \"\":\n\t\t\tnode.texture = _texture(idle_path)\n\t)\n\nfunc _mira_freeze_attack(npc: Dictionary) -> bool:\n\tvar origin := _actor_position(npc)\n\tvar target := _nearest_enemy_actor(origin, MIRA_FREEZE_RANGE, true)\n\tif target.is_empty():\n\t\treturn false\n\tvar target_pos := _actor_position(target)\n\t_show_laser_beam(origin, target_pos, Color(0.54, 0.88, 1.0, 0.92))\n\t_apply_direct_damage_to_actor(target, MIRA_FREEZE_DAMAGE, \"Freeze\", Color(0.62, 0.9, 1.0), MIRA_FREEZE_DURATION)\n\treturn true\n\nfunc _lina_heal_injured_npc(npc: Di