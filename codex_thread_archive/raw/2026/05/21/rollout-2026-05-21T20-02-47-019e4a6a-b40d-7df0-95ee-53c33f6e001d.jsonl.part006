{"timestamp":"2026-05-31T07:39:18.292Z","type":"response_item","payload":{"type":"custom_tool_call","status":"completed","call_id":"call_4W581NkkKOHdoZAmO4bN7AML","name":"apply_patch","input":"*** Begin Patch\n*** Update File: /Users/vincet/Documents/aiglass/GameGmeta/scripts/main.gd\n@@\n func _register_rule_pickup(rule: Dictionary, asset_id: String, origin: Vector2, footprint: Vector2, visual_node: Sprite2D) -> void:\n \tif rule.is_empty() or String(rule.get(\"gameType\", \"\")) != \"hp_potion\":\n \t\treturn\n@@\n \t\t\"node\": visual_node,\n \t})\n \n+func _reset_story_events() -> void:\n+\tstory_world_state = {\n+\t\t\"storyStage\": 0,\n+\t\t\"enemyPressure\": 0,\n+\t\t\"trust\": 0,\n+\t\t\"npcSurvival\": 0,\n+\t\t\"reputation\": 0,\n+\t\t\"eventMemory\": [],\n+\t}\n+\tstory_event_index = 0\n+\tstory_event_timer = STORY_EVENT_START_DELAY\n+\tactive_story_event = {}\n+\tactive_story_npc_uid = -1\n+\tstory_choice_open = false\n+\n+func _story_event_pool() -> Array:\n+\treturn [\n+\t\t{\n+\t\t\t\"id\": \"lina_herbalist\",\n+\t\t\t\"npcDefinition\": \"urban_walker_003\",\n+\t\t\t\"displayName\": \"Lina\",\n+\t\t\t\"acceptedLine\": \"Thank you. I will stay nearby and help with herbs when I can.\",\n+\t\t\t\"rejectedLine\": \"I understand. I will try another road before night falls.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"Are you the one protecting this place?\",\n+\t\t\t\t\"The forest is no longer safe. Monsters burned my herb hut.\",\n+\t\t\t\t\"I can identify healing plants and care for wounded people.\",\n+\t\t\t\t\"Please let me stay. I will not be a burden.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"trust\": 1, \"npcSurvival\": 1},\n+\t\t\t\"rejectState\": {\"trust\": -1, \"enemyPressure\": 1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"noah_disaster_warning\",\n+\t\t\t\"npcDefinition\": \"urban_walker_002\",\n+\t\t\t\"displayName\": \"Noah\",\n+\t\t\t\"acceptedLine\": \"I will keep sorting every warning that reaches us.\",\n+\t\t\t\"rejectedLine\": \"Then I have to carry this warning somewhere else.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"I finally found a place with lights still on.\",\n+\t\t\t\t\"I ran from the east. Villages along the road are evacuating.\",\n+\t\t\t\t\"This letter is not ordinary mail. It is a disaster warning.\",\n+\t\t\t\t\"It says the ground is shaking, rivers are turning dark, and animals are fleeing.\",\n+\t\t\t\t\"If that is true, this place may be next.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"storyStage\": 1, \"trust\": 1, \"reputation\": 1},\n+\t\t\t\"rejectState\": {\"storyStage\": 0, \"trust\": -1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"wenwen_archaeologist\",\n+\t\t\t\"npcDefinition\": \"urban_walker_001\",\n+\t\t\t\"displayName\": \"Wenwen\",\n+\t\t\t\"acceptedLine\": \"I will decode the stones and look for the monster's weakness.\",\n+\t\t\t\"rejectedLine\": \"Without the records, you may meet it without warning.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"Do not attack. I am an archaeologist, not an enemy.\",\n+\t\t\t\t\"In the ruins I found one name carved again and again.\",\n+\t\t\t\t\"The ancients called it the Sun Eater, a super monster strong enough to break the continent.\",\n+\t\t\t\t\"The smaller monsters may be answering its awakening.\",\n+\t\t\t\t\"Let me stay. I can keep reading the stones and search for its weakness.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"storyStage\": 1, \"trust\": 1, \"reputation\": 1},\n+\t\t\t\"rejectState\": {\"enemyPressure\": 1, \"trust\": -1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"marlo_merchant\",\n+\t\t\t\"npcDefinition\": \"urban_walker_004\",\n+\t\t\t\"displayName\": \"Marlo\",\n+\t\t\t\"acceptedLine\": \"I will repair crates and mark supplies when I find them.\",\n+\t\t\t\"rejectedLine\": \"Then I will keep moving before the road closes behind me.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"I am not here to sell anything. Not today.\",\n+\t\t\t\t\"My caravan was attacked. Goods, carts, friends, all gone.\",\n+\t\t\t\t\"Noah was right about the roads. The north route is broken.\",\n+\t\t\t\t\"I can repair boxes and remember where supplies might be hidden.\",\n+\t\t\t\t\"Let me stay and I will repay you with what I have left.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"reputation\": 1, \"trust\": 1, \"npcSurvival\": 1},\n+\t\t\t\"rejectState\": {\"reputation\": -1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"kyle_guard\",\n+\t\t\t\"npcDefinition\": \"urban_walker_006\",\n+\t\t\t\"displayName\": \"Kyle\",\n+\t\t\t\"acceptedLine\": \"I will patrol here. If they come again, I will fight.\",\n+\t\t\t\"rejectedLine\": \"Then I will draw them away if I still can.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"Please let me in. Enemies are still behind me.\",\n+\t\t\t\t\"The outpost has fallen. These are not random monsters.\",\n+\t\t\t\t\"They move like an army, and something is commanding them.\",\n+\t\t\t\t\"If Wenwen is right, this is only the beginning.\",\n+\t\t\t\t\"Let me stay. I can help defend this place.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"npcSurvival\": 1, \"trust\": 1, \"storyStage\": 1},\n+\t\t\t\"rejectState\": {\"enemyPressure\": 1, \"reputation\": -1},\n+\t\t},\n+\t]\n+\n+func _update_story_event_system(delta: float) -> void:\n+\tif _is_world_overview_mode() or player == null or match_result != \"\":\n+\t\treturn\n+\tif story_choice_open:\n+\t\treturn\n+\tif not active_story_event.is_empty():\n+\t\t_update_active_story_npc(delta)\n+\t\treturn\n+\tif story_event_index >= _story_event_pool().size():\n+\t\treturn\n+\tstory_event_timer = max(0.0, story_event_timer - delta)\n+\tif story_event_timer <= 0.0:\n+\t\t_start_next_story_event()\n+\n+func _start_next_story_event() -> void:\n+\tvar events := _story_event_pool()\n+\tif story_event_index >= events.size():\n+\t\treturn\n+\tactive_story_event = events[story_event_index]\n+\tstory_event_index += 1\n+\tvar npc := _spawn_story_event_npc(active_story_event)\n+\tif npc.is_empty():\n+\t\tactive_story_event = {}\n+\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\t\treturn\n+\tactive_story_npc_uid = int(npc.get(\"uid\", -1))\n+\n+func _spawn_story_event_npc(event: Dictionary) -> Dictionary:\n+\tvar definitions: Dictionary = game_rules_cache.get(\"npcDefinitions\", {})\n+\tvar definition_id := String(event.get(\"npcDefinition\", \"\"))\n+\tif not definitions.has(definition_id):\n+\t\treturn {}\n+\tvar definition: Dictionary = definitions[definition_id]\n+\tvar spawn_cell := _random_story_edge_cell()\n+\tvar world_pos := _npc_cell_center(spawn_cell)\n+\tvar sprite := Sprite2D.new()\n+\tsprite.name = \"StoryVisitor_%s\" % String(event.get(\"id\", \"visitor\"))\n+\tsprite.centered = true\n+\tsprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n+\tsprite.z_index = 18\n+\tsprite.scale = Vector2(PLAYER_VISUAL_SCALE, PLAYER_VISUAL_SCALE)\n+\tvar texture_path := _asset_id_texture_path(String(definition.get(\"assetId\", \"\")))\n+\tif texture_path != \"\":\n+\t\tsprite.texture = _texture(texture_path)\n+\tmap_root.add_child(sprite)\n+\tvar body := _create_movable_npc_body(sprite, world_pos, Vector2.ZERO)\n+\tvar frame_paths := _npc_frame_paths(definition, game_rules_cache)\n+\tvar stats := _actor_template(String(definition.get(\"actorTemplate\", \"walker_npc\")))\n+\tstats[\"hp\"] = float(stats.get(\"hp\", stats.get(\"maxHp\", 60.0)))\n+\tactive_npc_serial += 1\n+\tvar npc := {\n+\t\t\"uid\": active_npc_serial,\n+\t\t\"assetId\": String(definition.get(\"assetId\", \"\")),\n+\t\t\"npcId\": definition_id,\n+\t\t\"displayName\": String(event.get(\"displayName\", definition.get(\"displayName\", \"NPC\"))),\n+\t\t\"gameType\": \"story_npc\",\n+\t\t\"storyEventId\": String(event.get(\"id\", \"\")),\n+\t\t\"lines\": event.get(\"lines\", []),\n+\t\t\"lineIndex\": 0,\n+\t\t\"position\": world_pos,\n+\t\t\"interactionRadius\": active_cell_px * 1.5,\n+\t\t\"behavior\": \"story_approach\",\n+\t\t\"ai\": definition.get(\"ai\", {}),\n+\t\t\"stats\": stats,\n+\t\t\"home\": world_pos,\n+\t\t\"target\": player.global_position,\n+\t\t\"path\": [],\n+\t\t\"pauseTimer\": 0.0,\n+\t\t\"fleeTimer\": 0.0,\n+\t\t\"fleeFrom\": world_pos,\n+\t\t\"helpSignalTimer\": 0.0,\n+\t\t\"repathTimer\": 0.0,\n+\t\t\"stuckTimer\": 0.0,\n+\t\t\"lastPosition\": world_pos,\n+\t\t\"moveTimer\": 0.0,\n+\t\t\"node\": sprite,\n+\t\t\"body\": body,\n+\t\t\"nodeOffset\": Vector2.ZERO,\n+\t\t\"framePaths\": frame_paths,\n+\t\t\"facing\": \"down\",\n+\t\t\"animFrame\": 0,\n+\t\t\"animTime\": 0.0,\n+\t\t\"interactable\": true,\n+\t}\n+\tactive_npcs.append(npc)\n+\treturn npc\n+\n+func _random_story_edge_cell() -> Vector2i:\n+\tvar candidates: Array[Vector2i] = []\n+\tfor x in range(active_map_w):\n+\t\tcandidates.append(Vector2i(x, 1))\n+\t\tcandidates.append(Vector2i(x, max(1, active_map_h - 2)))\n+\tfor y in range(active_map_h):\n+\t\tcandidates.append(Vector2i(1, y))\n+\t\tcandidates.append(Vector2i(max(1, active_map_w - 2), y))\n+\tcandidates.shuffle()\n+\tfor cell in candidates:\n+\t\tif _in_map(cell) and not active_blocked_cells.has(cell):\n+\t\t\treturn cell\n+\treturn Vector2i(1, 1)\n+\n+func _update_active_story_npc(delta: float) -> void:\n+\tvar npc := _story_npc_by_uid(active_story_npc_uid)\n+\tif npc.is_empty():\n+\t\tactive_story_event = {}\n+\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\t\treturn\n+\tvar behavior := String(npc.get(\"behavior\", \"\"))\n+\tif behavior == \"story_approach\":\n+\t\tvar body: CharacterBody2D = npc.get(\"body\", null)\n+\t\tif body == null or not is_instance_valid(body):\n+\t\t\treturn\n+\t\tvar target_pos := player.global_position\n+\t\tvar distance := body.position.distance_to(target_pos)\n+\t\tif distance <= STORY_EVENT_APPROACH_DISTANCE:\n+\t\t\tbody.velocity = Vector2.ZERO\n+\t\t\tnpc[\"position\"] = body.position\n+\t\t\t_face_npc_towards(npc, body.position.direction_to(player.global_position))\n+\t\t\t_show_story_choice(npc)\n+\t\t\treturn\n+\t\tvar direction := body.position.direction_to(target_pos)\n+\t\tbody.velocity = direction * STORY_EVENT_SPEED\n+\t\t_update_npc_animation(npc, direction, delta)\n+\t\tbody.move_and_slide()\n+\t\tnpc[\"position\"] = body.position\n+\telif behavior == \"story_exit\":\n+\t\tvar body: CharacterBody2D = npc.get(\"body\", null)\n+\t\tif body == null or not is_instance_valid(body):\n+\t\t\t_remove_story_npc(npc)\n+\t\t\treturn\n+\t\tvar exit_target: Vector2 = npc.get(\"exitTarget\", _nearest_story_exit(body.position))\n+\t\tif body.position.distance_to(exit_target) <= 8.0:\n+\t\t\t_remove_story_npc(npc)\n+\t\t\tactive_story_event = {}\n+\t\t\tactive_story_npc_uid = -1\n+\t\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\t\t\treturn\n+\t\tvar direction := body.position.direction_to(exit_target)\n+\t\tbody.velocity = direction * STORY_EVENT_SPEED\n+\t\t_update_npc_animation(npc, direction, delta)\n+\t\tbody.move_and_slide()\n+\t\tnpc[\"position\"] = body.position\n+\n+func _story_npc_by_uid(uid: int) -> Dictionary:\n+\tfor npc in active_npcs:\n+\t\tif typeof(npc) == TYPE_DICTIONARY and int(npc.get(\"uid\", -1)) == uid:\n+\t\t\treturn npc\n+\treturn {}\n+\n+func _show_story_choice(npc: Dictionary) -> void:\n+\tstory_choice_open = true\n+\tvar lines: Array = active_story_event.get(\"lines\", [])\n+\tif dialogue_panel != null:\n+\t\tdialogue_panel.visible = true\n+\tif dialogue_name_label != null:\n+\t\tdialogue_name_label.text = String(npc.get(\"displayName\", \"NPC\"))\n+\tif dialogue_text_label != null:\n+\t\tdialogue_text_label.text = \"\\n\".join(PackedStringArray(lines))\n+\tif dialogue_accept_button != null:\n+\t\tdialogue_accept_button.visible = true\n+\tif dialogue_reject_button != null:\n+\t\tdialogue_reject_button.visible = true\n+\n+func _resolve_story_choice(accepted: bool) -> void:\n+\tvar npc := _story_npc_by_uid(active_story_npc_uid)\n+\tif npc.is_empty():\n+\t\t_close_story_choice()\n+\t\treturn\n+\tvar state_delta: Dictionary = active_story_event.get(\"acceptState\" if accepted else \"rejectState\", {})\n+\t_apply_story_state_delta(state_delta)\n+\tvar memory: Array = story_world_state.get(\"eventMemory\", [])\n+\tmemory.append(\"%s:%s\" % [String(active_story_event.get(\"id\", \"\")), \"accepted\" if accepted else \"rejected\"])\n+\tstory_world_state[\"eventMemory\"] = memory\n+\tif dialogue_text_label != null:\n+\t\tdialogue_text_label.text = String(active_story_event.get(\"acceptedLine\" if accepted else \"rejectedLine\", \"\"))\n+\tif accepted:\n+\t\tnpc[\"gameType\"] = \"movable_npc\"\n+\t\tnpc[\"behavior\"] = \"wander_ai\"\n+\t\tnpc[\"home\"] = npc.get(\"position\", player.global_position)\n+\t\tnpc[\"path\"] = []\n+\t\tnpc[\"pauseTimer\"] = 0.4\n+\t\tactive_story_event = {}\n+\t\tactive_story_npc_uid = -1\n+\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\telse:\n+\t\tnpc[\"behavior\"] = \"story_exit\"\n+\t\tnpc[\"exitTarget\"] = _nearest_story_exit(Vector2(npc.get(\"position\", player.global_position)))\n+\t_close_story_choice(false)\n+\n+func _close_story_choice(hide_dialogue: bool = true) -> void:\n+\tstory_choice_open = false\n+\tif dialogue_accept_button != null:\n+\t\tdialogue_accept_button.visible = false\n+\tif dialogue_reject_button != null:\n+\t\tdialogue_reject_button.visible = false\n+\tif hide_dialogue and dialogue_panel != null:\n+\t\tdialogue_panel.visible = false\n+\n+func _apply_story_state_delta(delta: Dictionary) -> void:\n+\tfor key in delta.keys():\n+\t\tvar next_value := int(story_world_state.get(String(key), 0)) + int(delta[key])\n+\t\tstory_world_state[String(key)] = max(0, next_value)\n+\n+func _nearest_story_exit(pos: Vector2) -> Vector2:\n+\tvar left := Vector2(active_cell_px * 0.5, pos.y)\n+\tvar right := Vector2((active_map_w - 0.5) * active_cell_px, pos.y)\n+\tvar top := Vector2(pos.x, active_cell_px * 0.5)\n+\tvar bottom := Vector2(pos.x, (active_map_h - 0.5) * active_cell_px)\n+\tvar exits := [left, right, top, bottom]\n+\tvar best: Vector2 = exits[0]\n+\tvar best_dist := INF\n+\tfor exit_pos in exits:\n+\t\tvar distance := pos.distance_to(exit_pos)\n+\t\tif distance < best_dist:\n+\t\t\tbest = exit_pos\n+\t\t\tbest_dist = distance\n+\treturn best\n+\n+func _remove_story_npc(npc: Dictionary) -> void:\n+\tvar body: Node = npc.get(\"body\", null)\n+\tif body != null and is_instance_valid(body):\n+\t\tbody.queue_free()\n+\tactive_npcs.erase(npc)\n+\n+func _asset_id_texture_path(asset_id: String) -> String:\n+\tif asset_id == \"\":\n+\t\treturn \"\"\n+\tvar manifest := _json_dict(KENNEY_MAP_MANIFEST_JSON)\n+\tfor item in manifest.get(\"assets\", []):\n+\t\tif typeof(item) == TYPE_DICTIONARY and String(item.get(\"id\", \"\")) == asset_id:\n+\t\t\tvar rel_path := String(item.get(\"file\", \"\"))\n+\t\t\tif rel_path != \"\":\n+\t\t\t\treturn \"res://\" + rel_path\n+\treturn \"\"\n+\n func _create_movable_npc_body(visual_node: Sprite2D, world_pos: Vector2, node_offset: Vector2) -> CharacterBody2D:\n \tvar body := CharacterBody2D.new()\n*** End Patch\n"}}
{"timestamp":"2026-05-31T07:39:18.385Z","type":"event_msg","payload":{"type":"patch_apply_end","call_id":"call_4W581NkkKOHdoZAmO4bN7AML","turn_id":"019e7cf3-96ed-7403-9dd4-b0be93775084","stdout":"Success. Updated the following files:\nM /Users/vincet/Documents/aiglass/GameGmeta/scripts/main.gd\n","stderr":"","success":true,"changes":{"/Users/vincet/Documents/aiglass/GameGmeta/scripts/main.gd":{"type":"update","unified_diff":"@@ -1204,2 +1204,335 @@\n \n+func _reset_story_events() -> void:\n+\tstory_world_state = {\n+\t\t\"storyStage\": 0,\n+\t\t\"enemyPressure\": 0,\n+\t\t\"trust\": 0,\n+\t\t\"npcSurvival\": 0,\n+\t\t\"reputation\": 0,\n+\t\t\"eventMemory\": [],\n+\t}\n+\tstory_event_index = 0\n+\tstory_event_timer = STORY_EVENT_START_DELAY\n+\tactive_story_event = {}\n+\tactive_story_npc_uid = -1\n+\tstory_choice_open = false\n+\n+func _story_event_pool() -> Array:\n+\treturn [\n+\t\t{\n+\t\t\t\"id\": \"lina_herbalist\",\n+\t\t\t\"npcDefinition\": \"urban_walker_003\",\n+\t\t\t\"displayName\": \"Lina\",\n+\t\t\t\"acceptedLine\": \"Thank you. I will stay nearby and help with herbs when I can.\",\n+\t\t\t\"rejectedLine\": \"I understand. I will try another road before night falls.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"Are you the one protecting this place?\",\n+\t\t\t\t\"The forest is no longer safe. Monsters burned my herb hut.\",\n+\t\t\t\t\"I can identify healing plants and care for wounded people.\",\n+\t\t\t\t\"Please let me stay. I will not be a burden.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"trust\": 1, \"npcSurvival\": 1},\n+\t\t\t\"rejectState\": {\"trust\": -1, \"enemyPressure\": 1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"noah_disaster_warning\",\n+\t\t\t\"npcDefinition\": \"urban_walker_002\",\n+\t\t\t\"displayName\": \"Noah\",\n+\t\t\t\"acceptedLine\": \"I will keep sorting every warning that reaches us.\",\n+\t\t\t\"rejectedLine\": \"Then I have to carry this warning somewhere else.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"I finally found a place with lights still on.\",\n+\t\t\t\t\"I ran from the east. Villages along the road are evacuating.\",\n+\t\t\t\t\"This letter is not ordinary mail. It is a disaster warning.\",\n+\t\t\t\t\"It says the ground is shaking, rivers are turning dark, and animals are fleeing.\",\n+\t\t\t\t\"If that is true, this place may be next.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"storyStage\": 1, \"trust\": 1, \"reputation\": 1},\n+\t\t\t\"rejectState\": {\"storyStage\": 0, \"trust\": -1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"wenwen_archaeologist\",\n+\t\t\t\"npcDefinition\": \"urban_walker_001\",\n+\t\t\t\"displayName\": \"Wenwen\",\n+\t\t\t\"acceptedLine\": \"I will decode the stones and look for the monster's weakness.\",\n+\t\t\t\"rejectedLine\": \"Without the records, you may meet it without warning.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"Do not attack. I am an archaeologist, not an enemy.\",\n+\t\t\t\t\"In the ruins I found one name carved again and again.\",\n+\t\t\t\t\"The ancients called it the Sun Eater, a super monster strong enough to break the continent.\",\n+\t\t\t\t\"The smaller monsters may be answering its awakening.\",\n+\t\t\t\t\"Let me stay. I can keep reading the stones and search for its weakness.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"storyStage\": 1, \"trust\": 1, \"reputation\": 1},\n+\t\t\t\"rejectState\": {\"enemyPressure\": 1, \"trust\": -1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"marlo_merchant\",\n+\t\t\t\"npcDefinition\": \"urban_walker_004\",\n+\t\t\t\"displayName\": \"Marlo\",\n+\t\t\t\"acceptedLine\": \"I will repair crates and mark supplies when I find them.\",\n+\t\t\t\"rejectedLine\": \"Then I will keep moving before the road closes behind me.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"I am not here to sell anything. Not today.\",\n+\t\t\t\t\"My caravan was attacked. Goods, carts, friends, all gone.\",\n+\t\t\t\t\"Noah was right about the roads. The north route is broken.\",\n+\t\t\t\t\"I can repair boxes and remember where supplies might be hidden.\",\n+\t\t\t\t\"Let me stay and I will repay you with what I have left.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"reputation\": 1, \"trust\": 1, \"npcSurvival\": 1},\n+\t\t\t\"rejectState\": {\"reputation\": -1},\n+\t\t},\n+\t\t{\n+\t\t\t\"id\": \"kyle_guard\",\n+\t\t\t\"npcDefinition\": \"urban_walker_006\",\n+\t\t\t\"displayName\": \"Kyle\",\n+\t\t\t\"acceptedLine\": \"I will patrol here. If they come again, I will fight.\",\n+\t\t\t\"rejectedLine\": \"Then I will draw them away if I still can.\",\n+\t\t\t\"lines\": [\n+\t\t\t\t\"Please let me in. Enemies are still behind me.\",\n+\t\t\t\t\"The outpost has fallen. These are not random monsters.\",\n+\t\t\t\t\"They move like an army, and something is commanding them.\",\n+\t\t\t\t\"If Wenwen is right, this is only the beginning.\",\n+\t\t\t\t\"Let me stay. I can help defend this place.\"\n+\t\t\t],\n+\t\t\t\"acceptState\": {\"npcSurvival\": 1, \"trust\": 1, \"storyStage\": 1},\n+\t\t\t\"rejectState\": {\"enemyPressure\": 1, \"reputation\": -1},\n+\t\t},\n+\t]\n+\n+func _update_story_event_system(delta: float) -> void:\n+\tif _is_world_overview_mode() or player == null or match_result != \"\":\n+\t\treturn\n+\tif story_choice_open:\n+\t\treturn\n+\tif not active_story_event.is_empty():\n+\t\t_update_active_story_npc(delta)\n+\t\treturn\n+\tif story_event_index >= _story_event_pool().size():\n+\t\treturn\n+\tstory_event_timer = max(0.0, story_event_timer - delta)\n+\tif story_event_timer <= 0.0:\n+\t\t_start_next_story_event()\n+\n+func _start_next_story_event() -> void:\n+\tvar events := _story_event_pool()\n+\tif story_event_index >= events.size():\n+\t\treturn\n+\tactive_story_event = events[story_event_index]\n+\tstory_event_index += 1\n+\tvar npc := _spawn_story_event_npc(active_story_event)\n+\tif npc.is_empty():\n+\t\tactive_story_event = {}\n+\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\t\treturn\n+\tactive_story_npc_uid = int(npc.get(\"uid\", -1))\n+\n+func _spawn_story_event_npc(event: Dictionary) -> Dictionary:\n+\tvar definitions: Dictionary = game_rules_cache.get(\"npcDefinitions\", {})\n+\tvar definition_id := String(event.get(\"npcDefinition\", \"\"))\n+\tif not definitions.has(definition_id):\n+\t\treturn {}\n+\tvar definition: Dictionary = definitions[definition_id]\n+\tvar spawn_cell := _random_story_edge_cell()\n+\tvar world_pos := _npc_cell_center(spawn_cell)\n+\tvar sprite := Sprite2D.new()\n+\tsprite.name = \"StoryVisitor_%s\" % String(event.get(\"id\", \"visitor\"))\n+\tsprite.centered = true\n+\tsprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n+\tsprite.z_index = 18\n+\tsprite.scale = Vector2(PLAYER_VISUAL_SCALE, PLAYER_VISUAL_SCALE)\n+\tvar texture_path := _asset_id_texture_path(String(definition.get(\"assetId\", \"\")))\n+\tif texture_path != \"\":\n+\t\tsprite.texture = _texture(texture_path)\n+\tmap_root.add_child(sprite)\n+\tvar body := _create_movable_npc_body(sprite, world_pos, Vector2.ZERO)\n+\tvar frame_paths := _npc_frame_paths(definition, game_rules_cache)\n+\tvar stats := _actor_template(String(definition.get(\"actorTemplate\", \"walker_npc\")))\n+\tstats[\"hp\"] = float(stats.get(\"hp\", stats.get(\"maxHp\", 60.0)))\n+\tactive_npc_serial += 1\n+\tvar npc := {\n+\t\t\"uid\": active_npc_serial,\n+\t\t\"assetId\": String(definition.get(\"assetId\", \"\")),\n+\t\t\"npcId\": definition_id,\n+\t\t\"displayName\": String(event.get(\"displayName\", definition.get(\"displayName\", \"NPC\"))),\n+\t\t\"gameType\": \"story_npc\",\n+\t\t\"storyEventId\": String(event.get(\"id\", \"\")),\n+\t\t\"lines\": event.get(\"lines\", []),\n+\t\t\"lineIndex\": 0,\n+\t\t\"position\": world_pos,\n+\t\t\"interactionRadius\": active_cell_px * 1.5,\n+\t\t\"behavior\": \"story_approach\",\n+\t\t\"ai\": definition.get(\"ai\", {}),\n+\t\t\"stats\": stats,\n+\t\t\"home\": world_pos,\n+\t\t\"target\": player.global_position,\n+\t\t\"path\": [],\n+\t\t\"pauseTimer\": 0.0,\n+\t\t\"fleeTimer\": 0.0,\n+\t\t\"fleeFrom\": world_pos,\n+\t\t\"helpSignalTimer\": 0.0,\n+\t\t\"repathTimer\": 0.0,\n+\t\t\"stuckTimer\": 0.0,\n+\t\t\"lastPosition\": world_pos,\n+\t\t\"moveTimer\": 0.0,\n+\t\t\"node\": sprite,\n+\t\t\"body\": body,\n+\t\t\"nodeOffset\": Vector2.ZERO,\n+\t\t\"framePaths\": frame_paths,\n+\t\t\"facing\": \"down\",\n+\t\t\"animFrame\": 0,\n+\t\t\"animTime\": 0.0,\n+\t\t\"interactable\": true,\n+\t}\n+\tactive_npcs.append(npc)\n+\treturn npc\n+\n+func _random_story_edge_cell() -> Vector2i:\n+\tvar candidates: Array[Vector2i] = []\n+\tfor x in range(active_map_w):\n+\t\tcandidates.append(Vector2i(x, 1))\n+\t\tcandidates.append(Vector2i(x, max(1, active_map_h - 2)))\n+\tfor y in range(active_map_h):\n+\t\tcandidates.append(Vector2i(1, y))\n+\t\tcandidates.append(Vector2i(max(1, active_map_w - 2), y))\n+\tcandidates.shuffle()\n+\tfor cell in candidates:\n+\t\tif _in_map(cell) and not active_blocked_cells.has(cell):\n+\t\t\treturn cell\n+\treturn Vector2i(1, 1)\n+\n+func _update_active_story_npc(delta: float) -> void:\n+\tvar npc := _story_npc_by_uid(active_story_npc_uid)\n+\tif npc.is_empty():\n+\t\tactive_story_event = {}\n+\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\t\treturn\n+\tvar behavior := String(npc.get(\"behavior\", \"\"))\n+\tif behavior == \"story_approach\":\n+\t\tvar body: CharacterBody2D = npc.get(\"body\", null)\n+\t\tif body == null or not is_instance_valid(body):\n+\t\t\treturn\n+\t\tvar target_pos := player.global_position\n+\t\tvar distance := body.position.distance_to(target_pos)\n+\t\tif distance <= STORY_EVENT_APPROACH_DISTANCE:\n+\t\t\tbody.velocity = Vector2.ZERO\n+\t\t\tnpc[\"position\"] = body.position\n+\t\t\t_face_npc_towards(npc, body.position.direction_to(player.global_position))\n+\t\t\t_show_story_choice(npc)\n+\t\t\treturn\n+\t\tvar direction := body.position.direction_to(target_pos)\n+\t\tbody.velocity = direction * STORY_EVENT_SPEED\n+\t\t_update_npc_animation(npc, direction, delta)\n+\t\tbody.move_and_slide()\n+\t\tnpc[\"position\"] = body.position\n+\telif behavior == \"story_exit\":\n+\t\tvar body: CharacterBody2D = npc.get(\"body\", null)\n+\t\tif body == null or not is_instance_valid(body):\n+\t\t\t_remove_story_npc(npc)\n+\t\t\treturn\n+\t\tvar exit_target: Vector2 = npc.get(\"exitTarget\", _nearest_story_exit(body.position))\n+\t\tif body.position.distance_to(exit_target) <= 8.0:\n+\t\t\t_remove_story_npc(npc)\n+\t\t\tactive_story_event = {}\n+\t\t\tactive_story_npc_uid = -1\n+\t\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\t\t\treturn\n+\t\tvar direction := body.position.direction_to(exit_target)\n+\t\tbody.velocity = direction * STORY_EVENT_SPEED\n+\t\t_update_npc_animation(npc, direction, delta)\n+\t\tbody.move_and_slide()\n+\t\tnpc[\"position\"] = body.position\n+\n+func _story_npc_by_uid(uid: int) -> Dictionary:\n+\tfor npc in active_npcs:\n+\t\tif typeof(npc) == TYPE_DICTIONARY and int(npc.get(\"uid\", -1)) == uid:\n+\t\t\treturn npc\n+\treturn {}\n+\n+func _show_story_choice(npc: Dictionary) -> void:\n+\tstory_choice_open = true\n+\tvar lines: Array = active_story_event.get(\"lines\", [])\n+\tif dialogue_panel != null:\n+\t\tdialogue_panel.visible = true\n+\tif dialogue_name_label != null:\n+\t\tdialogue_name_label.text = String(npc.get(\"displayName\", \"NPC\"))\n+\tif dialogue_text_label != null:\n+\t\tdialogue_text_label.text = \"\\n\".join(PackedStringArray(lines))\n+\tif dialogue_accept_button != null:\n+\t\tdialogue_accept_button.visible = true\n+\tif dialogue_reject_button != null:\n+\t\tdialogue_reject_button.visible = true\n+\n+func _resolve_story_choice(accepted: bool) -> void:\n+\tvar npc := _story_npc_by_uid(active_story_npc_uid)\n+\tif npc.is_empty():\n+\t\t_close_story_choice()\n+\t\treturn\n+\tvar state_delta: Dictionary = active_story_event.get(\"acceptState\" if accepted else \"rejectState\", {})\n+\t_apply_story_state_delta(state_delta)\n+\tvar memory: Array = story_world_state.get(\"eventMemory\", [])\n+\tmemory.append(\"%s:%s\" % [String(active_story_event.get(\"id\", \"\")), \"accepted\" if accepted else \"rejected\"])\n+\tstory_world_state[\"eventMemory\"] = memory\n+\tif dialogue_text_label != null:\n+\t\tdialogue_text_label.text = String(active_story_event.get(\"acceptedLine\" if accepted else \"rejectedLine\", \"\"))\n+\tif accepted:\n+\t\tnpc[\"gameType\"] = \"movable_npc\"\n+\t\tnpc[\"behavior\"] = \"wander_ai\"\n+\t\tnpc[\"home\"] = npc.get(\"position\", player.global_position)\n+\t\tnpc[\"path\"] = []\n+\t\tnpc[\"pauseTimer\"] = 0.4\n+\t\tactive_story_event = {}\n+\t\tactive_story_npc_uid = -1\n+\t\tstory_event_timer = STORY_EVENT_NEXT_DELAY\n+\telse:\n+\t\tnpc[\"behavior\"] = \"story_exit\"\n+\t\tnpc[\"exitTarget\"] = _nearest_story_exit(Vector2(npc.get(\"position\", player.global_position)))\n+\t_close_story_choice(false)\n+\n+func _close_story_choice(hide_dialogue: bool = true) -> void:\n+\tstory_choice_open = false\n+\tif dialogue_accept_button != null:\n+\t\tdialogue_accept_button.visible = false\n+\tif dialogue_reject_button != null:\n+\t\tdialogue_reject_button.visible = false\n+\tif hide_dialogue and dialogue_panel != null:\n+\t\tdialogue_panel.visible = false\n+\n+func _apply_story_state_delta(delta: Dictionary) -> void:\n+\tfor key in delta.keys():\n+\t\tvar next_value := int(story_world_state.get(String(key), 0)) + int(delta[key])\n+\t\tstory_world_state[String(key)] = max(0, next_value)\n+\n+func _nearest_story_exit(pos: Vector2) -> Vector2:\n+\tvar left := Vector2(active_cell_px * 0.5, pos.y)\n+\tvar right := Vector2((active_map_w - 0.5) * active_cell_px, pos.y)\n+\tvar top := Vector2(pos.x, active_cell_px * 0.5)\n+\tvar bottom := Vector2(pos.x, (active_map_h - 0.5) * active_cell_px)\n+\tvar exits := [left, right, top, bottom]\n+\tvar best: Vector2 = exits[0]\n+\tvar best_dist := INF\n+\tfor exit_pos in exits:\n+\t\tvar distance := pos.distance_to(exit_pos)\n+\t\tif distance < best_dist:\n+\t\t\tbest = exit_pos\n+\t\t\tbest_dist = distance\n+\treturn best\n+\n+func _remove_story_npc(npc: Dictionary) -> void:\n+\tvar body: Node = npc.get(\"body\", null)\n+\tif body != null and is_instance_valid(body):\n+\t\tbody.queue_free()\n+\tactive_npcs.erase(npc)\n+\n+func _asset_id_texture_path(asset_id: String) -> String:\n+\tif asset_id == \"\":\n+\t\treturn \"\"\n+\tvar manifest := _json_dict(KENNEY_MAP_MANIFEST_JSON)\n+\tfor item in manifest.get(\"assets\", []):\n+\t\tif typeof(item) == TYPE_DICTIONARY and String(item.get(\"id\", \"\")) == asset_id:\n+\t\t\tvar rel_path := String(item.get(\"file\", \"\"))\n+\t\t\tif rel_path != \"\":\n+\t\t\t\treturn \"res://\" + rel_path\n+\treturn \"\"\n+\n func _create_movable_npc_body(visual_node: Sprite2D, world_pos: Vector2, node_offset: Vector2) -> CharacterBody2D:\n","move_path":null}},"status":"completed"}}
