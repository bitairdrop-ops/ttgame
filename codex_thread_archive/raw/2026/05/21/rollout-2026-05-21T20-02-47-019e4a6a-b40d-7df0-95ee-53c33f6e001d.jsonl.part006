emplate_id].duplicate(true)\n\treturn {}\n\nfunc _skill_template(skill_id: String) -> Dictionary:\n\tvar templates: Dictionary = game_rules_cache.get(\"skillTemplates\", {})\n\tif templates.has(skill_id) and typeof(templates[skill_id]) == TYPE_DICTIONARY:\n\t\treturn templates[skill_id].duplicate(true)\n\treturn {}\n\nfunc _stamp_editor_texture(texture_path: String, origin: Vector2, footprint: Vector2, blocked: bool, z: int, node_name: String) -> Sprite2D:\n\tvar texture := _texture(texture_path)\n\tif texture == null:\n\t\treturn null\n\n\tvar sprite := Sprite2D.new()\n\tsprite.name = node_name\n\tsprite.texture = texture\n\tsprite.centered = false\n\tsprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n\tsprite.z_index = z\n\tsprite.position = Vector2(origin.x * active_cell_px, origin.y * active_cell_px)\n\tvar desired_size := Vector2(footprint.x * active_cell_px, footprint.y * active_cell_px)\n\tvar source_size := Vector2(texture.get_width(), texture.get_height())\n\tif source_size.x > 0 and source_size.y > 0:\n\t\tsprite.scale = Vector2(desired_size.x / source_size.x, desired_size.y / source_size.y)\n\tmap_root.add_child(sprite)\n\n\tif blocked:\n\t\t_block_rect_cells(Rect2i(Vector2i(int(floor(origin.x)), int(floor(origin.y))), Vector2i(int(ceil(footprint.x)), int(ceil(footprint.y)))))\n\treturn sprite\n\nfunc _add_world_overview_background(godot_map: Dictionary) -> void:\n\tvar map_size := Vector2(active_map_w * active_cell_px, active_map_h * active_cell_px)\n\tvar ocean := ColorRect.new()\nfunc _in_map(cell: Vector2i) -> bool:\n\treturn cell.x >= 0 and cell.x < active_map_w and cell.y >= 0 and cell.y < active_map_h\n\nfunc _add_static_collision_cells(blocked: Dictionary) -> void:\n\tvar root := Node2D.new()\n\troot.name = \"GeneratedPhysicsBoundaries_StaticBody2D\"\n\troot.visible = false\n\tmap_root.add_child(root)\n\tfor cell in blocked.keys():\n\t\tvar body := StaticBody2D.new()\n\t\tbody.collision_layer = 1\n\t\tbody.collision_mask = 1\n\t\tbody.position = Vector2(cell.x * active_cell_px + active_cell_px * 0.5, cell.y * active_cell_px + active_cell_px * 0.5)\n\t\tvar shape := CollisionShape2D.new()\n\t\tvar rect := RectangleShape2D.new()\n\t\trect.size = Vector2(active_cell_px, active_cell_px)\n\t\tshape.shape = rect\n\t\tbody.add_child(shape)\n\t\troot.add_child(body)\n\nfunc _add_player(tile_position: Vector2i) -> void:\n\tplayer = CharacterBody2D.new()\n\tplayer.name = \"Player_CharacterBody2D\"\n\tvar min_tile_x := 0 if _is_world_overview_mode() else (1 if active_map_w > 2 else 0)\n\tvar min_tile_y := 0 if _is_world_overview_mode() else (1 if active_map_h > 2 else 0)\n\tvar max_tile_x := active_map_w - 1 if _is_world_overview_mode() else active_map_w - 2\n\tvar max_tile_y := active_map_h - 1 if _is_world_overview_mode() else active_map_h - 2\n\tvar clamped_tile := Vector2i(\n\t\tclamp(tile_position.x, min_tile_x, max(min_tile_x, max_tile_x)),\n\t\tclamp(tile_position.y, min_tile_y, max(min_tile_y, max_tile_y))\n\t)\n\tplayer.position = Vector2(clamped_tile.x * active_cell_px + active_cell_px * 0.5, clamped_tile.y * active_cell_px + active_cell_px * 0.5)\n\tplayer.collision_layer = 1\n\tplayer.collision_mask = 1\n\tplayer.z_index = 20\n\tmap_root.add_child(player)\n\n\tvar collision := CollisionShape2D.new()\n\tvar circle := CircleShape2D.new()\n\tcircle.radius = 10\n\tcollision.shape = circle\n\tplayer.add_child(collision)\n\n\tplayer_sprite = AnimatedSprite2D.new()\n\tplayer_sprite.name = \"AnimatedPunyWarrior\"\n\tplayer_sprite.sprite_frames = _create_character_frames()\n\tplayer_sprite.animation = \"idle_down\"\n\tvar visual_scale := 1.25 if _is_world_overview_mode() else PLAYER_VISUAL_SCALE\n\tplayer_sprite.scale = Vector2(visual_scale, visual_scale)\n\tplayer_sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST\n\tplayer_sprite.animation_finished.connect(_on_player_animation_finished)\n"}}
