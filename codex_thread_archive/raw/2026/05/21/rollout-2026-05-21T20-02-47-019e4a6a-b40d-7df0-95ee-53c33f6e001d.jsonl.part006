ius_sq := view_radius * view_radius\n+\t\tvar y := 0.0\n+\t\twhile y < size.y:\n+\t\t\tvar mid_y := y + step * 0.5\n+\t\t\tvar dy := mid_y - view_center.y\n+\t\t\tif abs(dy) >= view_radius:\n+\t\t\t\tdraw_rect(Rect2(0.0, y, size.x, step), dark)\n+\t\t\telse:\n+\t\t\t\tvar dx := sqrt(max(0.0, radius_sq - dy * dy))\n+\t\t\t\tvar left_w: float = clamp(view_center.x - dx, 0.0, size.x)\n+\t\t\t\tvar right_x: float = clamp(view_center.x + dx, 0.0, size.x)\n+\t\t\t\tif left_w > 0.0:\n+\t\t\t\t\tdraw_rect(Rect2(0.0, y, left_w, step), dark)\n+\t\t\t\tif right_x > left_w:\n+\t\t\t\t\tdraw_rect(Rect2(left_w, y, right_x - left_w, step), inner)\n+\t\t\t\tif right_x < size.x:\n+\t\t\t\t\tdraw_rect(Rect2(right_x, y, size.x - right_x, step), dark)\n+\t\t\ty += step\n+\n+class WeatherOverlay:\n+\textends Control\n+\n+\tvar weather := \"sunny\"\n+\tvar weather_elapsed := 0.0\n+\tvar weather_total := 10.0\n+\tvar rain_drops: Array = []\n+\tvar clouds: Array = []\n+\n+\tfunc set_weather(next_weather: String, duration: float = 10.0) -> void:\n+\t\tweather = next_weather\n+\t\tweather_elapsed = 0.0\n+\t\tweather_total = max(0.1, duration)\n+\t\train_drops.clear()\n+\t\tclouds.clear()\n+\t\tmatch weather:\n+\t\t\t\"light_rain\":\n+\t\t\t\t_make_rain(72, 215.0, 6.0)\n+\t\t\t\"heavy_rain\":\n+\t\t\t\t_make_rain(180, 310.0, 9.0)\n+\t\t\t\"cloudy\":\n+\t\t\t\t_make_clouds(5)\n+\t\tqueue_redraw()\n+\n+\tfunc tick(delta: float) -> void:\n+\t\tweather_elapsed += delta\n+\t\tif weather == \"light_rain\" or weather == \"heavy_rain\":\n+\t\t\tfor drop in rain_drops:\n+\t\t\t\tvar pos: Vector2 = drop.get(\"pos\", Vector2.ZERO)\n+\t\t\t\tvar speed := float(drop.get(\"speed\", 220.0))\n+\t\t\t\tpos += Vector2(-0.45, 1.0).normalized() * speed * delta\n+\t\t\t\tif pos.y > size.y + 20.0 or pos.x < -24.0:\n+\t\t\t\t\tpos = Vector2(randf_range(0.0, size.x + 80.0), randf_range(-80.0, -8.0))\n+\t\t\t\tdrop[\"pos\"] = pos\n+\t\telif weather == \"cloudy\":\n+\t\t\tfor cloud in clouds:\n+\t\t\t\tvar pos: Vector2 = cloud.get(\"pos\", Vector2.ZERO)\n+\t\t\t\tpos.x += float(cloud.get(\"speed\", 22.0)) * delta\n+\t\t\t\tif pos.x > size.x + 96.0:\n+\t\t\t\t\tpos.x = randf_range(-180.0, -96.0)\n+\t\t\t\t\tpos.y = randf_range(68.0, max(92.0, size.y - 120.0))\n+\t\t\t\tcloud[\"pos\"] = pos\n+\t\tqueue_redraw()\n+\n+\tfunc _draw() -> void:\n+\t\tif weather == \"sunny\":\n+\t\t\treturn\n+\t\tif weather == \"light_rain\":\n+\t\t\tdraw_rect(Rect2(Vector2.ZERO, size), Color(0.35, 0.48, 0.62, 0.08))\n+\t\t\t_draw_rain(Color(0.76, 0.88, 1.0, 0.46))\n+\t\telif weather == \"heavy_rain\":\n+\t\t\tdraw_rect(Rect2(Vector2.ZERO, size), Color(0.18, 0.28, 0.42, 0.18))\n+\t\t\t_draw_rain(Color(0.76, 0.9, 1.0, 0.68))\n+\t\telif weather == \"cloudy\":\n+\t\t\tvar alpha := _cloud_alpha()\n+\t\t\tfor cloud in clouds:\n+\t\t\t\t_draw_pixel_cloud(cloud, true, alpha)\n+\t\t\tfor cloud in clouds:\n+\t\t\t\t_draw_pixel_cloud(cloud, false, alpha)\n+\n+\tfunc _make_rain(count: int, base_speed: float, base_len: float) -> void:\n+\t\tfor i in range(count):\n+\t\t\train_drops.append({\n+\t\t\t\t\"pos\": Vector2(randf_range(-40.0, max(1.0, size.x + 80.0)), randf_range(-60.0, max(1.0, size.y))),\n+\t\t\t\t\"speed\": randf_range(base_speed * 0.82, base_speed * 1.18),\n+\t\t\t\t\"len\": randf_range(base_len * 0.75, base_len * 1.25),\n+\t\t\t})\n+\n+\tfunc _make_clouds(count: int) -> void:\n+\t\tfor i in range(count):\n+\t\t\tclouds.append({\n+\t\t\t\t\"pos\": Vector2(randf_range(-80.0, max(1.0, size.x)), randf_range(72.0, max(92.0, size.y - 120.0))),\n+\t\t\t\t\"speed\": randf_range(12.0, 28.0),\n+\t\t\t\t\"scale\": randf_range(1.0, 1.65),\n+\t\t\t})\n+\n+\tfunc _draw_rain(color: Color) -> void:\n+\t\tfor drop in rain_drops:\n+\t\t\tvar pos: Vector2 = drop.get(\"pos\", Vector2.ZERO)\n+\t\t\tvar length := float(drop.get(\"len\", 7.0))\n+\t\t\tdraw_line(pos, pos + Vector2(-length * 0.45, length), color, 1.0)\n+\n+\tfunc _cloud_alpha() -> float:\n+\t\tvar fade_seconds: float = min(CLOUDY_FADE_SECONDS, weather_total 