pse(px, py, 0.82, 0.73, 0.085, 0.06);\n+  const japan = inEllipse(px, py, 0.91, 0.42, 0.028, 0.06);\n+  const indonesia = inEllipse(px, py, 0.76, 0.64, 0.13, 0.035);\n+\n+  const land = northAmerica || centralAmerica || southAmerica || greenland\n+    || europeAsia || indiaSoutheastAsia || africa || australia || japan || indonesia;\n+  const carvedAtlantic = inEllipse(px, py, 0.47, 0.45, 0.055, 0.16);\n+  const carvedMediterranean = inEllipse(px, py, 0.56, 0.40, 0.085, 0.025);\n+  const carvedArabianSea = inEllipse(px, py, 0.66, 0.57, 0.055, 0.065);\n+  return land && !carvedAtlantic && !carvedMediterranean && !carvedArabianSea;\n+}\n+\n function worldLandLayout(mapCount) {\n-  let cols = Math.max(28, Math.ceil(Math.sqrt(Math.max(1, mapCount) * 2.8)));\n-  let rows = Math.max(18, Math.ceil(cols * 0.64));\n+  let cols = Math.max(42, Math.ceil(Math.sqrt(Math.max(1, mapCount) * 4.8)));\n+  let rows = Math.max(24, Math.ceil(cols * 0.56));\n   let landCells = [];\n   let terrainCells = [];\n   while (landCells.length < mapCount) {\n     landCells = [];\n     terrainCells = [];\n-    const centerX = (cols - 1) / 2;\n-    const centerY = (rows - 1) / 2;\n-    const radiusX = Math.max(1, cols * 0.39);\n-    const radiusY = Math.max(1, rows * 0.34);\n     for (let y = 0; y < rows; y += 1) {\n       for (let x = 0; x < cols; x += 1) {\n-        const dx = (x - centerX) / radiusX;\n-        const dy = (y - centerY) / radiusY;\n-        const bulge = (\n-          Math.sin((x + 1) * 1.7) * 0.13\n-          + Math.cos((y + 2) * 1.3) * 0.10\n-          + Math.sin((x + y) * 0.9) * 0.08\n-        );\n-        const island = (\n-          Math.sin((x - 3) * 0.74) * Math.cos((y + 5) * 0.81) > 0.52\n-          && dx * dx + dy * dy < 1.74\n-        );\n-        const isLand = (dx * dx + dy * dy) < 1.0 + bulge || island;\n+        const isLand = isEarthLandCell(x, y, cols, rows);\n         const variant = Math.abs((x * 37 + y * 53 + x * y * 11) % 5);\n         terrainCells.push({ x, y, type: isLand ? \"land\" : \"ocean\", variant });\n         if (isLand) landCells.push({ x, y, variant });\n       }\n     }\n+    landCells.sort((a, b) => (a.y - b.y) || (a.x - b.x));\n     if (landCells.length < mapCount) {\n-      cols += 2;\n-      rows += 1;\n+      cols += 4;\n+      rows = Math.ceil(cols * 0.56);\n     }\n   }\n   return { cols, rows, landCells, terrainCells };\n }\n*** End Patch\n"}}
