tems: center;\n  justify-content: space-between;\n  gap: 24px;\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--line);\n  background: rgba(18, 24, 29, .96);\n}\n\nh1 {\n  margin: 0;\n  font-size: 22px;\n  line-height: 1.1;\n  letter-spacing: 0;\n}\n\n.topbar p {\n  margin: 8px 0 0;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.toolbar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n\n.workspace {\n  min-height: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 14px;\n  padding: 14px;\n}\n\n.canvas-panel,\n.asset-panel {\n  min-height: 0;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--panel);\n  box-shadow: 0 20px 44px rgba(0, 0, 0, .28);\n}\n\n.canvas-panel {\n  display: grid;\n  grid-template-rows: auto auto 1fr;\n}\n\n.canvas-head,\n.asset-head {\n  min-height: 58px;\n  padding: 12px 14px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  border-bottom: 1px solid var(--line);\n  background: rgba(24, 32, 38, .92);\n}\n\n.canvas-head strong,\n.asset-head strong {\n  display: block;\n  font-size: 15px;\n}\n\n.canvas-head span,\n.asset-head span {\n  display: block;\n  margin-top: 5px;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.canvas-stats {\n  display: flex;\n  gap: 8px;\n}\n\n.canvas-stats span {\n  margin: 0;\n  padding: 6px 9px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  color: #c9d5cc;\n  background: #11181d;\n}\n\n.map-frame {\n  min-height: 0;\n  overflow: auto;\n  padding: 18px;\n  background: #0c1115;\n}\n\n.map-board {\n  position: relative;\n  width: calc(var(--board-cols) * var(--cell));\n  height: calc(var(--board-rows) * var(--cell));\n  margin: 0 auto;\n  border: 2px solid #5e6f78;\n  background-color: #79bf63;\n  background-image:\n    linear-gradient(rgba(0, 0, 0, .18) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0, 0, 0, .18) 1px, transparent 1px);\n  background-size: var(--cell) var(--cell);\n  image-rendering: pixelated;\n  overflow: hidden;\n  box-shadow: 0 24px 70px rgba(0, 0, 0, .36);\n}\n\n.grid-cell {\n  position: absolute;\n  width: var(--cell);\n  height: var(--cell);\n  background-repeat: repeat;\n  background-size: var(--cell) var(--cell);\n  image-rendering: pixelated;\n}\n\n.grid-cell.drop-target {\n  outline: 2px solid rgba(255, 236, 157, .92);\n  outline-offset: -2px;\n"}}
{"timestamp":"2026-05-28T13:15:01.190Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_RM5chRtHAwEDKJzaY8tnJA9V","output":"Chunk ID: 826b1d\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 2744\nOutput:\n    })),\n    objects: (editorMap?.stamps || []).filter((stamp) => !isBaseTerrainAsset(assetById(stamp.assetId))).map((stamp) => ({\n      id: stamp.id,\n      assetId: stamp.assetId || null,\n      texture: stampTexturePath(stamp),\n      x: stamp.x,\n      y: stamp.y,\n      w: stamp.w,\n      h: stamp.h,\n      blocking: Boolean(stamp.blocking),\n      z: 6,\n    })),\n  };\n}\n\nfunction godotMapData() {\n  return godotMapDataFromEditorMap(currentEditorMapData());\n}\n\nfunction chronologicalSavedMaps() {\n  return savedMaps().sort((a, b) => {\n    const left = String(a.createdAt || a.updatedAt || a.id || \"\");\n    const right = String(b.createdAt || b.updatedAt || b.id || \"\");\n    return left.localeCompare(right);\n  });\n}\n\nfunction isWorldEnemyObject(object) {\n  const asset = assetById(object.assetId);\n  const purpose = asset ? assetPurpose(asset) : \"\";\n  return purpose === \"怪物敌人\" || purpose === \"出生点\";\n}\n\nfunction worldLandLayout(mapCount) {\n  let cols = Math.max(24, Math.ceil(Math.sqrt(Math.max(1, mapCount) * 2.2)));\n  let rows = Math.max(16, Math.ceil(cols * 0.68));\n  let landCells = [];\n  while (landCells.length < mapCount) {\n    landCells = [];\n    const centerX = (cols - 1) / 2;\n    const centerY = (rows - 1) / 2;\n    const radiusX = Math.max(1, cols * 0.42);\n    const radiusY = Math.max(1, rows * 0.36);\n    for (let y = 0; y < rows; y += 1) {\n      for (let x = 0; x < cols; x += 1) {\n        const dx = (x - centerX) / radiusX;\n        const dy = (y - centerY) / radiusY;\n        const bulge = (\n          Math.sin((x + 1) * 1.7) * 0.13\n          + Math.cos((y + 2) * 1.3) * 0.10\n          + Math.sin((x + y) * 0.9) * 0.08\n        );\n        if ((dx * dx + dy * dy) < 1.0 + bulge) {\n          landCells.push({ x, y });\n        }\n      }\n    }\n    if (landCells.length < mapCount) {\n      cols += 2;\n      rows += 1;\n    }\n  }\n  return { cols, rows, landCells };\n}\n\nfunction worldMapDataFromSavedMaps(mode = \"explore\") {\n  const records = chronologicalSavedMaps().filter((record) => record?.data);\n  const sourceRecords = records.length > 0\n    ? records\n    : [{ id: \"current-editor-map\", name: currentSaveName(), updatedAt: new Date().toISOString(), data: currentEditorMapData() }];\n  const sourceMaps = sourceRecords.map((record) => ({\n    record,\n    data: godotMapDataFromEditorMap(record.data),\n  }));\n  const mapCols = Math.max(...sourceMaps.map((entry) => Number(entry.data.cols) || COLS), COLS);\n  const mapRows = Math.max(...sourceMaps.map((entry) => Number(entry.data.rows) || ROWS), ROWS);\n  const landLayout = worldLandLayout(sourceMaps.length);\n  const layoutCols = landLayout.cols;\n  const layoutRows = landLayout.rows;\n  const groundId = defaultTile()?.id || GROUND_ASSET_ID;\n  const groundAsset = assetById(groundId);\n  const worldTiles = sourceMaps.map((entry, index) => {\n    const landCell = landLayout.landCells[index] || { x: index % layoutCols, y: Math.floor(index / layoutCols) };\n    const tileX = landCell.x;\n    const tileY = landCell.y;\n    return {\n      id: entry.record.id || `map-${index + 1}`,\n      name: entry.record.name || `Map ${index + 1}`,\n      worldX: tileX * mapCols,\n      worldY: tileY * mapRows,\n      overviewX: tileX,\n      overviewY: tileY,\n      cols: Number(entry.data.cols) || COLS,\n      rows: Number(entry.data.rows) || ROWS,\n      order: index + 1,\n    };\n  });\n\n  if (mode === \"overview\") {\n    return {\n      format: \"GameGmetaGodotMap\",\n      version: 1,\n      isWorldMap: true,\n      worldVisualMode: \"overview\",\n      name: \"World Overview\",\n      cols: layoutCols,\n      rows: layoutRows,\n      cell: 44,\n      terrain: Array.from({ length: layoutRows }, () => Array.from({ length: layoutCols }, () => ({\n        assetId: groundId,\n        texture: groundAsset?.file ? `res://${groundAsset.file}` : \"\",\n        blocking: false,\n      }))),\n      objects: [],\n      worldLayout: {\n        mapsPerRow: layoutCols,\n        sourceMapCols: mapCols,\n        sourceMapRows: mapRows,\n        landCells: landLayout.landCells,\n        tiles: worldTiles,\n      },\n    };\n  }\n\n  const terrain = Array.from({ length: layoutRows * mapRows }, () => Array.from({ length: layoutCols * mapCols }, () => ({\n    assetId: groundId,\n    texture: groundAsset?.file ? `res://${groundAsset.file}` : \"\",\n    blocking: false,\n  })));\n  const objects = [];\n\n  sourceMaps.forEach((entry, index) => {\n    const tileX = worldTiles[index]?.overviewX ?? (index % layoutCols);\n    const tileY = worldTiles[index]?.overviewY ?? Math.floor(index / layoutCols);\n    const offsetX = tileX * mapCols;\n    const offsetY = tileY * mapRows;\n    for (let y = 0; y < entry.data.terrain.length; y += 1) {\n      for (let x = 0; x < entry.data.terrain[y].length; x += 1) {\n        const targetY = offsetY + y;\n        const targetX = offsetX + x;\n        if (terrain[targetY] && terrain[targetY][targetX]) terrain[targetY][targetX] = entry.data.terrain[y][x];\n      }\n    }\n    for (const object of entry.data.objects || []) {\n      if (isWorldEnemyObject(object)) continue;\n      objects.push({\n        ...object,\n        id: `world-${index + 1}-${object.id}`,\n        x: (Number(object.x) || 0) + offsetX,\n        y: (Number(object.y) || 0) + offsetY,\n      });\n    }\n  });\n\n  return {\n    format: \"GameGmetaGodotMap\",\n    version: 1,\n    isWorldMap: true,\n    worldVisualMode: \"explore\",\n    name: \"World Map\",\n    cols: layoutCols * mapCols,\n    rows: layoutRows * mapRows,\n    cell: CELL,\n    terrain,\n    objects,\n    worldLayout: {\n      mapsPerRow: layoutCols,\n      sourceMapCols: mapCols,\n      sourceMapRows: mapRows,\n      landCells: landLayout.landCells,\n      tiles: worldTiles,\n    },\n  };\n}\n\nfunction worldSourceRuntimeMaps() {\n  const records = chronologicalSavedMaps().filter((record) => record?.data);\n  const sourceRecords = records.length > 0\n    ? records\n    : [{ id: \"current-editor-map\", name: currentSaveName(), updatedAt: new Date().toISOString(), data: currentEditorMapData() }];\n  return sourceRecords.map((record, index) => ({\n    id: record.id || `map-${index + 1}`,\n    name: record.name || `Map ${index + 1}`,\n    data: godotMapDataFromEditorMap(record.data),\n  }));\n}\n\nfunction godotRuntimeMaps(currentData, options = {}) {\n  const worldOverviewData = options.worldOverviewData || worldMapDataFromSavedMaps(\"overview\");\n  const worldExploreData = options.worldExploreData || worldMapDataFromSavedMaps(\"explore\");\n  const maps = [{\n    id: \"world-overview\",\n    name: \"World Overview\",\n    data: worldOverviewData,\n  }, {\n    id: \"world-explore\",\n    name: \"World Explore\",\n    data: worldExploreData,\n  }, {\n    id: \"current-editor-map\",\n    name: currentSaveName(),\n    data: currentData,\n  }];\n  for (const record of chronologicalSavedMaps()) {\n    if (!record?.data) continue;\n    maps.push({\n      id: record.id,\n      name: record.name,\n      data: godotMapDataFromEditorMap(record.data),\n    });\n  }\n  return { version: 1, maps };\n}\n\nfunction isBlockingAsset(asset) {\n  if (!asset || isBaseTerrainAsset(asset)) return false;\n  if (asset.mode !== \"tile\") return true;\n  const walkableTerrainIds = new Set([\n    \"tiny-town/Tiles/tile_0000\",\n    \"tiny-town/Tiles/tile_0001\",\n    \"tiny-town/Tiles/tile_0002\",\n    \"tiny-town/Tiles/tile_0012\",\n    \"tiny-town/Tiles/tile_0013\",\n    \"tiny-town/Tiles/tile_0014\",\n    \"tiny-town/Tiles/tile_0024\",\n    \"tiny-town/Tiles/tile_0026\",\n    \"tiny-town/Tiles/tile_0036\",\n    \"tiny-town/Tiles/tile_0037\",\n    \"tiny-town/Tiles/tile_0038\",\n    \"tiny-town/Tiles/tile_0043\",\n  ]);\n  return !walkableTerrainIds.has(asset.id);\n}\n\nfunction copyJson(data, message) {\n  const text = JSON.stringify(data, null, 2);\n  navigator.clipboard?.writeText(text).then(\n    () => {\n      statusText.textContent = message;\n    },\n    () => {\n      statusText.textContent = text;\n      console.log(text);\n    },\n  );\n}\n\nfunction downloadJson(data, filename) {\n  const blob = new Blob([`${JSON.stringify(data, null, 2)}\\n`], { type: \"application/json\" });\n  const url = URL.createObjectURL(blob);\n  const link = document.createElement(\"a\");\n  link.href = url;\n  link.download = filename;\n  link.click();\n  URL.revokeObjectURL(url);\n}\n\nfunction exportMap() {\n  copyJson(currentEditorMapData(), \"地图编辑器 JSON 已复制到剪贴板。\");\n}\n\nfunction exportGodotMap() {\n  const data = godotMapData();\n  downloadJson(data, \"gamegmeta_godot_map.json\");\n  copyJson(data, \"Godot 地图 JSON 已下载，并复制到剪贴板。\");\n}\n\nfunction playGodotMap() {\n  playEditorMap();\n}\n\nfunction playEditorMap() {\n  const data = godotMapData();\n  const runtimeMaps = {\n    version: 1,\n    maps: [{\n      id: \"current-editor-map\",\n      name: currentSaveName(),\n      data,\n    }],\n  };\n  const serialized = JSON.stringify(data);\n  try {\n    localStorage.setItem(GODOT_EDITOR_MAP_STORAGE_KEY, serialized);\n    localStorage.setItem(GODOT_RUNTIME_MAPS_STORAGE_KEY, JSON.stringify(runtimeMaps));\n  } catch (_error) {\n    // Some embedded browser contexts restrict localStorage; window.name survives same-tab navigation.\n  }\n  try {\n    window.name = serialized;\n  } catch (_error) {\n    // URL hash below remains the primary no-server handoff path.\n  }\n  const encodedMap = encodeURIComponent(serialized);\n  statusText.textContent = `已发送当前地图到 Godot：${data.objects.length} 个上层素材。`;\n  window.location.href = `../exports/web/index.html?map=editor&build=${Date.now()}#map=${encodedMap}`;\n}\n\nfunction playWorldMap() {\n  const worldOverviewData = worldMapDataFromSavedMaps(\"overview\");\n  const worldExploreData = worldMapDataFromSavedMaps(\"explore\");\n  const currentData = godotMapData();\n  const runtimeMaps = godotRuntimeMaps(currentData, { worldOverviewData, worldExploreData });\n  const bootWorldData = {\n    ...worldOverviewData,\n    linkedWorldExploreData: worldExploreData,\n    linkedSourceMaps: worldSourceRuntimeMaps(),\n  };\n  const serialized = JSON.stringify(bootWorldData);\n  try {\n    localStorage.setItem(GODOT_EDITOR_MAP_STORAGE_KEY, serialized);\n    localStorage.setItem(GODOT_RUNTIME_MAPS_STORAGE_KEY, JSON.stringify(runtimeMaps));\n  } catch (_error) {\n    // Some embedded browser contexts restrict localStorage; window.name survives same-tab navigation.\n  }\n  try {\n    window.name = serialized;\n  } catch (_error) {\n    // localStorage above remains the primary handoff path.\n  }\n  const layout = worldOverviewData.worldLayout || {};\n  const count = layout.tiles?.length || 0;\n  statusText.textContent = `已生成世界地图：${count} 张小地图；默认进入缩略方块模式，可切换到大地图模式。`;\n  window.location.href = `../exports/web/index.html?map=world&build=${Date.now()}`;\n}\n\nfunction bindEvents() {\n  document.getElementById(\"playWorldMap\").addEventListener(\"click\", playWorldMap);\n  document.getElementById(\"fillGrass\").addEventListener(\"click\", fillDefaultTerrain);\n  document.getElementById(\"clearMap\").addEventListener(\"click\", clearMap);\n  document.getElementById(\"saveMap\").addEventListener(\"click\", saveCurrentMap);\n"}}
