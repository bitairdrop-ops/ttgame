打开 Web 世界地图；世界地图不再由 Godot 显示。\";\n-  worldMapOverlay.hidden = false;\n-  worldMapSurface.focus();\n-}\n-\n function godotRuntimeMaps(currentData, options = {}) {\n@@\n function playWorldMap() {\n-  renderWebWorldMap();\n+  statusText.textContent = \"正在打开独立 Web 世界地图页面。\";\n+  window.location.href = `./world.html?build=${encodeURIComponent(ASSET_CACHE_KEY)}`;\n }\n \n function bindEvents() {\n   document.getElementById(\"playWorldMap\").addEventListener(\"click\", playWorldMap);\n-  document.getElementById(\"closeWorldMap\").addEventListener(\"click\", closeWorldMap);\n-  worldMapSurface.addEventListener(\"keydown\", (event) => {\n-    const moves = {\n-      ArrowUp: [0, -1],\n-      ArrowDown: [0, 1],\n-      ArrowLeft: [-1, 0],\n-      ArrowRight: [1, 0],\n-      w: [0, -1],\n-      s: [0, 1],\n-      a: [-1, 0],\n-      d: [1, 0],\n-    };\n-    const move = moves[event.key];\n-    if (!move) return;\n-    event.preventDefault();\n-    moveWorldPlayer(move[0], move[1]);\n-  });\n   document.getElementById(\"fillGrass\").addEventListener(\"click\", fillDefaultTerrain);\n*** Add File: /Users/vincet/Documents/aiglass/GameGmeta/web/world.html\n+<!doctype html>\n+<html lang=\"zh-CN\">\n+<head>\n+  <meta charset=\"utf-8\">\n+  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n+  <title>GameGmeta World Map</title>\n+  <link rel=\"stylesheet\" href=\"./styles.css\">\n+</head>\n+<body class=\"world-page\">\n+  <main class=\"world-page-shell\" aria-label=\"GameGmeta world map\">\n+    <header class=\"world-map-topbar\">\n+      <div>\n+        <strong>世界地图</strong>\n+        <span id=\"worldMapMeta\">按保存时间排列地图方块</span>\n+      </div>\n+      <button type=\"button\" id=\"backToEditor\">返回地图编辑器</button>\n+    </header>\n+    <section class=\"world-map-stage\">\n+      <div id=\"worldMapSurface\" class=\"world-map-surface standalone\" tabindex=\"0\" aria-label=\"World map grid\"></div>\n+      <div id=\"worldMapTooltip\" class=\"world-map-tooltip\" hidden></div>\n+    </section>\n+  </main>\n+  <script type=\"module\" src=\"./world.js?v=web-world-page-20260528\"></script>\n+</body>\n+</html>\n*** Add File: /Users/vincet/Documents/aiglass/GameGmeta/web/world.js\n+const SAVED_MAPS_STORAGE_KEY = \"gamegmeta_saved_editor_maps\";\n+const LEGACY_SAVED_MAPS_STORAGE_KEYS = [\"gamegmeta_saved_maps\"];\n+const PENDING_EDITOR_MAP_KEY = \"gamegmeta_pending_editor_map_id\";\n+\n+const worldMapSurface = document.getElementById(\"worldMapSurface\");\n+const worldMapMeta = document.getElementById(\"worldMapMeta\");\n+const worldMapTooltip = document.getElementById(\"worldMapTooltip\");\n+const backToEditor = document.getElementById(\"backToEditor\");\n+\n+let worldPlayerCell = null;\n+let worldLayoutState = null;\n+\n+function savedMaps() {\n+  try {\n+    const parsed = JSON.parse(localStorage.getItem(SAVED_MAPS_STORAGE_KEY) || \"[]\");\n+    if (Array.isArray(parsed) && parsed.length > 0) return parsed;\n+    for (const key of LEGACY_SAVED_MAPS_STORAGE_KEYS) {\n+      const legacy = JSON.parse(localStorage.getItem(key) || \"[]\");\n+      if (Array.isArray(legacy) && legacy.length > 0) return legacy;\n+    }\n+    return [];\n+  } catch (_error) {\n+    return [];\n+  }\n+}\n+\n+function chronologicalSavedMaps() {\n+  return savedMaps().sort((a, b) => {\n+    const left = String(a.createdAt || a.updatedAt || a.id || \"\");\n+    const right = String(b.createdAt || b.updatedAt || b.id || \"\");\n+    return left.localeCompare(right);\n+  });\n+}\n+\n+function worldLandLayout(mapCount) {\n+  let cols = Math.max(24, Math.ceil(Math.sqrt(Math.max(1, mapCount) * 2.2)));\n+  let rows = Math.max(16, Math.ceil(cols * 0.68));\n+  let landCells = [];\n+  while (landCells.length < mapCount) {\n+    landCells = [];\n+    const centerX = (cols - 1) / 2;\n+    const centerY = (rows - 1) / 2;\n+    const radiusX = Math.max(1, cols * 0.42);\n+    const radiusY = Math.max(1, rows * 0.36);\n+    for (let y = 0; y < rows; y += 1) {\n+      for (let x = 0; x < cols; x += 1) {\n+        const dx = (x - centerX) / radiusX;\n+        const dy = (y - centerY) / radiusY;\n+        const bulge = (\n+          Math.sin((x + 1) * 1.7) * 0.13\n+          + Math.cos((y + 2) * 1.3) * 0.10\n+          + Math.sin((x + y) * 0.9) * 0.08\n+        );\n+        if ((dx * dx + dy * dy) < 1.0 + bulge) landCells.push({ x, y });\n+      }\n+    }\n+    if (landCells.length < mapCount) {\n+      cols += 2;\n+      rows += 1;\n+    }\n+  }\n+  return { cols, rows, landCells };\n+}\n+\n+function worldCellKey(x, y) {\n+  return `${x},${y}`;\n+}\n+\n+function showWorldTooltip(event, text) {\n+  worldMapTooltip.textContent = text;\n+  worldMapTooltip.hidden = false;\n+  const stageRect = worldMapSurface.getBoundingClientRect();\n+  worldMapTooltip.style.left = `${event.clientX - stageRect.left + 14}px`;\n+  worldMapTooltip.style.top = `${event.clientY - stageRect.top + 14}px`;\n+}\n+\n+function hideWorldTooltip() {\n+  worldMapTooltip.hidden = true;\n+}\n+\n+function renderWorldPlayer() {\n+  worldMapSurface.querySelector(\".world-player\")?.remove();\n+  if (!worldLayoutState || !worldPlayerCell) return;\n+  const player = document.createElement(\"div\");\n+  player.className = \"world-player\";\n+  player.style.left = `${(worldPlayerCell.x + 0.5) * 100 / worldLayoutState.cols}%`;\n+  player.style.top = `${(worldPlayerCell.y + 0.5) * 100 / worldLayoutState.rows}%`;\n+  worldMapSurface.appendChild(player);\n+}\n+\n+function moveWorldPlayer(dx, dy) {\n+  if (!worldLayoutState || !worldPlayerCell) return;\n+  const next = { x: worldPlayerCell.x + dx, y: worldPlayerCell.y + dy };\n+  if (!worldLayoutState.landKeys.has(worldCellKey(next.x, next.y))) return;\n+  worldPlayerCell = next;\n+  renderWorldPlayer();\n+}\n+\n+function returnToEditor(mapId = \"\") {\n+  if (mapId) {\n+    try {\n+      localStorage.setItem(PENDING_EDITOR_MAP_KEY, mapId);\n+    } catch (_error) {\n+      // Best effort only; editor still opens normally if localStorage is blocked.\n+    }\n+  }\n+  window.location.href = `./index.html?build=from-world-${Date.now()}`;\n+}\n+\n+function renderWebWorldMap() {\n+  const records = chronologicalSavedMaps().filter((record) => record?.data);\n+  const sourceRecords = records.length > 0\n+    ? records\n+    : [{ id: \"\", name: \"当前编辑器地图\", data: null }];\n+  const layout = worldLandLayout(sourceRecords.length);\n+  const landKeys = new Set(layout.landCells.map((cell) => worldCellKey(cell.x, cell.y)));\n+  worldLayoutState = { cols: layout.cols, rows: layout.rows, landKeys };\n+  worldPlayerCell = layout.landCells[0] || { x: 0, y: 0 };\n+\n+  worldMapSurface.innerHTML = \"\";\n+  worldMapSurface.style.setProperty(\"--world-cols\", layout.cols);\n+  worldMapSurface.style.setProperty(\"--world-rows\", layout.rows);\n+\n+  for (let y = 0; y < layout.rows; y += 1) {\n+    for (let x = 0; x < layout.cols; x += 1) {\n+      const cell = document.createElement(\"span\");\n+      cell.className = `world-cell${landKeys.has(worldCellKey(x, y)) ? \" land\" : \" ocean\"}`;\n+      cell.style.left = `${x * 100 / layout.cols}%`;\n+      cell.style.top = `${y * 100 / layout.rows}%`;\n+      cell.style.width = `${100 / layout.cols}%`;\n+      cell.style.height = `${100 / layout.rows}%`;\n+      worldMapSurface.appendChild(cell);\n+    }\n+  }\n+\n+  sourceRecords.forEach((record, index) => {\n+    const cell = layout.landCells[index];\n+    if (!cell) return;\n+    const marker = document.createElement(\"button\");\n+    marker.type = \"button\";\n+    marker.className = \"world-map-marker\";\n+    marker.style.left = `${(cell.x + 0.5) * 100 / layout.cols}%`;\n+    marker.style.top = `${(cell.y + 0.5) * 100 / layout.rows}%`;\n+    const name = record.name || `Map ${index + 1}`;\n+    const label = `坐标 ${cell.x}, ${cell.y} / #${index + 1} / ${name}`;\n+    marker.title = label;\n+    marker.setAttribute(\"aria-label\", label);\n+    marker.addEventListener(\"mouseenter\", (event) => showWorldTooltip(event, label));\n+    marker.addEventListener(\"mousemove\", (event) => showWorldTooltip(event, label));\n+    marker.addEventListener(\"mouseleave\", hideWorldTooltip);\n+    marker.addEventListener(\"click\", () => returnToEditor(record.id || \"\"));\n+    worldMapSurface.appendChild(marker);\n+  });\n+\n+  renderWorldPlayer();\n+  worldMapMeta.textContent = `${sourceRecords.length} 张地图；方向键/WASD 在绿色大陆像素块上移动，海洋不可进入。`;\n+  worldMapSurface.focus();\n+}\n+\n+backToEditor.addEventListener(\"click\", () => returnToEditor());\n+worldMapSurface.addEventListener(\"keydown\", (event) => {\n+  const moves = {\n+    ArrowUp: [0, -1],\n+    ArrowDown: [0, 1],\n+    ArrowLeft: [-1, 0],\n+    ArrowRight: [1, 0],\n+    w: [0, -1],\n+    s: [0, 1],\n+    a: [-1, 0],\n+    d: [1, 0],\n+  };\n+  const move = moves[event.key];\n+  if (!move) return;\n+  event.preventDefault();\n+  moveWorldPlayer(move[0], move[1]);\n+});\n+\n+renderWebWorldMap();\n*** End Patch\n"}}
