切换到大地图模式。`;\nweb/game.js:1287:  document.getElementById(\"playWorldMap\").addEventListener(\"click\", playWorldMap);\nweb/game.js:1295:  document.getElementById(\"playGodotMap\").addEventListener(\"click\", playGodotMap);\nscripts/main.gd:382:\tif launch_mode == \"editor\" and not boot_map.is_empty() and not bool(boot_map.get(\"isWorldMap\", false)):\nscripts/main.gd:388:\t\tif bool(boot_map.get(\"isWorldMap\", false)):\nscripts/main.gd:389:\t\t\truntime_cards.append(_runtime_card_from_data(boot_map, \"World Overview\", \"One square per saved map\", Vector2i(0, 0)))\nscripts/main.gd:390:\t\t\tvar explore_map = boot_map.get(\"linkedWorldExploreData\", {})\nscripts/main.gd:392:\t\t\t\truntime_cards.append(_runtime_card_from_data(explore_map, \"World Explore\", \"1 map visible while walking\", Vector2i(2, 2)))\nscripts/main.gd:401:\t\t\t\tvar source_card := _runtime_card_from_data(source_data, String(source_entry.get(\"name\", \"Map %d\" % [i + 1])), \"World map tile\", Vector2i(2, 2))\nscripts/main.gd:420:\t\t\tif bool(runtime_data.get(\"isWorldMap\", false)):\nscripts/main.gd:421:\t\t\t\tsubtitle = \"World %s mode\" % String(runtime_data.get(\"worldVisualMode\", \"map\"))\nscripts/main.gd:1108:\t\tline.name = \"WorldLongitude_%d\" % x\nscripts/main.gd:1117:\t\tline.name = \"WorldLatitude_%d\" % y\nscripts/main.gd:1140:\t\tarea.name = \"WorldOverviewHit_%d\" % int(tile.get(\"order\", 0))\nscripts/main.gd:1183:\t\tif bool(runtime_data.get(\"isWorldMap\", false)) and String(runtime_data.get(\"worldVisualMode\", \"\")) == \"explore\":\nscripts/main.gd:1929:\treturn bool(runtime_data.get(\"isWorldMap\", false))\nscripts/main.gd:2882:\t\tmode_button.text = \"Explore\" if _is_world_overview_mode() else \"World Map\"\nscripts/main.gd:2889:\t\ttitle.text = \"World Overview\" if _is_world_overview_mode() else \"World Explore\"\nscripts/main.gd:3154:\t\tif typeof(runtime_data) == TYPE_DICTIONARY and bool(runtime_data.get(\"isWorldMap\", false)) and String(runtime_data.get(\"wor