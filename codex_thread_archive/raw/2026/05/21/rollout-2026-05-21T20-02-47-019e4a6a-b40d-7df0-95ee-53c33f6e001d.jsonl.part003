{\n-  return assets.filter((asset) => EDITOR_PACKAGE_PREFIXES.some((prefix) => asset.package.startsWith(prefix)));\n+  return assets.filter((asset) =>\n+    EDITOR_PACKAGE_PREFIXES.some((prefix) => asset.package.startsWith(prefix)) &&\n+    !EDITOR_EXCLUDED_PACKAGES.has(asset.package)\n+  );\n }\n \n function tinyOnlyPackages(packagesList, assets) {\n   const counts = new Map();\n   for (const asset of assets) counts.set(asset.package, (counts.get(asset.package) || 0) + 1);\n   return packagesList\n-    .filter((pack) => EDITOR_PACKAGE_PREFIXES.some((prefix) => pack.name.startsWith(prefix)) && counts.has(pack.name))\n+    .filter((pack) =>\n+      EDITOR_PACKAGE_PREFIXES.some((prefix) => pack.name.startsWith(prefix)) &&\n+      counts.has(pack.name) &&\n+      !EDITOR_EXCLUDED_PACKAGES.has(pack.name)\n+    )\n     .map((pack) => ({ ...pack, count: counts.get(pack.name) }));\n }\n \n@@ -359,6 +372,8 @@ function clearMap() {\n   fillDefaultTerrain();\n   stamps.length = 0;\n   selectedStampId = null;\n+  currentMapName = \"\";\n+  mapNameInput.value = \"\";\n   renderStamps();\n   statusText.textContent = \"已清除之前的地图内容。\";\n }\n@@ -420,6 +435,8 @@ function applyMapData(data, label = \"Demo\") {\n \n   renderTerrain();\n   renderStamps();\n+  currentMapName = label;\n+  mapNameInput.value = label;\n   statusText.textContent = `已加载 ${label} 地图：${COLS} x ${ROWS}，所有素材已叠加在草地底层之上。`;\n }\n \n@@ -436,11 +453,126 @@ function currentEditorMapData() {\n     cols: COLS,\n     rows: ROWS,\n     cell: CELL,\n-    terrain,\n+    name: currentMapName,\n+    terrain: terrain.map((row) => [...row]),\n     stamps: stamps.map((stamp) => ({ ...stamp })),\n   };\n }\n \n+function savedMaps() {\n+  try {\n+    const parsed = JSON.parse(localStorage.getItem(SAVED_MAPS_STORAGE_KEY) || \"[]\");\n+    if (Array.isArray(parsed) && parsed.length > 0) return parsed;\n+    for (const key of LEGACY_SAVED_MAPS_STORAGE_KEYS) {\n+      const legacy = JSON.parse(localStorage.getItem(key) || \"[]\");\n+      if (Array.isArray(legacy) && legacy.length > 0) return legacy;\n+    }\n+    return [];\n+  } catch (_error) {\n+    return [];\n+  }\n+}\n+\n+function writeSavedMaps(maps) {\n+  try {\n+    localStorage.setItem(SAVED_MAPS_STORAGE_KEY, JSON.stringify(maps));\n+    return true;\n+  } catch (_error) {\n+    return false;\n+  }\n+}\n+\n+function mapTimestampLabel(date = new Date()) {\n+  const pad = (value) => String(value).padStart(2, \"0\");\n+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;\n+}\n+\n+function renderSavedMaps(selectedId = savedMapSelect.value) {\n+  const maps = savedMaps().sort((a, b) => String(b.updatedAt || \"\").localeCompare(String(a.updatedAt || \"\")));\n+  savedMapSelect.innerHTML = \"\";\n+  if (maps.length === 0) {\n+    const option = document.createElement(\"option\");\n+    option.value = \"\";\n+    option.textContent = \"暂无保存地图\";\n+    savedMapSelect.appendChild(option);\n+    return;\n+  }\n+\n+  for (const item of maps) {\n+    const option = document.createElement(\"option\");\n+    option.value = item.id;\n+    option.textContent = item.name;\n+    savedMapSelect.appendChild(option);\n+  }\n+  if (selectedId && maps.some((item) => item.id === selectedId)) {\n+    savedMapSelect.value = selectedId;\n+  }\n+}\n+\n+function currentSaveName() {\n+  const typedName = mapNameInput.value.trim();\n+  if (typedName) return typedName;\n+  if (currentMapName && currentMapName !== \"Demo\") return currentMapName;\n+  return `未命名地图 ${mapTimestampLabel()}`;\n+}\n+\n+function saveCurrentMap() {\n+  const name = currentSaveName();\n+  const now = new Date().toISOString();\n+  const data = { ...currentEditorMapData(), name };\n+  const maps = savedMaps();\n+  const existingIndex = maps.findIndex((item) => item.name === name);\n+  const existingId = existingIndex >= 0 ? maps[existingIndex].id : null;\n+  const record = {\n+    id: existingId || `map-${Date.now()}`,\n+    name,\n+    updatedAt: now,\n+    stampCount: stamps.length,\n+    data,\n+  };\n+  if (existingIndex >= 0) {\n+    maps[existingIndex] = record;\n+  } else {\n+    maps.push(record);\n+  }\n+  if (!writeSavedMaps(maps)) {\n+    statusText.textContent = \"保存失败：当前浏览器不允许写入本地存储。请使用 http://127.0.0.1:8794/web/index.html 打开编辑器。\";\n+    return;\n+  }\n+  currentMapName = name;\n+  mapNameInput.value = name;\n+  renderSavedMaps(record.id);\n+  statusText.textContent = `已保存地图「${name}」。每个不同名称会成为“我的地图”中的一个新地图。`;\n+}\n+\n+function openSavedMap() {\n+  const id = savedMapSelect.value;\n+  const record = savedMaps().find((item) => item.id === id);\n+  if (!record) {\n+    statusText.textContent = \"没有可打开的保存地图。\";\n+    return;\n+  }\n+  applyMapData(record.data, record.name);\n+  renderSavedMaps(record.id);\n+  statusText.textContent = `已打开保存地图「${record.name}」，可以继续编辑。`;\n+}\n+\n+function deleteSavedMap() {\n+  const id = savedMapSelect.value;\n+  const record = savedMaps().find((item) => item.id === id);\n+  if (!record) {\n+    statusText.textContent = \"没有可删除的保存地图。\";\n+    return;\n+  }\n+  const maps = savedMaps().filter((item) => item.id !== id);\n+  if (!writeSavedMaps(maps)) {\n+    statusText.textContent = \"删除失败：当前浏览器不允许写入本地存储。\";\n+    return;\n+  }\n+  renderSavedMaps();\n+  statusText.textContent = `已删除保存地图「${record.name}」。`;\n+}\n+\n function stampTexturePath(stamp) {\n   const asset = assetById(stamp.assetId);\n   return asset?.file ? `res://${asset.file}` : \"\";\n@@ -556,14 +688,22 @@ function bindEvents() {\n   });\n   document.getElementById(\"fillGrass\").addEventListener(\"click\", fillDefaultTerrain);\n   document.getElementById(\"clearMap\").addEventListener(\"click\", clearMap);\n+  document.getElementById(\"saveMap\").addEventListener(\"click\", saveCurrentMap);\n+  document.getElementById(\"openSavedMap\").addEventListener(\"click\", openSavedMap);\n+  document.getElementById(\"deleteSavedMap\").addEventListener(\"click\", deleteSavedMap);\n   document.getElementById(\"exportMap\").addEventListener(\"click\", exportMap);\n   document.getElementById(\"exportGodotMap\").addEventListener(\"click\", exportGodotMap);\n   document.getElementById(\"playGodotMap\").addEventListener(\"click\", playGodotMap);\n   assetSearch.addEventListener(\"input\", renderAssetList);\n   packageSelect.addEventListener(\"change\", () => {\n     activePackage = packageSelect.value;\n+    activeCategory = \"全部\";\n+    buildCategories();\n     renderAssetList();\n   });\n+  savedMapSelect.addEventListener(\"change\", () => {\n+    if (savedMapSelect.value) openSavedMap();\n+  });\n \n   window.addEventListener(\"keydown\", (event) => {\n     if (event.key === \"Delete\" && selectedStampId != null) {\n@@ -591,12 +731,13 @@ async function loadLibrary() {\n   ASSETS = tinyOnlyAssets(manifest.assets || []);\n   PACKAGES = tinyOnlyPackages(manifest.packages || [], ASSETS);\n   if (!PACKAGES.some((pack) => pack.name === activePackage)) activePackage = PACKAGES[0]?.name || \"全部\";\n-  assetLibraryMeta.textContent = `Tiny 与收藏素材 ${ASSETS.length} 个 / ${PACKAGES.length} 个素材包`;\n+  assetLibraryMeta.textContent = `Tiny、AI tiny 与收藏素材 ${ASSETS.length} 个 / ${PACKAGES.length} 个素材包`;\n   selectedAsset = defaultTile();\n }\n \n async function start() {\n   bindEvents();\n+  renderSavedMaps();\n   buildBoard();\n   await loadLibrary();\n   buildPackageSelect();\ndiff --git a/web/index.html b/web/index.html\nindex 66f571a..ecb8990 100644\n--- a/web/index.html\n+++ b/web/index.html\n@@ -35,6 +35,15 @@\n             <span>32px 网格</span>\n           </div>\n         </div>\n+        <div class=\"saved-map-bar\" aria-label=\"Saved maps\">\n+          <label for=\"mapNameInput\">地图名称</label>\n+          <input id=\"mapNameInput\" type=\"text\" placeholder=\"输入地图名\">\n+          <button type=\"button\" id=\"saveMap\">保存地图</button>\n+          <label for=\"savedMapSelect\">我的地图</label>\n+          <select id=\"savedMapSelect\" aria-label=\"我的地图列表\"></select>