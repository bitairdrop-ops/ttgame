prite)\n\n\tcamera = Camera2D.new()\n\tcamera.name = \"FollowCamera\"\n\tcamera.zoom = Vector2.ONE if current_map.id == MAP_EDITOR_JSON else Vector2(1.6, 1.6)\n\tcamera.position_smoothing_enabled = true\n\tcamera.position_smoothing_speed = 7.5\n\tcamera.limit_left = 0\n\tcamera.limit_top = 0\n\tcamera.limit_right = active_map_w * active_cell_px\n\tcamera.limit_bottom = active_map_h * active_cell_px\n\tplayer.add_child(camera)\n\tcamera.make_current()\n\nfunc _create_character_frames() -> SpriteFrames:\n\tvar frames := SpriteFrames.new()\n\tfor anim in [\"idle_down\", \"idle_up\", \"idle_right\", \"idle_left\", \"walk_down\", \"walk_up\", \"walk_right\", \"walk_left\"]:\n\t\tframes.add_animation(anim)\n\t\tframes.set_animation_speed(anim, 8.0)\n"}}
