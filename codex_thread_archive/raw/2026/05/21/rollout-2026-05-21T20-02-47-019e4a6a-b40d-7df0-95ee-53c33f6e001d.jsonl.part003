e(\"walk_down\", _puny_frame(Vector2i(col, 0)))\n-\t\tframes.add_frame(\"walk_left\", _puny_frame(Vector2i(col, 2)))\n-\t\tframes.add_frame(\"walk_right\", _puny_frame(Vector2i(col, 3)))\n+\t\tframes.add_frame(\"walk_left\", _puny_frame(Vector2i(col, 6)))\n+\t\tframes.add_frame(\"walk_right\", _puny_frame(Vector2i(col, 2)))\n \t\tframes.add_frame(\"walk_up\", _puny_frame(Vector2i(col, 4)))\n \treturn frames\n \n@@ -1254,10 +1255,60 @@ func _texture(path: String) -> Texture2D:\n \tvar err := image.load(ProjectSettings.globalize_path(path))\n \tvar texture: Texture2D = null\n \tif err == OK:\n+\t\t_normalize_texture_alpha(path, image)\n \t\ttexture = ImageTexture.create_from_image(image)\n \telse:\n \t\ttexture = load(path) as Texture2D\n \t\tif texture == null:\n \t\t\tpush_error(\"Missing texture: \" + path)\n+\t\telif _needs_edge_alpha_cleanup(path):\n+\t\t\tvar imported_image := texture.get_image()\n+\t\t\tif imported_image != null and not imported_image.is_empty():\n+\t\t\t\t_normalize_texture_alpha(path, imported_image)\n+\t\t\t\ttexture = ImageTexture.create_from_image(imported_image)\n \tatlas_cache[path] = texture\n \treturn texture\n+\n+func _needs_edge_alpha_cleanup(path: String) -> bool:\n+\treturn path.find(\"tiny-creatures/\") != -1 or path.find(\"favorite-tiny-creatures/\") != -1\n+\n+func _normalize_texture_alpha(path: String, image: Image) -> void:\n+\tif not _needs_edge_alpha_cleanup(path) or image.is_empty():\n+\t\treturn\n+\tif image.get_format() != Image.FORMAT_RGBA8:\n+\t\timage.convert(Image.FORMAT_RGBA8)\n+\t_make_edge_dark_pixels_transparent(image)\n+\n+func _make_edge_dark_pixels_transparent(image: Image) -> void:\n+\tvar width := image.get_width()\n+\tvar height := image.get_height()\n+\tif width <= 0 or height <= 0:\n+\t\treturn\n+\n+\tvar pending: Array[Vector2i] = []\n+\tvar visited := {}\n+\tfor x in range(width):\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(x, 0))\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(x, height - 1))\n+\tfor y in range(height):\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(0, y))\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(width - 1, y))\n+\n+\twhile not pending.is_empty():\n+\t\tvar point: Vector2i = pending.pop_back()\n+\t\timage.set_pixel(point.x, point.y, Color(0, 0, 0, 0))\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(point.x + 1, point.y))\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(point.x - 1, point.y))\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(point.x, point.y + 1))\n+\t\t_queue_dark_pixel(image, pending, visited, Vector2i(point.x, point.y - 1))\n+\n+func _queue_dark_pixel(image: Image, pending: Array[Vector2i], visited: Dictionary, point: Vector2i) -> void:\n+\tif point.x < 0 or point.y < 0 or point.x >= image.get_width() or point.y >= image.get_height():\n+\t\treturn\n+\tvar key := \"%d,%d\" % [point.x, point.y]\n+\tif visited.has(key):\n+\t\treturn\n+\tvisited[key] = true\n+\tvar color := image.get_pixel(point.x, point.y)\n+\tif color.a > 0.0 and color.r <= 0.32 and color.g <= 0.32 and color.b <= 0.32 and color.r + color.g + color.b <= 0.72:\n+\t\tpending.append(point)\n"}}
