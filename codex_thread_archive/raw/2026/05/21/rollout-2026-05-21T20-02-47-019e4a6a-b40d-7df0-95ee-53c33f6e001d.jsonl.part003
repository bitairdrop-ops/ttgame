{"timestamp":"2026-05-26T13:18:49.860Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_0aJTEo5NxCqLYlg5Ys1SZLjE","output":"Chunk ID: 8989fa\nWall time: 0.2222 seconds\nProcess exited with code 0\nOriginal token count: 731\nOutput:\n}\n\nfunction savedMaps() {\n  try {\n    const parsed = JSON.parse(localStorage.getItem(SAVED_MAPS_STORAGE_KEY) || \"[]\");\n    if (Array.isArray(parsed) && parsed.length > 0) return parsed;\n    for (const key of LEGACY_SAVED_MAPS_STORAGE_KEYS) {\n      const legacy = JSON.parse(localStorage.getItem(key) || \"[]\");\n      if (Array.isArray(legacy) && legacy.length > 0) return legacy;\n    }\n    return [];\n  } catch (_error) {\n    return [];\n  }\n}\n\nfunction writeSavedMaps(maps) {\n  try {\n    localStorage.setItem(SAVED_MAPS_STORAGE_KEY, JSON.stringify(maps));\n    return true;\n  } catch (_error) {\n    return false;\n  }\n}\n\nfunction mapTimestampLabel(date = new Date()) {\n  const pad = (value) => String(value).padStart(2, \"0\");\n  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;\n}\n\nfunction renderSavedMaps(selectedId = savedMapSelect.value) {\n  const maps = savedMaps().sort((a, b) => String(b.updatedAt || \"\").localeCompare(String(a.updatedAt || \"\")));\n  savedMapSelect.innerHTML = \"\";\n  if (maps.length === 0) {\n    const option = document.createElement(\"option\");\n    option.value = \"\";\n    option.textContent = \"暂无保存地图\";\n    savedMapSelect.appendChild(option);\n    return;\n  }\n\n  for (const item of maps) {\n    const option = document.createElement(\"option\");\n    option.value = item.id;\n    option.textContent = item.name;\n    savedMapSelect.appendChild(option);\n  }\n  if (selectedId && maps.some((item) => item.id === selectedId)) {\n    savedMapSelect.value = selectedId;\n  }\n}\n\nfunction currentSaveName() {\n  const typedName = mapNameInput.value.trim();\n  if (typedName) return typedName;\n  if (currentMapName && currentMapName !== \"Demo\") return currentMapName;\n  return `未命名地图 ${mapTimestampLabel()}`;\n}\n\nfunction saveCurrentMap() {\n  const name = currentSaveName();\n  const now = new Date().toISOString();\n  const data = { ...currentEditorMapData(), name };\n  const maps = savedMaps();\n  const existingIndex = maps.findIndex((item) => item.name === name);\n  const existingId = existingIndex >= 0 ? maps[existingIndex].id : null;\n  const record = {\n    id: existingId || `map-${Date.now()}`,\n    name,\n    updatedAt: now,\n    stampCount: stamps.length,\n    data,\n  };\n  if (existingIndex >= 0) {\n    maps[existingIndex] = record;\n  } else {\n    maps.push(record);\n  }\n  if (!writeSavedMaps(maps)) {\n    statusText.textContent = \"保存失败：当前浏览器不允许写入本地存储。请使用 http://127.0.0.1:8794/web/index.html 打开编辑器。\";\n    return;\n  }\n  currentMapName = name;\n  mapNameInput.value = name;\n  renderSavedMaps(record.id);\n  statusText.textContent = `已保存地图「${name}」。每个不同名称会成为“我的地图”中的一个新地图。`;\n}\n\nfunction openSavedMap() {\n  const id = savedMapSelect.value;\n  const record = savedMaps().find((item) => item.id === id);\n"}}
