\tplayer.velocity = direction * PLAYER_SPEED\n\tplayer.move_and_slide()\n\t_update_character_animation(direction)\n\nfunc _unhandled_input(event: InputEvent) -> void:\n\tif event.is_action_pressed(\"ui_cancel\") and player != null:\n\t\t_load_map(0)\n\nfunc _input(event: InputEvent) -> void:\n\tif ui_layer == null or ui_layer.name != \"MapCardMenu\":\n\t\treturn\n\tif event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:\n\t\tvar chosen := _card_index_at(event.position)\n\t\tif chosen >= 0:\n\t\t\t_load_map(chosen)\n\tif event is InputEventKey and event.pressed:\n\t\tvar key_index: int = event.keycode - KEY_1\n\t\tif key_index >= 0 and key_index < map_cards.size():\n\t\t\t_load_map(key_index)\n\nfunc _card_index_at(pos: Vector2) -> int:\n\tvar card_w := 224\n\tvar card_h := 252\n\tvar gap := 18\n\tfor i in map_cards.size():\n\t\tvar rect := Rect2(Vector2(48 + i * (card_w + gap), 142), Vector2(card_w, card_h))\n\t\tif rect.has_point(pos):\n\t\t\treturn i\n\treturn -1\n\nfunc _show_map_cards() -> void:\n\t_clear_scene()\n\tui_layer = CanvasLayer.new()\n\tui_layer.name = \"MapCardMenu\"\n\tadd_child(ui_layer)\n\n\tvar bg := ColorRect.new()\n\tbg.color = Color(0.08, 0.1, 0.12)\n\tbg.size = Vector2(1280, 720)\n\tui_layer.add_child(bg)\n\n\tvar title := Label.new()\n\ttitle.text = \"GameGmeta TileSet Maps\"\n"}}
