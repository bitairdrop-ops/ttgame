{"timestamp":"2026-05-26T08:34:00.865Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_aD0a01wTph7qix2kzwRA8NSy","output":"Chunk ID: a5662c\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 2405\nOutput:\n\nboard.addEventListener(\"drop\", (event) => {\n  event.preventDefault();\n  const rect = board.getBoundingClientRect();\n  const x = Math.floor((event.clientX - rect.left) / CELL);\n  const y = Math.floor((event.clientY - rect.top) / CELL);\n  if (x < 0 || y < 0 || x >= COLS || y >= ROWS) return;\n\n  const stampId = Number(event.dataTransfer.getData(\"application/x-stamp-id\"));\n  if (stampId) {\n    const stamp = stamps.find((item) => item.id === stampId);\n    if (!stamp) return;\n    const asset = assetById(stamp.assetId);\n    if (!asset) return;\n    const origin = clampOrigin(asset, x, y);\n    const removed = removeOverlappingStamps({\n      x: origin.x,\n      y: origin.y,\n      w: Math.max(1, stamp.w),\n      h: Math.max(1, stamp.h),\n    }, stamp.id);\n    stamp.x = origin.x;\n    stamp.y = origin.y;\n    selectedStampId = stamp.id;\n    renderStamps();\n    statusText.textContent = removed > 0\n      ? `已移动 ${asset.name}，并替换 ${removed} 个上层素材：${origin.x}, ${origin.y}`\n      : `已移动 ${asset.name}：${origin.x}, ${origin.y}`;\n    return;\n  }\n\n  const asset = assetById(event.dataTransfer.getData(\"text/plain\"));\n  if (asset) placeAsset(asset, x, y);\n});\n\nfunction fillDefaultTerrain() {\n  const asset = defaultTile();\n  for (let y = 0; y < ROWS; y += 1) {\n    for (let x = 0; x < COLS; x += 1) {\n      terrain[y][x] = asset?.id || null;\n    }\n  }\n  renderTerrain();\n  statusText.textContent = `已将地图版面铺满 ${asset?.name || \"默认地块\"}。`;\n}\n\nfunction clearMap() {\n  fillDefaultTerrain();\n  stamps.length = 0;\n  selectedStampId = null;\n  renderStamps();\n  statusText.textContent = \"已清除之前的地图内容。\";\n}\n\nfunction normalizeTerrainCell(cell) {\n  if (typeof cell === \"string\") return cell;\n  if (cell && typeof cell === \"object\") return cell.assetId || null;\n  return null;\n}\n\nfunction applyMapData(data, label = \"Demo\") {\n  const sourceTerrain = Array.isArray(data.terrain) ? data.terrain : [];\n  const groundId = defaultTile()?.id || null;\n  for (let y = 0; y < ROWS; y += 1) {\n    for (let x = 0; x < COLS; x += 1) {\n      terrain[y][x] = groundId;\n    }\n  }\n\n  stamps.length = 0;\n  selectedStampId = null;\n  for (let y = 0; y < ROWS; y += 1) {\n    const row = Array.isArray(sourceTerrain[y]) ? sourceTerrain[y] : [];\n    for (let x = 0; x < COLS; x += 1) {\n      const assetId = normalizeTerrainCell(row[x]);\n      const asset = assetId ? assetById(assetId) : null;\n      if (!asset || asset.id === groundId) continue;\n      stamps.push({\n        id: stampSeq,\n        assetId: asset.id,\n        x,\n        y,\n        w: Math.max(1, Math.min(asset.w || 1, COLS)),\n        h: Math.max(1, Math.min(asset.h || 1, ROWS)),\n        blocking: isBlockingAsset(asset),\n      });\n      stampSeq += 1;\n    }\n  }\n\n  const sourceStamps = Array.isArray(data.stamps) ? data.stamps : [];\n  const sourceObjects = Array.isArray(data.objects) ? data.objects : [];\n  const overlayItems = [...sourceStamps, ...sourceObjects];\n  for (const source of overlayItems) {\n    const asset = source.assetId ? assetById(source.assetId) : null;\n    if (!asset) continue;\n    const origin = clampOrigin(asset, Number(source.x) || 0, Number(source.y) || 0);\n    stamps.push({\n      id: stampSeq,\n      assetId: asset.id,\n      x: origin.x,\n      y: origin.y,\n      w: Math.max(1, Math.min(Number(source.w) || asset.w, COLS)),\n      h: Math.max(1, Math.min(Number(source.h) || asset.h, ROWS)),\n      blocking: source.blocking == null ? isBlockingAsset(asset) : Boolean(source.blocking),\n    });\n    stampSeq += 1;\n  }\n\n  renderTerrain();\n  renderStamps();\n  statusText.textContent = `已加载 ${label} 地图：${COLS} x ${ROWS}，所有素材已叠加在草地底层之上。`;\n}\n\nasync function loadDemoMap() {\n  const response = await fetch(DEMO_MAP_URL);\n  if (!response.ok) throw new Error(`无法读取 demo map: ${response.status}`);\n  const data = await response.json();\n  applyMapData(data, \"Demo\");\n}\n\nfunction currentEditorMapData() {\n  return {\n    assetLibrary: MANIFEST_URL,\n    cols: COLS,\n    rows: ROWS,\n    cell: CELL,\n    terrain,\n    stamps: stamps.map((stamp) => ({ ...stamp })),\n  };\n}\n\nfunction stampTexturePath(stamp) {\n  const asset = assetById(stamp.assetId);\n  return asset?.file ? `res://${asset.file}` : \"\";\n}\n\nfunction godotMapData() {\n  const groundId = defaultTile()?.id || GROUND_ASSET_ID;\n  return {\n    format: \"GameGmetaGodotMap\",\n    version: 1,\n    cols: COLS,\n    rows: ROWS,\n    cell: CELL,\n    terrain: terrain.map((row) => row.map(() => {\n      const asset = assetById(groundId);\n      return {\n        assetId: groundId,\n        texture: asset?.file ? `res://${asset.file}` : \"\",\n        blocking: false,\n      };\n    })),\n    objects: stamps.map((stamp) => ({\n      id: stamp.id,\n      assetId: stamp.assetId || null,\n      texture: stampTexturePath(stamp),\n      x: stamp.x,\n      y: stamp.y,\n      w: stamp.w,\n      h: stamp.h,\n      blocking: Boolean(stamp.blocking),\n      z: 6,\n    })),\n  };\n}\n\nfunction isBlockingAsset(asset) {\n  if (!asset || asset.id === GROUND_ASSET_ID) return false;\n  if (asset.mode !== \"tile\") return true;\n  const walkableTerrainIds = new Set([\n    \"tiny-town/Tiles/tile_0000\",\n    \"tiny-town/Tiles/tile_0001\",\n    \"tiny-town/Tiles/tile_0002\",\n    \"tiny-town/Tiles/tile_0012\",\n    \"tiny-town/Tiles/tile_0013\",\n    \"tiny-town/Tiles/tile_0014\",\n    \"tiny-town/Tiles/tile_0024\",\n    \"tiny-town/Tiles/tile_0026\",\n    \"tiny-town/Tiles/tile_0036\",\n    \"tiny-town/Tiles/tile_0037\",\n    \"tiny-town/Tiles/tile_0038\",\n    \"tiny-town/Tiles/tile_0043\",\n  ]);\n  return !walkableTerrainIds.has(asset.id);\n}\n\nfunction copyJson(data, message) {\n  const text = JSON.stringify(data, null, 2);\n  navigator.clipboard?.writeText(text).then(\n    () => {\n      statusText.textContent = message;\n    },\n    () => {\n      statusText.textContent = text;\n      console.log(text);\n    },\n  );\n}\n\nfunction downloadJson(data, filename) {\n  const blob = new Blob([`${JSON.stringify(data, null, 2)}\\n`], { type: \"application/json\" });\n  const url = URL.createObjectURL(blob);\n  const link = document.createElement(\"a\");\n  link.href = url;\n  link.download = filename;\n  link.click();\n  URL.revokeObjectURL(url);\n}\n\nfunction exportMap() {\n  copyJson(currentEditorMapData(), \"地图编辑器 JSON 已复制到剪贴板。\");\n}\n\nfunction exportGodotMap() {\n  const data = godotMapData();\n  downloadJson(data, \"gamegmeta_godot_map.json\");\n  copyJson(data, \"Godot 地图 JSON 已下载，并复制到剪贴板。\");\n}\n\nfunction playGodotMap() {\n  const data = godotMapData();\n  const serialized = JSON.stringify(data);\n  try {\n    localStorage.setItem(GODOT_EDITOR_MAP_STORAGE_KEY, serialized);\n  } catch (_error) {\n    // Some embedded browser contexts restrict localStorage; window.name survives same-tab navigation.\n  }\n  try {\n    window.name = serialized;\n  } catch (_error) {\n    // URL hash below remains the primary no-server handoff path.\n  }\n  const encodedMap = encodeURIComponent(serialized);\n  statusText.textContent = `已发送当前地图到 Godot：${data.objects.length} 个上层素材。`;\n  window.location.href = `../exports/web/index.html?map=editor&build=${Date.now()}#map=${encodedMap}`;\n}\n\nfunction bindEvents() {\n  document.getElementById(\"loadDemo\").addEventListener(\"click\", () => {\n    loadDemoMap().catch((error) => {\n      console.error(error);\n      statusText.textContent = `Demo 加载失败：${error.message}`;\n    });\n  });\n  document.getElementById(\"fillGrass\").addEventListener(\"click\", fillDefaultTerrain);\n  document.getElementById(\"clearMap\").addEventListener(\"click\", clearMap);\n  document.getElementById(\"exportMap\").addEventListener(\"click\", exportMap);\n  document.getElementById(\"exportGodotMap\").addEventListener(\"click\", exportGodotMap);\n  document.getElementById(\"playGodotMap\").addEventListener(\"click\", playGodotMap);\n  assetSearch.addEventListener(\"input\", renderAssetList);\n  packageSelect.addEventListener(\"change\", () => {\n    activePackage = packageSelect.value;\n    activeCategory = \"全部\";\n    buildCategories();\n    renderAssetList();\n  });\n\n  window.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"Delete\" && selectedStampId != null) {\n      const index = stamps.findIndex((stamp) => stamp.id === selectedStampId);\n      if (index >= 0) {\n        const asset = assetById(stamps[index].assetId);\n        stamps.splice(index, 1);\n        selectedStampId = null;\n        renderStamps();\n        statusText.textContent = `已删除 ${asset.name}。`;\n      }\n    }\n    if (event.key === \"Escape\") {\n      selectedStampId = null;\n      renderStamps();\n      statusText.textContent = \"已取消选择。\";\n    }\n  });\n}\n\nasync function loadLibrary() {\n  const response = await fetch(MANIFEST_URL);\n  if (!response.ok) throw new Error(`无法读取 Kenney manifest: ${response.status}`);\n  const manifest = await response.json();\n  ASSETS = tinyOnlyAssets(manifest.assets || []);\n  PACKAGES = tinyOnlyPackages(manifest.packages || [], ASSETS);\n  if (!PACKAGES.some((pack) => pack.name === activePackage)) activePackage = PACKAGES[0]?.name || \"全部\";\n  assetLibraryMeta.textContent = `Tiny、AI tiny 与收藏素材 ${ASSETS.length} 个 / ${PACKAGES.length} 个素材包`;\n  selectedAsset = defaultTile();\n}\n\nasync function start() {\n  bindEvents();\n  buildBoard();\n  await loadLibrary();\n  buildPackageSelect();\n  buildCategories();\n  fillDefaultTerrain();\n  renderAssetList();\n  if (selectedAsset) selectAsset(selectedAsset);\n  await loadDemoMap();\n}\n\nstart().catch((error) => {\n  console.error(error);\n  statusText.textContent = `素材库加载失败：${error.message}`;\n});\n"}}
