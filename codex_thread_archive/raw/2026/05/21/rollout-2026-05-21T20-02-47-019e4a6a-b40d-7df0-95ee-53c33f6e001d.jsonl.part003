a();\n+  const runtimeMaps = godotRuntimeMaps(data);\n   const serialized = JSON.stringify(data);\n@@ -908,2 +931,3 @@\n     localStorage.setItem(GODOT_EDITOR_MAP_STORAGE_KEY, serialized);\n+    localStorage.setItem(GODOT_RUNTIME_MAPS_STORAGE_KEY, JSON.stringify(runtimeMaps));\n   } catch (_error) {\n","move_path":null}},"status":"completed"}}
