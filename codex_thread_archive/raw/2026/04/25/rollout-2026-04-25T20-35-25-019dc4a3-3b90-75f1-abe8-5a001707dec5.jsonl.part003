er: false, createdAt: Date())\n   184\t    ]\n   185\t    @Published var showCalendar = false\n   186\t    @Published var selectedMoodDate = Date()\n   187\t\n   188\t    private var player: AVAudioPlayer?\n   189\t    private var promptBank: [PromptSeed] = []\n   190\t\n   191\t    var filteredTracks: [MusicTrack] {\n   192\t        switch scope {\n   193\t        case .all: return tracks\n   194\t        case .instrumental: return tracks.filter { $0.mode == .instrumental }\n   195\t        case .song: return tracks.filter { $0.mode == .song }\n   196\t        case .myMuse: return tracks.filter { $0.isGenerated }\n   197\t        case .favorite: return tracks.filter { $0.isFavorite }\n   198\t        }\n   199\t    }\n   200\t\n   201\t    var currentTrack: MusicTrack? {\n   202\t        let list = filteredTracks\n   203\t        guard !list.isEmpty else { return nil }\n   204\t        return list[min(currentIndex, list.count - 1)]\n   205\t    }\n   206\t\n   207\t    func load() {\n   208\t        loadPromptBank()\n   209\t        loadSeedMusic()\n   210\t        randomPrompt(keepingMode: true)\n   211\t        configureAudioSession()\n   212\t    }\n   213\t\n   214\t    func setScope(_ value: FeedScope) {\n   215\t        scope = value\n   216\t        currentIndex = 0\n   217\t        if isPlaying { playCurrent() }\n   218\t    }\n   219\t\n   220\t    func togglePlay() {\n   221\t        isPlaying ? pause() : playCurrent()\n   222\t    }\n   223\t\n   224\t    func playCurrent() {\n   225\t        guard let track = currentTrack, let url = playableURL(for: track) else { return }\n   226\t        do {\n   227\t            if player?.url != url {\n   228\t                player = try AVAudioPlayer(contentsOf: url)\n   229\t                player?.delegate = self\n   230\t                player?.prepareToPlay()\n   231\t            }\n   232\t            player?.volume = volume\n   233\t            player?.play()\n   234\t            isPlaying = true\n   235\t        } catch {\n   236\t            isPlaying = false\n   237\t        }\n   238\t    }\n   239\t\n   240\t    func pause() {\n   241\t        player?.pause()\n   242\t        isPlaying = false\n   243\t    }\n   244\t\n   245\t    func nextTrack() {\n   246\t        let count = filteredTracks.count\n   247\t        guard count > 0 else { return }\n   248\t        if playbackMode == .shuffle {\n   249\t            currentIndex = randomDifferentIndex(count: count)\n   250\t        } else {\n   251\t            currentIndex = (currentIndex + 1) % count\n   252\t        }\n   253\t        if isPlaying { playCurrent() }\n   254\t    }\n   255\t\n   256\t    func previousTrack() {\n   257\t        let count = filteredTracks.count\n   258\t        guard count > 0 else { return }\n   259\t        currentIndex = (currentIndex - 1 + count) % count\n   260\t        if isPlaying { playCurrent() }\n   261\t    }\n   262\t\n   263\t    func toggleFavorite() {\n   264\t        guard let current = currentTrack, let index = tracks.firstIndex(where: { $0.id == current.id }) else { return }\n   265\t        tracks[index].isFavorite.toggle()\n   266\t    }\n   267\t\n   268\t    func cyclePlaybackMode() {\n   269\t        playbackMode = playbackMode.next()\n   270\t    }\n   271\t\n   272\t    func updateProgress() {\n   273\t        guard let player, player.duration > 0 else {\n   274\t            progress = 0\n   275\t            return\n   276\t        }\n   277\t        progress = min(1, max(0, player.currentTime / player.duration))\n   278\t    }\n   279\t\n   280\t    func randomPrompt(keepingMode: Bool = false) {\n   281\t        let mode = keepingMode ? createMode : (Bool.random() ? .instrumental : .song)\n   282\t        let candidates = promptBank.filter { ($0.mode ?? mode) == mode }\n   283\t        let seed = candidates.randomElement() ?? promptBank.randomElement()\n   284\t        createMode = mode\n   285\t        createTitle = seed?.title ?? \"New Muse Track\"\n   286\t        createPrompt = seed?.prompt ?? \"Polished emotional music, memorable theme, rich texture, modern mix.\"\n   287\t        if mode == .song {\n   288\t            lyrics = defaultLyrics(title: createTitle)\n   289\t        }\n   290\t        generationError = nil\n   291\t    }\n   292\t\n   293\t    func generateFromCreate() {\n   294\t        generate(title: createTitle, prompt: createPrompt, lyrics: lyrics, mode: createMode)\n   295\t    }\n   296\t\n   297\t    func retryCreateGeneration() {\n   298\t        generateFromCreate()\n   299\t    }\n   300\t\n   301\t    func switchCreateToInstrumental() {\n   302\t        createMode = .instrumental\n   303\t        if !createPrompt.localizedCaseInsensitiveContains(\"no vocals\") {\n   304\t            createPrompt += \", no vocals\"\n   305\t        }\n   306\t        generationError = nil\n   307\t    }\n   308\t\n   309\t    func sendMoodMessage() {\n   310\t        let clean = moodInput.trimmingCharacters(in: .whitespacesAndNewlines)\n   311\t        guard !clean.isEmpty else { return }\n   312\t        moodInput = \"\"\n   313\t        moodMessages.append(MoodMessage(text: clean, fromUser: true, createdAt: Date()))\n   314\t        moodMessages.append(MoodMessage(text: \"I hear a \\(moodFor(clean).lowercased()) color in this. I can turn it into a track.\", fromUser: false, createdAt: Date()))\n   315\t    }\n   316\t\n   317\t    func turnMoodIntoMusic(mode: MusicMode) {\n   318\t        let recent = moodMessages.suffix(8).map(\\.text).joined(separator: \" \")\n   319\t        let mood = moodFor(recent)\n   320\t        let title = mode == .song ? \"\\(mood) Song\" : \"\\(mood) Muse\"\n   321\t        let prompt = mode == .song\n   322\t            ? \"\\(mood) song inspired by a personal diary conversation, expressive melody, intimate lyrics, memorable chorus, polished modern mix.\"\n   323\t            : \"\\(mood) instrumental music inspired by a personal diary conversation, expressive melody, intimate texture, cinematic detail, polished modern mix, no vocals.\"\n   324\t        generate(title: title, prompt: prompt, lyrics: defaultLyrics(title: title), mode: mode)\n   325\t    }\n   326\t\n   327\t    private func generate(title: String, prompt: String, lyrics: String, mode: MusicMode) {\n   328\t        guard !isGenerating else { return }\n   329\t        isGenerating = true\n   330\t        generationError = nil\n   331\t        generationProgress = 0.08\n   332\t        Task {\n   333\t            do {\n   334\t                for step in 1...9 {\n   335\t                    try await Task.sleep(nanoseconds: 450_000_000)\n   336\t                    generationProgress = min(0.9, Double(step) / 10.0)\n   337\t                }\n   338\t                let generated = try await MiniMaxService.generate(title: title, prompt: prompt, lyrics: lyrics, mode: mode)\n   339\t                tracks.insert(generated, at: 0)\n   340\t                scope = .myMuse\n   341\t                currentIndex = 0\n   342\t                generationProgress = 1\n   343\t                showGeneratedToast = true\n   344\t                tab = .listen\n   345\t                playCurrent()\n   346\t            } catch {\n   347\t                generationError = error.localizedDescription\n   348\t            }\n   349\t            isGenerating = false\n   350\t        }\n   351\t    }\n   352\t\n   353\t    private func configureAudioSession() {\n   354\t        do {\n   355\t            try AVAudioSession.sharedInstance().setCategory(.playback, mode: .default)\n   356\t            try AVAudioSession.sharedInstance().setActive(true)\n   357\t        } catch {\n   358\t            generationError = error.localizedDescription\n   359\t        }\n   360\t    }\n"}}
