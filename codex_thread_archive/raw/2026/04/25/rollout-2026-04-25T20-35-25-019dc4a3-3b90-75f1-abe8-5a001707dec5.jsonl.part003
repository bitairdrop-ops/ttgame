t: .leading)\n            .background(.white, in: RoundedRectangle(cornerRadius: 14))\n    }\n}\n\nstruct CreateHeader: View {\n    let mode: MusicMode\n    let isGenerating: Bool\n    let onShuffle: () -> Void\n\n    var body: some View {\n        VStack(alignment: .leading, spacing: 16) {\n            HStack(alignment: .top) {\n                VStack(alignment: .leading, spacing: 8) {\n                    Text(\"The music prompt\")\n                        .font(.system(size: 34, weight: .black))\n                    Text(mode == .song ? \"Write the feeling. Muse turns it into a song.\" : \"Shape a mood into a playable track.\")\n                        .font(.subheadline.weight(.medium))\n                        .foregroundStyle(.secondary)\n                }\n                Spacer()\n                Button(action: onShuffle) {\n                    Image(systemName: \"sparkles\")\n                        .font(.system(size: 16, weight: .bold))\n                        .foregroundStyle(Color(red: 0.03, green: 0.48, blue: 0.42))\n                        .frame(width: 46, height: 46)\n                        .background(Color(red: 0.84, green: 0.96, blue: 0.92), in: Circle())\n                }\n                .disabled(isGenerating)\n            }\n            HStack(spacing: 8) {\n                CreatePill(text: mode.rawValue, system: mode == .song ? \"music.mic\" : \"pianokeys\")\n                CreatePill(text: isGenerating ? \"Creating\" : \"Ready\", system: isGenerating ? \"waveform\" : \"checkmark\")\n            }\n        }\n        .padding(.vertical, 2)\n    }\n}\n\nstruct CreatePill: View {\n    let text: String\n    let system: String\n\n    var body: some View {\n        Label(text, systemImage: system)\n            .font(.caption.weight(.bold))\n            .padding(.horizontal, 12)\n            .padding(.vertical, 8)\n            .foregroundStyle(Color(red: 0.08, green: 0.11, blue: 0.18))\n            .background(.white.opacity(0.78), in: Capsule