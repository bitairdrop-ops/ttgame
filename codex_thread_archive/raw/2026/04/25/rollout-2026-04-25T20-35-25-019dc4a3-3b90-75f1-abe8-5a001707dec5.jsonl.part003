  )\n   964\t                )\n   965\t                drawRemotionScene(\n   966\t                    scene: preset.scene,\n   967\t                    variant: preset.variant,\n   968\t                    density: preset.density,\n   969\t                    phase: phase,\n   970\t                    beat: beat,\n   971\t                    energy: energy,\n   972\t                    colors: colors,\n   973\t                    size: size,\n   974\t                    context: &context\n   975\t                )\n   976\t                context.fill(Path(rect), with: .linearGradient(Gradient(colors: [.white.opacity(0.12), .clear, .white.opacity(0.16)]), startPoint: .zero, endPoint: CGPoint(x: 0, y: size.height)))\n   977\t            }\n   978\t        }\n   979\t    }\n   980\t}\n   981\t\n   982\tprivate func palette(for name: String, track: MusicTrack?, seed: Int) -> [Color] {\n   983\t    let named: [String: [Color]] = [\n   984\t        \"spring-mint\": [.mint.opacity(0.9), .pink.opacity(0.55), .yellow.opacity(0.65), .cyan.opacity(0.6), .indigo.opacity(0.45)],\n   985\t        \"dawn-lake\": [.teal.opacity(0.72), .orange.opacity(0.42), .blue.opacity(0.42), .white.opacity(0.6), .green.opacity(0.48)],\n   986\t        \"aurora-sky\": [.purple.opacity(0.42), .cyan.opacity(0.5), .yellow.opacity(0.5), .pink.opacity(0.46), .mint.opacity(0.5)],\n   987\t        \"forest-mist\": [.green.opacity(0.54), .blue.opacity(0.42), .yellow.opacity(0.42), .white.opacity(0.62), .pink.opacity(0.36)],\n   988\t        \"sun-rain\": [.yellow.opacity(0.54), .cyan.opacity(0.42), .orange.opacity(0.42), .mint.opacity(0.5), .white.opacity(0.58)],\n   989\t        \"moonwater\": [.indigo.opacity(0.38), .cyan.opacity(0.42), .white.opacity(0.62), .mint.opacity(0.34), .purple.opacity(0.36)],\n   990\t        \"meadow-light\": [.green.opacity(0.45), .yellow.opacity(0.45), .mint.opacity(0.5), .pink.opacity(0.36), .white.opacity(0.58)],\n   991\t        \"snow-peach\": [.white.opacity(0.72),