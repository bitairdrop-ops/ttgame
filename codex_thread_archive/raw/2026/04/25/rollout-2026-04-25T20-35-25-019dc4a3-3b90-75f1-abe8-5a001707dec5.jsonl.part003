rue) }\n-                            .font(.subheadline.weight(.bold))\n-                            .padding(.horizontal, 18)\n-                            .padding(.vertical, 12)\n-                            .background(Color(red: 0.86, green: 0.96, blue: 0.93), in: Capsule())\n+        ZStack {\n+            AnimatedMusicBackground(track: store.currentTrack, isPlaying: store.isGenerating)\n+                .opacity(0.18)\n+                .ignoresSafeArea()\n+            ScrollView {\n+                VStack(alignment: .leading, spacing: 16) {\n+                    CreateHeader(\n+                        mode: store.createMode,\n+                        isGenerating: store.isGenerating,\n+                        onShuffle: { store.randomPrompt(keepingMode: true) }\n+                    )\n+                    modePicker(selection: $store.createMode)\n+                    CreateInputCard(\n+                        mode: store.createMode,\n+                        title: $store.createTitle,\n+                        prompt: $store.createPrompt,\n+                        lyrics: $store.lyrics,\n+                        onShuffle: { store.randomPrompt(keepingMode: true) }\n+                    )\n+                    PromptQualityStrip(prompt: store.createPrompt, mode: store.createMode)\n+                    GenerateButton(title: store.createMode == .song ? \"Generate song\" : \"Generate instrumental\", isLoading: store.isGenerating) {\n+                        store.generateFromCreate()\n+                    }\n"}}
