e var store: MusicStore\n   502\t\n   503\t    var body: some View {\n   504\t        ZStack {\n   505\t            AnimatedMusicBackground(track: store.currentTrack, isPlaying: store.isPlaying)\n   506\t                .id(store.currentTrack?.id ?? \"empty\")\n   507\t                .ignoresSafeArea()\n   508\t\n   509\t            VStack(alignment: .leading, spacing: 12) {\n   510\t                ScopeBar()\n   511\t                Text(\"\\(store.currentIndex + 1)/\\(max(1, store.filteredTracks.count))\")\n   512\t                    .font(.caption)\n   513\t                    .foregroundStyle(.secondary)\n   514\t                Spacer()\n   515\t                HStack {\n   516\t                    Spacer()\n   517\t                    VStack(spacing: 16) {\n   518\t                        RoundIcon(system: store.currentTrack?.isFavorite == true ? \"star.fill\" : \"star\") {\n   519\t                            store.toggleFavorite()\n   520\t                        }\n"}}
