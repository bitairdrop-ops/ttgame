\"unknown\";\n   129\t  }\n   130\t}\n   131\t\n   132\tasync function generateMusic(payload) {\n   133\t  const requestId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;\n   134\t  const startedAt = Date.now();\n   135\t  const title = String(payload.title || \"Generated Track\").trim() || \"Generated Track\";\n   136\t  const prompt = String(payload.prompt || \"\").trim();\n   137\t  if (!prompt) throw new Error(\"prompt is required\");\n   138\t\n   139\t  const isInstrumental = payload.is_instrumental !== false && payload.mode !== \"Song\";\n   140\t  const apiPrompt = compactPrompt(prompt, isInstrumental);\n   141\t  const body = {\n   142\t    model,\n   143\t    prompt: apiPrompt,\n   144\t    is_instrumental: isInstrumental,\n   145\t    output_format: \"url\",\n   146\t    audio_setting: {\n   147\t      sample_rate: 44100,\n   148\t      bitrate: 256000,\n   149\t      format: \"mp3\",\n   150\t    },\n   151\t  };\n   152\t\n   153\t  if (!isInstrumental) {\n   154\t    body.lyrics = String(payload.lyrics || \"\").trim() || defaultLyrics(title);\n   155\t    body.lyrics_optimizer = false;\n   156\t  }\n   157\t\n   158\t  log(\"generation:start\", {\n   159\t    requestId,\n   160\t    title,\n   161\t    mode: isInstrumental ? \"Instrumental\" : \"Song\",\n   162\t    promptChars: prompt.length,\n   163\t    apiPromptChars: apiPrompt.length,\n   164\t  });\n   165\t  const response = await fetchWithRetry(endpoint, {\n   166\t    method: \"POST\",\n   167\t    headers: {\n   168\t      \"Content-Type\": \"application/json\",\n   169\t      Authorization: `Bearer ${apiKey()}`,\n   170\t    },\n   171\t    body: JSON.stringify(body),\n   172\t  }, 1, generationTimeoutMs);\n   173\t\n   174\t  const raw = await response.text();\n   175\t  if (!response.ok) {\n   176\t    throw new Error(`request failed ${response.status}: ${raw}`);\n   177\t  }\n   178\t\n   179\t  const json = JSON.parse(raw);\n   180\t  const baseResp = json.base_resp || {};\n   181\t  if (baseResp.status_code !== 0) {\n   182\t    throw new Error(baseResp.status_msg || \"music generation failed\");\n   183\t  }\n   184\t\n   185\t  const audio = json.data?.audio;\n   186\t  if (!audio) {\n   187\t    throw new Error(\"music generation returned no audio url\");\n   188\t  }\n   189\t\n   190\t  fs.mkdirSync(outputDir, { recursive: true });\n   191\t  const fileName = `${Date.now()}-${slug(title)}.mp3`;\n   192\t  const filePath = path.join(outputDir, fileName);\n   193\t  let bytes;\n   194\t  if (/^https?:\\/\\//.test(audio)) {\n   195\t    log(\"generation:audio-ready\", { requestId, source: \"url\", elapsedMs: Date.now() - startedAt });\n   196\t    const audioResponse = await fetchWithRetry(audio, {}, 3, downloadTimeoutMs);\n   197\t    if (!audioResponse.ok) {\n   198\t      throw new Error(`audio download failed ${audioResponse.status}: ${await audioResponse.text()}`);\n   199\t    }\n   200\t    bytes = Buffer.from(await audioResponse.arrayBuffer());\n   201\t  } else if (/^[0-9a-f]+$/i.test(audio) && audio.length % 2 === 0) {\n   202\t    log(\"generation:audio-ready\", { requestId, source: \"hex\", elapsedMs: Date.now() - startedAt });\n   203\t    bytes = Buffer.from(audio, \"hex\");\n   204\t  } else {\n   205\t    throw new Error(\"music generation returned unsupported audio payload\");\n   206\t  }\n   207\t\n   208\t  fs.writeFileSync(filePath, bytes);\n   209\t  log(\"generation:done\", {\n   210\t    requestId,\n   211\t    title,\n   212\t    fileName,\n   213\t    bytes: bytes.length,\n   214\t    elapsedMs: Date.now() - startedAt,\n   215\t  });\n   216\t\n   217\t  return {\n   218\t    title,\n   219\t    prompt,\n   220\t    mode: isInstrumental ? \"Instrumental\" : \"Song\",\n   221\t    audio_url: `${publicBaseUrl}/files/${encodeURIComponent(fileName)}`,\n   222\t    duration_ms: json.extra_info?.music_duration ?? null,\n   223\t    bytes: bytes.length,\n   224\t  };\n   225\t}\n   226\t\n   227\tfunction compactPrompt(prompt, isInstrumental) {\n   228\t  const cleaned = prompt\n   229\t    .replace(/\\s+/g, \" \")\n   230\t    .replace(/\\bno artist names\\b/gi, \"\")\n   231\t    .replace(/\\bno copyrighted references\\b/gi, \"\")\n   232\t    .replace(/\\s+,/g, \",\")\n   233\t    .trim();\n   234\t  if (cleaned.length <= 320) return cleaned;\n   235\t\n   236\t  const clauses = cleaned\n   237\t    .split(\",\")\n   238\t    .map((part) => part.trim())\n   239\t    .filter(Boolean);\n   240\t  const requiredEnding = isInstrumental && !/no vocals/i.test(cleaned) ? \"no vocals\" : \"\";\n   241\t  const selected = clauses.slice(0, 8);\n   242\t  if (/no vocals/i.test(cleaned) && !selected.some((part) => /no vocals/i.test(part))) {\n   243\t    selected.push(\"no vocals\");\n   244\t  } else if (requiredEnding) {\n   245\t    selected.push(requiredEnding);\n   246\t  }\n   247\t  const compacted = selected.join(\", \");\n   248\t  return compacted.length > 320 ? `${compacted.slice(0, 317).trim()}...` : compacted;\n   249\t}\n   250\t\n   251\tfunction streamFile(request, response) {\n   252\t  const fileName = decodeURIComponent(new URL(request.url, \"http://localhost\").pathname.replace(\"/files/\", \"\"));\n   253\t  const filePath = path.join(outputDir, path.basename(fileName));\n   254\t  if (!fs.existsSync(filePath)) {\n   255\t    response.writeHead(404, { \"Content-Type\": \"text/plain; charset=utf-8\" });\n   256\t    response.end(\"not found\");\n   257\t    return;\n   258\t  }\n   259\t  response.writeHead(200, {\n   260\t    \"Content-Type\": \"audio/mpeg\",\n"}}
