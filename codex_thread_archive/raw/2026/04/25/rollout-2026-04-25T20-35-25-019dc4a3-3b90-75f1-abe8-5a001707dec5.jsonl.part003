{"timestamp":"2026-05-07T07:15:29.345Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_QqZ0nQig76rSHdt9LrfpTEIY","process_id":"32131","turn_id":"019e0141-17c3-7301-acbe-40a25fd066a8","command":["/bin/zsh","-lc","sed -n '1,240p' scripts/music_proxy_server.mjs"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"read","cmd":"sed -n '1,240p' scripts/music_proxy_server.mjs","name":"music_proxy_server.mjs","path":"scripts/music_proxy_server.mjs"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"import fs from \"node:fs\";\nimport http from \"node:http\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst scriptDir = path.dirname(fileURLToPath(import.meta.url));\nconst rootDir = path.resolve(scriptDir, \"..\");\nconst outputDir = path.join(rootDir, \"local_generated_music/proxy\");\nconst endpoint = process.env.MINIMAX_BASE_URL || \"https://api.minimax.io/v1/music_generation\";\nconst model = process.env.MINIMAX_MODEL || \"music-2.6\";\nconst chatEndpoint = process.env.MINIMAX_CHAT_BASE_URL || \"https://api.minimax.io/v1/chat/completions\";\nconst chatModel = process.env.MINIMAX_CHAT_MODEL || \"MiniMax-M2.7\";\nconst port = Number.parseInt(process.env.MUSIC_PROXY_PORT || \"18901\", 10);\nconst host = process.env.MUSIC_PROXY_HOST || \"0.0.0.0\";\nconst publicBaseUrl = process.env.MUSIC_PROXY_PUBLIC_BASE_URL || `http://10.0.2.2:${port}`;\nconst generationTimeoutMs = Number.parseInt(process.env.MINIMAX_GENERATION_TIMEOUT_MS || \"900000\", 10);\nconst downloadTimeoutMs = Number.parseInt(process.env.MINIMAX_DOWNLOAD_TIMEOUT_MS || \"180000\", 10);\n\nfunction log(message, details = {}) {\n  const suffix = Object.keys(details).length ? ` ${JSON.stringify(details)}` : \"\";\n  console.log(`[${new Date().toISOString()}] ${message}${suffix}`);\n}\n\nfunction readProperties(filePath) {\n  if (!fs.existsSync(filePath)) return {};\n  return Object.fromEntries(\n    fs\n      .readFileSync(filePath, \"utf8\")\n      .split(/\\r?\\n/)\n      .map((line) => line.trim())\n      .filter((line) => line && !line.startsWith(\"#\") && line.includes(\"=\"))\n      .map((line) => {\n        const index = line.indexOf(\"=\");\n        return [line.slice(0, index).trim(), line.slice(index + 1).trim()];\n      }),\n  );\n}\n\nfunction apiKey() {\n  const envKey = process.env.MINIMAX_API_KEY?.trim();\n  if (envKey) return envKey;\n  const localEnv = readProperties(path.join(rootDir, \".env.local\")).MINIMAX_API_KEY;\n  if (localEnv) return localEnv;\n  const secrets = readProperties(path.join(rootDir, \"android/secrets.properties\")).MINIMAX_API_KEY;\n  if (secrets) return secrets;\n  throw new Error(\"MINIMAX_API_KEY is missing.\");\n}\n\nfunction slug(value) {\n  return String(value || \"generated-track\")\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"-\")\n    .replace(/^-+|-+$/g, \"\")\n    .slice(0, 64) || \"generated-track\";\n}\n\nfunction defaultLyrics(title) {\n  return `[Verse]\nI wake up with a little light\nCarrying the dream through the morning sky\nEvery step becomes a melody\nEvery breath is moving next to me\n\n[Chorus]\n${title || \"This Little Song\"}, let the feeling rise\nSinging out beneath the open skies\nHold the moment, let it shine along\nTurn my heart into a simple song`;\n}\n\nfunction sendJson(response, statusCode, body) {\n  response.writeHead(statusCode, {\n    \"Content-Type\": \"application/json; charset=utf-8\",\n    \"Cache-Control\": \"no-store\",\n  });\n  response.end(JSON.stringify(body));\n}\n\nfunction readRequestBody(request, limitBytes = 1024 * 1024) {\n  return new Promise((resolve, reject) => {\n    let body = \"\";\n    request.setEncoding(\"utf8\");\n    request.on(\"data\", (chunk) => {\n      body += chunk;\n      if (Buffer.byteLength(body) > limitBytes) {\n        reject(new Error(\"request body too large\"));\n        request.destroy();\n      }\n    });\n    request.on(\"end\", () => resolve(body));\n    request.on(\"error\", reject);\n  });\n}\n\nasync function fetchWithRetry(url, options, attempts = 3, timeoutMs = 300000) {\n  let lastError;\n  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    const controller = new AbortController();\n    const timeout = setTimeout(() => controller.abort(new Error(`request timed out after ${timeoutMs}ms`)), timeoutMs);\n    try {\n      log(\"fetch:attempt\", { url: safeUrl(url), attempt, timeoutMs });\n      const response = await fetch(url, { ...options, signal: controller.signal });\n      if (response.status < 500 || attempt === attempts) return response;\n      lastError = new Error(`server returned ${response.status}: ${await response.text()}`);\n      log(\"fetch:retryable-status\", { url: safeUrl(url), attempt, status: response.status });\n    } catch (error) {\n      lastError = error;\n      log(\"fetch:failed\", {\n        url: safeUrl(url),\n        attempt,\n        name: error.name,\n        code: error.code || error.cause?.code,\n        cause: error.cause?.message,\n        message: error.message,\n      });\n      if (attempt === attempts) throw error;\n    } finally {\n      clearTimeout(timeout);\n    }\n    await new Promise((resolve) => setTimeout(resolve, attempt * 3000));\n  }\n  throw lastError;\n}\n\nfunction safeUrl(value) {\n  try {\n    const url = new URL(value);\n    return `${url.protocol}//${url.host}${url.pathname}`;\n  } catch {\n    return \"unknown\";\n  }\n}\n\nasync function generateMusic(payload) {\n  const requestId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;\n  const startedAt = Date.now();\n  const title = String(payload.title || \"Generated Track\").trim() || \"Generated Track\";\n  const prompt = String(payload.prompt || \"\").trim();\n  if (!prompt) throw new Error(\"prompt is required\");\n\n  const isInstrumental = payload.is_instrumental !== false && payload.mode !== \"Song\";\n  const apiPrompt = compactPrompt(prompt, isInstrumental);\n  const body = {\n    model,\n    prompt: apiPrompt,\n    is_instrumental: isInstrumental,\n    output_format: \"url\",\n    audio_setting: {\n      sample_rate: 44100,\n      bitrate: 256000,\n      format: \"mp3\",\n    },\n  };\n\n  if (!isInstrumental) {\n    body.lyrics = String(payload.lyrics || \"\").trim() || defaultLyrics(title);\n    body.lyrics_optimizer = false;\n  }\n\n  log(\"generation:start\", {\n    requestId,\n    title,\n    mode: isInstrumental ? \"Instrumental\" : \"Song\",\n    promptChars: prompt.length,\n    apiPromptChars: apiPrompt.length,\n  });\n  const response = await fetchWithRetry(endpoint, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${apiKey()}`,\n    },\n    body: JSON.stringify(body),\n  }, 1, generationTimeoutMs);\n\n  const raw = await response.text();\n  if (!response.ok) {\n    throw new Error(`request failed ${response.status}: ${raw}`);\n  }\n\n  const json = JSON.parse(raw);\n  const baseResp = json.base_resp || {};\n  if (baseResp.status_code !== 0) {\n    throw new Error(baseResp.status_msg || \"music generation failed\");\n  }\n\n  const audio = json.data?.audio;\n  if (!audio) {\n    throw new Error(\"music generation returned no audio url\");\n  }\n\n  fs.mkdirSync(outputDir, { recursive: true });\n  const fileName = `${Date.now()}-${slug(title)}.mp3`;\n  const filePath = path.join(outputDir, fileName);\n  let bytes;\n  if (/^https?:\\/\\//.test(audio)) {\n    log(\"generation:audio-ready\", { requestId, source: \"url\", elapsedMs: Date.now() - startedAt });\n    const audioResponse = await fetchWithRetry(audio, {}, 3, downloadTimeoutMs);\n    if (!audioResponse.ok) {\n      throw new Error(`audio download failed ${audioResponse.status}: ${await audioResponse.text()}`);\n    }\n    bytes = Buffer.from(await audioResponse.arrayBuffer());\n  } else if (/^[0-9a-f]+$/i.test(audio) && audio.length % 2 === 0) {\n    log(\"generation:audio-ready\", { requestId, source: \"hex\", elapsedMs: Date.now() - startedAt });\n    bytes = Buffer.from(audio, \"hex\");\n  } else {\n    throw new Error(\"music generation returned unsupported audio payload\");\n  }\n\n  fs.writeFileSync(filePath, bytes);\n  log(\"generation:done\", {\n    requestId,\n    title,\n    fileName,\n    bytes: bytes.length,\n    elapsedMs: Date.now() - startedAt,\n  });\n\n  return {\n    title,\n    prompt,\n    mode: isInstrumental ? \"Instrumental\" : \"Song\",\n    audio_url: `${publicBaseUrl}/files/${encodeURIComponent(fileName)}`,\n    duration_ms: json.extra_info?.music_duration ?? null,\n    bytes: bytes.length,\n  };\n}\n\nasync function chatWithMuseCat(payload) {\n  const history = Array.isArray(payload.messages) ? payload.messages : [];\n  const language = String(payload.language || \"English\");\n  const messages = [\n    {\n      role: \"system\",\n      name: \"MuseCat\",\n      content: [\n        \"You are MuseCat, a warm AI music companion inside AiMuse.\",\n        \"Reply as a caring music agent, not as a generic assistant.\",\n        \"Reflect the user's emotion, ask at most one gentle question when useful,\",\n        \"and suggest a concise music direction that could become a prompt.\",\n","exit_code":0,"duration":{"secs":0,"nanos":6833},"formatted_output":"","status":"completed"}}
