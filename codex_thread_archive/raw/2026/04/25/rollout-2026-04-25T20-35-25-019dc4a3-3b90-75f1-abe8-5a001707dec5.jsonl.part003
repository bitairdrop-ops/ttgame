              messages: store.moodMessages,\n   682\t                        clear: { store.moodMessages.removeAll() }\n   683\t                    )\n   684\t                    MoodComposerCard(\n   685\t                        input: $store.moodInput,\n   686\t                        send: { store.sendMoodMessage() }\n   687\t                    )\n   688\t                    MoodGeneratePanel(\n   689\t                        mode: $store.moodMode,\n   690\t                        isGenerating: store.isGenerating,\n   691\t                        progress: store.generationProgress,\n   692\t                        generate: { store.turnMoodIntoMusic(mode: store.moodMode) }\n   693\t                    )\n   694\t                    if let error = store.generationError {\n   695\t                        RecoveryCard(\n   696\t                            error: error,\n   697\t                            onRetry: { store.turnMoodIntoMusic(mode: store.moodMode) },\n   698\t                            onInstrumental: { store.moodMode = .instrumental },\n   699\t                            onRandom: {\n   700\t                                store.moodInput = [\n   701\t                                    \"I feel calm but need energy.\",\n   702\t                                    \"I want something hopeful for tonight.\",\n   703\t                                    \"I need music for a quiet reset.\",\n   704\t                                    \"Turn this messy mood into something bright.\"\n   705\t                                ].randomElement() ?? store.moodInput\n   706\t                                store.generationError = nil\n   707\t                            }\n   708\t                        )\n   709\t                    }\n   710\t                }\n   711\t                .padding(.horizontal, 18)\n   712\t                .padding(.top, 24)\n   713\t                .padding(.bottom, 150)\n   714\t            }\n   715\t        }\n   716\t        .background(Color(red: 0.96, green: 0.97, blue: 0.98))\n   717\t    }\n   718\t}\n   719\t\n   720\tstruct MoodHeroCard: View {\n   721\t    let language: AppLanguage\n   722\t    let isGenerating: Bool\n   723\t    let selectedDate: Date\n   724\t    @Binding var showCalendar: Bool\n   725\t\n   726\t    var body: some View {\n   727\t        VStack(alignment: .leading, spacing: 16) {\n   728\t            ZStack {\n   729\t                AnimatedMusicBackground(track: nil, isPlaying: isGenerating)\n   730\t                    .opacity(0.34)\n   731\t                    .clipShape(RoundedRectangle(cornerRadius: 20))\n   732\t                HStack(alignment: .top) {\n   733\t                    VStack(alignment: .leading, spacing: 5) {\n   734\t                        Text(localized(\"How are you feeling?\", language))\n   735\t                            .font(.system(size: 28, weight: .black))\n   736\t                            .lineLimit(2)\n   737\t                        Text(localized(\"Tell MuseCat what is on your mind.\", language))\n   738\t                            .font(.subheadline.weight(.medium))\n   739\t                            .foregroundStyle(.secondary)\n   740\t                    }\n   741\t                    Spacer(minLength: 0)\n   742\t                }\n   743\t                .padding(16)\n   744\t            }\n   745\t            .frame(minHeight: 112)\n   746\t            HStack(spacing: 8) {\n   747\t                Button {\n   748\t                    withAnimation(.spring(response: 0.36, dampingFraction: 0.88)) {\n   749\t                        showCalendar.toggle()\n   750\t                    }\n   751\t                } label: {\n   752\t                    Label(formatDate(selectedDate), systemImage: \"calendar\")\n   753\t          …619 chars truncated…Rectangle(cornerRadius: 24))\n   765\t        .overlay(RoundedRectangle(cornerRadius: 24).stroke(.white.opacity(0.75), lineWidth: 1))\n   766\t        .shadow(color: .black.opacity(0.06), radius: 22, y: 12)\n   767\t    }\n   768\t}\n   769\t\n   770\tstruct MoodCalendarCard: View {\n   771\t    @Binding var selectedDate: Date\n   772\t\n   773\t    var body: some View {\n   774\t        DatePicker(\"\", selection: $selectedDate, displayedComponents: .date)\n   775\t            .datePickerStyle(.graphical)\n   776\t            .padding(12)\n   777\t            .background(.white.opacity(0.9), in: RoundedRectangle(cornerRadius: 22))\n   778\t            .overlay(RoundedRectangle(cornerRadius: 22).stroke(.white.opacity(0.72), lineWidth: 1))\n   779\t            .transition(.opacity.combined(with: .move(edge: .top)))\n   780\t    }\n   781\t}\n   782\t\n   783\tstruct MoodHistoryCard: View {\n   784\t    let language: AppLanguage\n   785\t    let messages: [MoodMessage]\n   786\t    let clear: () -> Void\n   787\t\n   788\t    var body: some View {\n   789\t        VStack(alignment: .leading, spacing: 12) {\n   790\t            HStack(alignment: .firstTextBaseline) {\n   791\t                VStack(alignment: .leading, spacing: 2) {\n   792\t                    Text(localized(\"History\", language))\n   793\t                        .font(.headline)\n   794\t                    Text(\"\\(messages.count) messages\")\n   795\t                        .font(.caption.weight(.semibold))\n   796\t                        .foregroundStyle(.secondary)\n   797\t                }\n   798\t                Spacer()\n   799\t                Button(\"Clear\", action: clear)\n   800\t                    .font(.subheadline.weight(.semibold))\n   801\t            }\n   802\t            VStack(spacing: 8) {\n   803\t                ForEach(messages.suffix(4)) { message in\n   804\t                    Text(message.text)\n   805\t                        .font(.subheadline)\n   806\t                        .foregroundStyle(Color(red: 0.08, green: 0.11, blue: 0.18))\n   807\t                        .frame(maxWidth: .infinity, alignment: message.fromUser ? .trailing : .leading)\n   808\t                        .padding(.horizontal, 12)\n   809\t                        .padding(.vertical, 10)\n   810\t                        .background(message.fromUser ? Color(red: 0.84, green: 0.96, blue: 0.92) : Color.black.opacity(0.045), in: RoundedRectangle(cornerRadius: 14))\n   811\t                }\n   812\t            }\n   813\t        }\n   814\t        .padding(16)\n   815\t        .background(.white.opacity(0.9), in: RoundedRectangle(cornerRadius: 22))\n   816\t        .overlay(RoundedRectangle(cornerRadius: 22).stroke(.white.opacity(0.7), lineWidth: 1))\n   817\t    }\n   818\t}\n   819\t\n   820\tstruct MoodComposerCard: View {\n   821\t    @Binding var input: String\n   822\t    let send: () -> Void\n   823\t\n   824\t    var body: some View {\n   825\t        VStack(alignment: .leading, spacing: 10) {\n   826\t            HStack {\n   827\t                Label(\"Tell MuseCat\", systemImage: \"bubble.left.and.text.bubble.right\")\n   828\t                    .font(.headline)\n   829\t                Spacer()\n   830\t                Button(action: send) {\n   831\t                    Image(systemName: \"arrow.up\")\n   832\t                        .font(.system(size: 15, weight: .black))\n   833\t                        .foregroundStyle(.white)\n   834\t                        .frame(width: 38, height: 38)\n   835\t                        .background(input.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? Color.gray.opacity(0.36) : Color(red: 0.05, green: 0.58, blue: 0.49), in: Circle())\n   836\t                }\n   837\t                .disabled(input.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)\n   838\t            }\n   839\t            TextEditor(text: $input)\n   840\t                .font(.body)\n   841\t                .scrollContentBackground(.hidden)\n   842\t                .frame(height: 118)\n   843\t                .padding(10)\n   844\t                .background(Color(red: 0.96, green: 0.97, blue: 0.98), in: RoundedRectangle(cornerRadius: 17))\n   845\t                .overlay(RoundedRectangle(cornerRadius: 17).stroke(.black.opacity(0.08), lineWidth: 1))\n   846\t        }\n   847\t        .padding(16)\n   848\t        .background(.white.opacity(0.9), in: RoundedRectangle(cornerRadius: 22))\n   849\t        .overlay(RoundedRectangle(cornerRadius: 22).stroke(.white.opacity(0.7), lineWidth: 1))\n   850\t    }\n   851\t}\n   852\t\n   853\tstruct MoodGeneratePanel: View {\n   854\t    @Binding var mode: MusicMode\n   855\t    let isGenerating: Bool\n   856\t    let progress: Double\n   857\t    let generate: () -> Void\n   858\t\n   859\t    var body: some View {\n   860\t        VStack(alignment: .leading, spacing: 12) {\n   861\t            HStack {\n   862\t                Label(\"Mood to music\", systemImage: \"wand.and.stars\")\n   863\t                    .font(.headline)\n   864\t                Spacer()\n   865\t                CreatePill(text: mode.rawValue, system: mode == .song ? \"music.mic\" : \"pianokeys\")\n","exit_code":0,"duration":{"secs":0,"nanos":5208},"formatted_output":"","status":"completed"}}
