righted references\\b/gi, \"\")\n    .replace(/\\s+,/g, \",\")\n    .trim();\n  if (cleaned.length <= 320) return cleaned;\n\n  const clauses = cleaned\n    .split(\",\")\n    .map((part) => part.trim())\n    .filter(Boolean);\n  const requiredEnding = isInstrumental && !/no vocals/i.test(cleaned) ? \"no vocals\" : \"\";\n  const selected = clauses.slice(0, 8);\n  if (/no vocals/i.test(cleaned) && !selected.some((part) => /no vocals/i.test(part))) {\n    selected.push(\"no vocals\");\n  } else if (requiredEnding) {\n    selected.push(requiredEnding);\n  }\n  const compacted = selected.join(\", \");\n  return compacted.length > 320 ? `${compacted.slice(0, 317).trim()}...` : compacted;\n}\n\nfunction streamFile(request, response) {\n  const fileName = decodeURIComponent(new URL(request.url, \"http://localhost\").pathname.replace(\"/files/\", \"\"));\n  const filePath = path.join(outputDir, path.basename(fileName));\n  if (!fs.existsSync(filePath)) {\n    response.writeHead(404, { \"Content-Type\": \"text/plain; charset=utf-8\" });\n    response.end(\"not found\");\n    return;\n  }\n  response.writeHead(200, {\n    \"Content-Type\": \"audio/mpeg\",\n    \"Cache-Control\": \"no-store\",\n  });\n  fs.createReadStream(filePath).pipe(response);\n}\n\nconst server = http.createServer(async (request, response) => {\n  try {\n    const url = new URL(request.url, \"http://localhost\");\n    if (request.method === \"GET\" && url.pathname === \"/health\") {\n      sendJson(response, 200, { ok: true, model, outputDir });\n      return;\n    }\n    if (request.method === \"GET\" && url.pathname.startsWith(\"/files/\")) {\n      streamFile(request, response);\n      return;\n    }\n    if (request.method === \"POST\" && url.pathname === \"/generate\") {\n      const rawBody = await readRequestBody(request);\n      const payload = rawBody ? JSON.parse(rawBody) : {};\n      const result = await generateMusic(payload);\n      sendJson(response, 200, result);\n      return;\n    }\n    if (request.method === \"POST\" && url.pathname === \"/chat\") {\n      const rawBody = await readRequestBody(request);\n      const payload = rawBody ? JSON.parse(rawBody) : {};\n      const result = await chatWithMuseCat(payload);\n      sendJson(response, 200, result);\n      return;\n    }\n    sendJson(response, 404, { error: \"not found\" });\n  } catch (error) {\n    log(\"proxy:error\", { error: error.message || \"proxy failed\" });\n    const isUpstreamNetwork = /fetch failed|timed out|aborted|terminated/i.test(error.message || \"\");\n    sendJson(response, isUpstreamNetwork ? 504 : 502, {\n      error: isUpstreamNetwork\n        ? \"Upstream AI request did not finish. Please retry.\"\n        : error.message || \"proxy failed\",\n    });\n  }\n});\n\nserver.listen(port, host, () => {\n  log(`Music proxy ready on http://${host}:${port}`);\n  log(`Public audio base URL: ${publicBaseUrl}`);\n});\n    }\n\n    func switchCreateToInstrumental() {\n        createMode = .instrumental\n        if !createPrompt.localizedCaseInsensitiveContains(\"no vocals\") {\n            createPrompt += \", no vocals\"\n        }\n        generationError = nil\n    }\n\n    func sendMoodMessage() {\n        let clean = moodInput.trimmingCharacters(in: .whitespacesAndNewlines)\n        guard !clean.isEmpty, !isMoodChatting else { return }\n        moodInput = \"\"\n        moodMessages.append(MoodMessage(text: clean, fromUser: true, createdAt: Date()))\n        isMoodChatting = true\n        Task {\n            do {\n                let reply = try await MiniMaxService.chat(messages: moodMessages, language: language)\n                moodMessages.append(MoodMessage(text: reply, fromUser: false, createdAt: Date()))\n            } catch {\n                let fallback = \"MuseCat could not reach the music brain right now. I still hear a \\(moodFor(clean).lowercased()) color in this, and we can turn it into a track.\"\n                moodMessages.append(MoodMessage(text: fallback, fromUser: false, createdAt: Date()))\n            }\n            isMoodChatting = false\n        }\n    }\n\n    func turnMoodIntoMusic(mode: MusicMode) {\n        let recent = moodMessages.suffix(8).map(\\.text).joined(separator: \" \")\n        let mood = moodFor(recent)\n        let title = mode == .song ? \"\\(mood) Song\" : \"\\(mood) Muse\"\n        let prompt = mode == .song\n            ? \"\\(mood) song inspired by a personal diary conversation, expressive melody, intimate lyrics, memorable chorus, polished modern mix.\"\n            : \"\\(mood) instrumental music inspired by a personal diary conversation, expressive melody, intimate texture, cinematic detail, polished modern mix, no vocals.\"\n        generate(title: title, prompt: prompt, lyrics: defaultLyrics(title: title), mode: mode)\n    }\n\n    private func generate(title: String, prompt: String, lyrics: String, mode: MusicMode) {\n        guard !isGenerating else { return }\n        isGenerating = true\n        generationError = nil\n        generationProgress = 0.08\n        Task {\n            do {\n                for step in 1...9 {\n                    try await Task.sleep(nanoseconds: 450_000_000)\n                    generationProgress = min(0.9, Double(step) / 10.0)\n                }\n                let generated = try await MiniMaxService.generate(title: title, prompt: prompt, lyrics: lyrics, mode: mode)\n                tracks.insert(generated, at: 0)\n                scope = .myMuse\n                currentIndex = 0\n                generationProgress = 1\n                showGeneratedToast = true\n                tab = .listen\n                playCurrent()\n            } catch {\n                generationError = error.localizedDescription\n            }\n            isGenerating = false\n        }\n    }\n\n    private func configureAudioSession() {\n        do {\n            try AVAudioSession.sharedInstance().setCategory(.playback, mode: .default)\n            try AVAudioSession.sharedInstance().setActive(true)\n        } catch {\n            generationError = error.localizedDescription\n        }\n    }\n\n    private func loadPromptBank() {\n        guard let url = Bundle.main.url(forResource: \"prompt_bank\", withExtension: \"json\"),\n              let data = try? Data(contentsOf: url),\n              let bank = try? JSONDecoder().decode([PromptSeed].self, from: data) else { return }\n        promptBank = bank\n    }\n\n    private func loadSeedMusic() {\n        guard let url = Bundle.main.url(forResource: \"manifest\", withExtension: \"json\", subdirectory: \"seed_music\"),\n              let data = try? Data(contentsOf: url),\n              let seeds = try? JSONDecoder().decode([SeedTrack].self, from: data) else { return }\n\n        tracks = seeds.enumerated().map { index, seed in\n            MusicTrack(\n                title: seed.title,\n                mode: seed.mode,\n                prompt: seed.prompt,\n                file: seed.file,\n                durationMs: seed.durationMs,\n                mood: moodFor(seed.prompt),\n                isGenerated: index > 2,\n                isFavorite: false\n            )\n        }\n    }\n\n    private func playableURL(for track: MusicTrack) -> URL? {\n        if let localURL = track.localURL { return localURL }\n        guard let file = track.file else { return nil }\n        let name = file.replacingOccurrences(of: \"seed_music/\", with: \"\")\n        return Bundle.main.url(forResource: name, withExtension: nil, subdirectory: \"seed_music\")\n    }\n\n    private func randomDifferentIndex(count: Int) -> Int {\n        guard count > 1 else { return 0 }\n        var next = Int.random(in: 0..<count)\n        while next == currentIndex {\n            next = Int.random(in: 0..<count)\n        }\n        return next\n    }\n\n    nonisolated func audioPlayerDidFinishPlaying(_ player: AVAudioPlayer, successfully flag: Bool) {\n        Task { @MainActor in\n            if playbackMode == .repeatOne {\n                playCurrent()\n            } else {\n                nextTrack()\n            }\n        }\n    }\n}\n\nenum MiniMaxService {\n    private static let session: URLSession = {\n        let configuration = URLSessionConfiguration.default\n        configuration.timeoutIntervalForRequest = 1_800\n        configuration.timeoutIntervalForResource = 1_900\n        configuration.waitsForConnectivity = true\n        return URLSession(configuration: configuration)\n    }()\n\n    static func generate(title: String, prompt: String, lyrics: String, mode: MusicMode) async throws -> MusicTrack {\n        let payload: [String: Any] = [\n            \"title\": title,\n            \"prompt\": prompt,\n            \"lyrics\": lyrics,\n            \"mode\": mode.rawValue,\n            \"is_instrumental\": mode == .instrumental\n        ]\n        let data = try JSONSerialization.data(withJSONObject: payload)\n        var request = URLRequest(url: URL(string: \"http://127.0.0.1:18901/generate\")!)\n        request.httpMethod = \"POST\"\n        request.timeoutInterval = 1_800\n        request.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")\n        request.httpBody = data\n\n        let (responseData, response) = try await session.data(for: request)\n        guard let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {\n            let raw = String(data: responseData, encoding: .utf8) ?? \"generation failed\"\n            let message = errorMessage(from: responseData) ?? raw\n            throw NSError(domain: \"AiMuse\", code: 1, userInfo: [NSLocalizedDescriptionKey: message])\n        }\n        let json = try JSONSerialization.jsonObject(with: responseData) as? [String: Any]\n        let rawAudio = (json?[\"audio_url\"] as? String) ?? \"\"\n        let audio = rawAudio.replacingOccurrences(of: \"http://10.0.2.2:\", with: \"http://127.0.0.1:\")\n        guard let remote = URL(string: audio) else {\n            throw NSError(domain: \"AiMuse\", code: 2, userInfo: [NSLocalizedDescriptionKey: \"Music service returned no audio URL.\"])\n        }\n        let local = try await download(remote)\n        return MusicTrack(\n            title: (json?[\"title\"] as? String) ?? title,\n            mode: mode,\n            prompt: (json?[\"prompt\"] as? String) ?? prompt,\n            file: nil,\n            localURL: local,\n            remoteURL: remote,\n            durationMs: json?[\"duration_ms\"] as? Int,\n            mood: moodFor(prompt),\n            isGenerated: true,\n            isFavorite: false\n        )\n    }\n\n    static func chat(messages: [MoodMessage], language: AppLanguage) async throws -> String {\n        let payload: [String: Any] = [\n            \"language\": language.rawValue,\n            \"messages\": messages.suffix(12).map { message in\n                [\n                    \"text\": message.text,\n                    \"fromUser\": message.fromUser\n                ]\n            }\n        ]\n        let data = try JSONSerialization.data(withJSONObject: payload)\n        var request = URLRequest(url: URL(string: \"http://127.0.0.1:18901/chat\")!)\n        request.httpMethod = \"POST\"\n        request.timeoutInterval = 120\n        request.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")\n        request.httpBody = data\n\n        let (responseData, response) = try await session.data(for: request)\n        guard let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {\n            let raw = String(data: responseData, encoding: .utf8) ?? \"chat failed\"\n            let message = errorMessage(from: responseData) ?? raw\n            throw NSError(domain: \"AiMuse\", code: 3, userInfo: [NSLocalizedDescriptionKey: message])\n        }\n        guard\n            let json = try JSONSerialization.jsonObject(with: responseData) as? [String: Any],\n            let reply = json[\"reply\"] as? String,\n            !reply.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty\n        else {\n            throw NSError(domain: \"AiMuse\", code: 4, userInfo: [NSLocalizedDescriptionKey: \"MuseCat returned no reply.\"])\n        }\n        return reply\n    }\n\n    private static func errorMessage(from data: Data) -> String? {\n                        .font(.subheadline)\n                        .foregroundStyle(Color(red: 0.08, green: 0.11, blue: 0.18))\n                        .frame(maxWidth: .infinity, alignment: message.fromUser ? .trailing : .leading)\n                        .padding(.horizontal, 12)\n                        .padding(.vertical, 10)\n                        .background(message.fromUser ? Color(red: 0.84, green: 0.96, blue: 0.92) : Color.black.opacity(0.045), in: RoundedRectangle(cornerRadius: 14))\n                }\n            }\n        }\n        .padding(16)\n        .background(.white.opacity(0.9), in: RoundedRectangle(cornerRadius: 22))\n        .overlay(RoundedRectangle(cornerRadius: 22).stroke(.white.opacity(0.7), lineWidth: 1))\n    }\n}\n\nstruct MoodComposerCard: View {\n    @Binding var input: String\n    let isSending: Bool\n    let send: () -> Void\n\n    var body: some View {\n        VStack(alignment: .leading, spacing: 10) {\n            HStack {\n                Label(\"Tell MuseCat\", systemImage: \"bubble.left.and.text.bubble.right\")\n                    .font(.headline)\n                Spacer()\n                Button(action: send) {\n                    Group {\n                        if isSending {\n                            ProgressView().tint(.white)\n                        } else {\n                            Image(systemName: \"arrow.up\")\n                                .font(.system(size: 15, weight: .black))\n                        }\n                    }\n                    .foregroundStyle(.white)\n                    .frame(width: 38, height: 38)\n                    .background(input.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || isSending ? Color.gray.opacity(0.36) : Color(red: 0.05, green: 0.58, blue: 0.49), in: Circle())\n                }\n                .disabled(input.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || isSending)\n            }\n            TextEditor(text: $input)\n                .font(.body)\n                .scrollContentBackground(.hidden)\n                .frame(height: 118)\n                .padding(10)\n                .background(Color(red: 0.96, green: 0.97, blue: 0.98), in: RoundedRectangle(cornerRadius: 17))\n                .overlay(RoundedRectangle(cornerRadius: 17).stroke(.black.opacity(0.08), lineWidth: 1))\n        }\n        .padding(16)\n        .background(.white.opacity(0.9), in: RoundedRectangle(cornerRadius: 22))\n        .overlay(RoundedRectangle(cornerRadius: 22).stroke(.white.opacity(0.7), lineWidth: 1))\n    }\n}\n\nstruct MoodGeneratePanel: View {\n    @Binding var mode: MusicMode\n    let isGenerating: Bool\n    let progress: Double\n    let generate: () -> Void\n\n    var body: some View {\n        VStack(alignment: .leading, spacing: 12) {\n            HStack {\n                Label(\"Mood to music\", systemImage: \"wand.and.stars\")\n                    .font(.headline)\n                Spacer()\n                CreatePill(text: mode.rawValue, system: mode == .song ? \"music.mic\" : \"pianokeys\")\n            }\n            modePicker(selection: $mode)\n            GenerateButton(title: mode == .song ? \"Turn mood into song\" : \"Turn mood into music\", isLoading: isGenerating, action: generate)\n"}}
