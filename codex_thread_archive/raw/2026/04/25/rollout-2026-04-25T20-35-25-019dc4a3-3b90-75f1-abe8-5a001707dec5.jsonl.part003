{"timestamp":"2026-04-30T11:01:53.200Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_R6gm5cSPL43rAJGjXuLHbktT","process_id":"7974","turn_id":"019dde0b-b897-7a70-804a-4698c858020b","command":["/bin/zsh","-lc","sed -n '1,145p' tools/expand_prompt_bank.mjs"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"read","cmd":"sed -n '1,145p' tools/expand_prompt_bank.mjs","name":"expand_prompt_bank.mjs","path":"tools/expand_prompt_bank.mjs"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"import fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst projectRoot = path.resolve(import.meta.dirname, \"..\");\nconst bankPath = path.join(projectRoot, \"android/app/src/main/assets/prompt_bank.json\");\n\nconst existing = JSON.parse(fs.readFileSync(bankPath, \"utf8\"));\n\nconst cleanPrompt = (prompt) =>\n  prompt\n    .replace(/\\b30[- ]?seconds?\\b/gi, \"\")\n    .replace(/\\b30s\\b/gi, \"\")\n    .replace(/\\bthirty seconds?\\b/gi, \"\")\n    .replace(/\\s+,/g, \",\")\n    .replace(/,\\s*,/g, \",\")\n    .replace(/,\\s*\\./g, \".\")\n    .replace(/\\s+\\./g, \".\")\n    .replace(/\\s{2,}/g, \" \")\n    .trim();\n\nconst titleCase = (text) =>\n  text\n    .replace(/[-_]/g, \" \")\n    .split(/\\s+/)\n    .filter(Boolean)\n    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(\" \");\n\nconst genres = [\n  \"alt pop\", \"dream pop\", \"indie folk\", \"indie rock\", \"shoegaze\", \"post rock\",\n  \"synthwave\", \"city pop\", \"future bass\", \"deep house\", \"melodic techno\", \"ambient techno\",\n  \"drum and bass\", \"UK garage\", \"2-step garage\", \"afrobeats\", \"amapiano\", \"dancehall\",\n  \"reggaeton\", \"latin pop\", \"bossa nova\", \"samba soul\", \"jazz fusion\", \"neo soul\",\n  \"R&B\", \"trap soul\", \"boom bap\", \"melodic rap\", \"phonk\", \"hyperpop\",\n  \"disco funk\", \"nu disco\", \"electro pop\", \"chillwave\", \"vaporwave\", \"lo-fi hip hop\",\n  \"cinematic piano\", \"orchestral hybrid\", \"minimal classical\", \"new age\", \"folk pop\",\n  \"country pop\", \"bluegrass\", \"gospel soul\", \"punk pop\", \"metalcore\", \"garage rock\",\n  \"psychedelic rock\", \"progressive rock\", \"mandopop\", \"cantopop\", \"guofeng pop\",\n  \"j-pop\", \"k-pop\", \"arabic pop\", \"turkish psych\", \"desert blues\", \"flamenco pop\",\n  \"cumbia\", \"salsa dura\", \"tango nuevo\", \"ethio jazz\", \"dub reggae\", \"trip hop\",\n  \"breakbeat\", \"industrial pop\", \"darkwave\", \"electroclash\", \"ambient pop\",\n  \"organic house\", \"downtempo\", \"glitch pop\", \"IDM\", \"chamber pop\"\n];\n\nconst moods = [\n  \"euphoric\", \"bittersweet\", \"nocturnal\", \"sunlit\", \"tender\", \"cinematic\",\n  \"confident\", \"weightless\", \"hopeful\", \"melancholic\", \"playful\", \"mysterious\",\n  \"warm\", \"restless\", \"serene\", \"triumphant\", \"introspective\", \"romantic\",\n  \"haunting\", \"glossy\", \"raw\", \"dreamy\", \"electric\", \"meditative\",\n  \"rain-soaked\", \"neon\", \"golden-hour\", \"festival-ready\", \"intimate\", \"expansive\",\n  \"nostalgic\", \"futuristic\", \"earthy\", \"oceanic\", \"floating\", \"driving\"\n];\n\nconst themes = [\n  \"late-night train windows\", \"first light over the city\", \"rain on a quiet balcony\",\n  \"running through summer streets\", \"a letter never sent\", \"finding courage after doubt\",\n  \"friends turning a hard week around\", \"ocean roads at sunset\", \"a room full of memories\",\n  \"walking home after the last bus\", \"new beginnings after heartbreak\", \"moonlit garden air\",\n  \"small victories before dawn\", \"a phone call that changes everything\", \"dancing through uncertainty\",\n  \"forest paths after rain\", \"a rooftop above traffic\", \"calm focus before a big day\",\n  \"returning to your hometown\", \"a secret wish under neon lights\", \"slow healing after a storm\",\n  \"the quiet confidence of moving on\", \"morning coffee and open windows\", \"a skyline reflected in water\",\n  \"festival lights in the distance\", \"a long drive with no destination\", \"the warmth of an old photograph\",\n  \"a brave message sent at midnight\", \"snow falling outside a studio\", \"fireflies over a lake\",\n  \"a tiny apartment full of dreams\", \"rediscovering joy\", \"a goodbye that feels peaceful\",\n  \"mountain air and clear thoughts\", \"holding on to a promise\", \"a crowded room feeling lonely\",\n  \"a bright future arriving slowly\", \"city rain and soft headphones\", \"stargazing on a quiet field\",\n  \"a summer night that will not end\", \"the first day after burnout\", \"waves, wind, and steady breathing\"\n];\n\nconst instrumentalPalettes = [\n  \"soft synth pads, clean piano, warm sub bass, crisp electronic pulse\",\n  \"felt piano, airy strings, distant choir textures, gentle low drums\",\n  \"Rhodes piano, upright bass, brushed drums, vinyl texture\",\n  \"nylon guitar, hand percussion, mellow organ, soft room ambience\",\n  \"analog synth lead, sidechain bass, glassy arpeggios, bright drums\",\n  \"marimba, kalimba, muted bass, organic percussion, field-recorded nature ambience\",\n  \"electric guitar swells, tape echo, live drums, wide reverb tails\",\n  \"string quartet, harp harmonics, low brass pulses, cinematic percussion\",\n  \"flute phrases, guzheng plucks, warm pads, minimal downtempo beat\",\n  \"saxophone hooks, clavinet, slap bass, tight funk drums\",\n  \"808 bass, airy keys, syncopated hi-hats, atmospheric plucks\",\n  \"granular piano, soft noise bed, bowed cymbals, slow evolving drones\",\n  \"pizzicato strings, celesta, playful woodwinds, light percussion\",\n  \"acoustic fingerstyle guitar, mandolin, upright bass, brushed snare\",\n  \"pluck synth ostinato, deep kick, shimmering pads, evolving risers\",\n  \"steel drums, warm bass guitar, sunlit percussion, clean guitar chops\"\n];\n\nconst songPalettes = [\n  \"soft female lead vocal, stacked harmonies, crisp drums, warm synth bass\",\n  \"intimate male vocal, acoustic guitar, brushed drums, piano counter melody\",\n  \"duet vocals, call-and-response chorus, bright keys, live bass\",\n  \"raspy lead vocal, electric guitar arpeggios, stadium drums, wide chorus\",\n  \"breathy vocal delivery, Rhodes piano, sub bass, minimal trap drums\",\n  \"confident pop vocal, glossy synths, clap-driven drums, huge final chorus\",\n  \"smoky jazz vocal, upright bass, piano trio, brushed swing drums\",\n  \"layered choir hook, Hammond organ, handclaps, soulful rhythm section\",\n  \"rap verses with sung hook, 808 bass, dark pads, crisp hi-hats\",\n  \"airy falsetto vocal, nylon guitar, soft percussion, oceanic pads\",\n  \"clear Mandarin vocal, guzheng accents, modern pop drums, cinematic strings\",\n  \"bright group vocals, punchy bass, sparkling synth lead, dance-pop drums\"\n];\n\nconst structures = [\n  \"memorable hook, concise intro, dynamic build, polished streaming-ready mix\",\n  \"minimal verse, lift into a wide chorus, emotional bridge, final hook\",\n  \"strong motif, call-and-response phrases, clean transitions, radio-ready arrangement\",\n  \"quiet opening, gradual layering, satisfying drop, warm master\",\n  \"hook-first composition, contrast between verse and chorus, wide stereo image\",\n  \"tight groove, earworm melody, subtle breakdown, energetic final section\"\n];\n\nconst bpmByGenre = (genre, i) => {\n  if (/drum and bass/.test(genre)) return 168 + (i % 8);\n  if (/garage|breakbeat/.test(genre)) return 128 + (i % 12);\n  if (/house|techno|disco|amapiano/.test(genre)) return 118 + (i % 10);\n  if (/trap|rap|phonk/.test(genre)) return 138 + (i % 8);\n  if (/punk|metalcore/.test(genre)) return 148 + (i % 10);\n  if (/ambient|new age|minimal classical|cinematic/.test(genre)) return 64 + (i % 18);\n  if (/lo-fi|R&B|neo soul|trip hop|downtempo/.test(genre)) return 78 + (i % 16);\n  return 92 + (i % 38);\n};\n\nconst keys = [\"C major\", \"G major\", \"D major\", \"F major\", \"A minor\", \"E minor\", \"B minor\", \"D minor\", \"Eb major\", \"C minor\"];\nconst eras = [\"modern\", \"late-2000s inspired\", \"2010s streaming-era\", \"retro-futurist\", \"classic live-band\", \"minimal contemporary\"];\nconst languages = [\"English\", \"Mandarin\", \"bilingual English and Mandarin\", \"wordless vocal textures\", \"Spanish\", \"Japanese\"];\n\nconst usedTitles = new Set(existing.map((entry) => entry.title));\nconst additions = [];\n\nfunction uniqueTitle(base, suffix) {\n  let title = titleCase(`${base} ${suffix}`.replace(/\\s+/g, \" \"));\n  let n = 2;\n  while (usedTitles.has(title)) {\n    title = `${titleCase(`${base} ${suffix}`)} ${n}`;\n    n += 1;\n  }\n  usedTitles.add(title);\n  return title;\n}\n\nfor (let i = 0; i < 2500; i += 1) {\n  const genre = genres[i % genres.length];\n  const mood = moods[(i * 7) % moods.length];\n","exit_code":0,"duration":{"secs":0,"nanos":5959},"formatted_output":"","status":"completed"}}
