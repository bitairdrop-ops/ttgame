\"moonwater\": [.indigo.opacity(0.38), .cyan.opacity(0.42), .white.opacity(0.62), .mint.opacity(0.34), .purple.opacity(0.36)],\n   990\t        \"meadow-light\": [.green.opacity(0.45), .yellow.opacity(0.45), .mint.opacity(0.5), .pink.opacity(0.36), .white.opacity(0.58)],\n   991\t        \"snow-peach\": [.white.opacity(0.72), .pink.opacity(0.36), .cyan.opacity(0.34), .yellow.opacity(0.32), .blue.opacity(0.26)],\n   992\t        \"ocean-glass\": [.cyan.opacity(0.56), .blue.opacity(0.42), .mint.opacity(0.42), .white.opacity(0.62), .teal.opacity(0.48)],\n   993\t        \"bamboo-haze\": [.green.opacity(0.52), .mint.opacity(0.42), .yellow.opacity(0.34), .white.opacity(0.54), .teal.opacity(0.36)]\n   994\t    ]\n   995\t    if let selected = named[name] { return selected }\n   996\t    let all = Array(named.values)\n   997\t    let index = abs((track?.title.hashValue ?? seed) + seed) % all.count\n   998\t    return all[index]\n   999\t}\n  1000\t\n  1001\tprivate func drawRemotionScene(\n  1002\t    scene: Int,\n  1003\t    variant: Int,\n  1004\t    density: Double,\n  1005\t    phase: Double,\n  1006\t    beat: Double,\n  1007\t    energy: Double,\n  1008\t    colors: [Color],\n  1009\t    size: CGSize,\n  1010\t    context: inout GraphicsContext\n  1011\t) {\n  1012\t    let minSide = min(size.width, size.height)\n  1013\t    let center = CGPoint(x: size.width / 2, y: size.height / 2)\n  1014\t\n  1015\t    func wave(_ offset: Double = 0, cycles: Double = 1) -> Double {\n  1016\t        sin((phase * cycles + offset) * .pi * 2)\n  1017\t    }\n  1018\t\n  1019\t    func drawRibbon(_ lane: Int, amplitude: Double, alpha: Double) {\n  1020\t        var path = Path()\n  1021\t        let yBase = size.height * (0.18 + CGFloat(lane) * 0.15)\n  1022\t        path.move(to: CGPoint(x: -size.width * 0.08, y: yBase))\n  1023\t        for step in 0...10 {\n  1024\t            let x = size.width * CGFloat(step) / 9\n  1025\t            let y = yBase + CGFloat(wave(Double(step) * 0.