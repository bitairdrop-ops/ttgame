1.4 + CGFloat(energy) * 9, lineCap: .round))\n  1029\t    }\n  1030\t\n  1031\t    func drawOrb(_ i: Int, radiusScale: Double, alpha: Double, reverse: Bool = false) {\n  1032\t        let direction = reverse ? -1.0 : 1.0\n  1033\t        let angle = (phase * direction * Double(1 + i % 3) + Double(i) * 0.197) * .pi * 2\n  1034\t        let radius = minSide * CGFloat(radiusScale) * CGFloat(0.5 + beat * 0.2)\n  1035\t        let point = CGPoint(\n"}}
