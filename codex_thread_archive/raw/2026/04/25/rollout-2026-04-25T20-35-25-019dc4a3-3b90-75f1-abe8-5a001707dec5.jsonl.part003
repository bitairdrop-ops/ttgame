\n}\n\nfunction readManifest() {\n  if (!fs.existsSync(manifestPath)) return [];\n  return JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));\n}\n\nfunction writeManifest(entries) {\n  fs.mkdirSync(outputDir, { recursive: true });\n  fs.writeFileSync(manifestPath, JSON.stringify(entries, null, 2) + \"\\n\");\n}\n\nfunction existingBatchCount(manifest) {\n  return manifest.filter((entry) => String(entry.file || \"\").includes(`${batchPrefix}-`)).length;\n}\n\nasync function generateOne(item, index) {\n  const [title, stylePrompt] = item;\n  const response = await fetch(endpoint, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${apiKey()}`,\n    },\n    body: JSON.stringify({\n      model,\n      prompt: `${stylePrompt}. Full arrangement with intro, development, and clean ending, high musicality, commercial quality, distinctive hook, avoid muddy mix.`,\n      is_instrumental: true,\n      output_format: \"url\",\n      audio_setting: { sample_rate: 44100, bitrate: 256000, format: \"mp3\" },\n    }),\n  });\n\n  const raw = await response.text();\n  if (!response.ok) throw new Error(`request failed ${response.status}: ${raw}`);\n  const json = JSON.parse(raw);\n  const baseResp = json.base_resp || {};\n  if (baseResp.status_code !== 0) throw new Error(`generation failed: ${baseResp.status_msg || \"unknown error\"}`);\n  const audioUrl = json.data?.audio;\n  if (!audioUrl || !/^https?:\\/\\//.test(audioUrl)) throw new Error(\"generation returned no audio url\");\n\n  const fileName = `${batchPrefix}-${String(index).padStart(2, \"0\")}-${slug(title)}.mp3`;\n  const outputPath = path.join(outputDir, fileName);\n  const audio = await fetch(audioUrl);\n  if (!audio.ok) throw new Error(`download failed ${audio.status}: ${await audio.text()}`);\n  const bytes = Buffer.from(await audio.arrayBuffer());\n  fs.writeFileSync(outputPath, bytes);\n\n  return {\n    title,\n    mode: \"Instrumental\",\n    prompt: stylePrompt,\n    file: `seed_music/${fileName}`,\n    bytes: bytes.length,\n    durationMs: json.extra_info?.music_duration ?? null,\n    source: \"Suno-style instrumental batch\",\n    generatedAt: new Date().toISOString(),\n  };\n}\n\nasync function generateWithRetry(item, index, attempts = 3) {\n  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    try {\n      console.log(`[${index}/${targetCount}] request${attempt > 1 ? ` retry ${attempt}/${attempts}` : \"\"}: ${item[0]}`);\n      const entry = await generateOne(item, index);\n      console.log(`[${index}/${targetCount}] done: ${entry.title} ${(entry.bytes / 1024 / 1024).toFixed(2)} MB`);\n      return entry;\n    } catch (error) {\n      console.error(`[${index}/${targetCount}] failed attempt ${attempt}: ${error.message}`);\n      if (String(error.message).includes(\"daily usage limit reached\")) throw error;\n      if (attempt < attempts) await new Promise((resolve) => setTimeout(resolve, 15000 * attempt));\n    }\n  }\n  return null;\n}\n\nfs.mkdirSync(outputDir, { recursive: true });\nconst manifest = readManifest();\nlet completed = existingBatchCount(manifest);\nlet failed = 0;\n\nfor (const item of prompts.slice(0, targetCount)) {\n  const index = prompts.indexOf(item) + 1;\n  const fileName = `${batchPrefix}-${String(index).padStart(2, \"0\")}-${slug(item[0])}.mp3`;\n  const exists = manifest.some((entry) => path.basename(entry.file || \"\") === fileName)\n    && fs.existsSync(path.join(outputDir, fileName));\n  if (exists) {\n    console.log(`[${index}/${targetCount}] skip existing: ${item[0]}`);\n    continue;\n  }\n\n  const entry = await generateWithRetry(item, index);\n  if (entry) {\n    const nextManifest = readManifest().filter((track) => path.basename(track.file || \"\") !== fileName).concat(entry);\n    writeManifest(nextManifest);\n    completed += 1;\n  } else {\n    failed += 1;\n  }\n}\n\nconst finalManifest = readManifest();\nconsole.log(JSON.stringify({\n  generatedBatch: existingBatchCount(finalManifest),\n  totalManifest: finalManifest.length,\n  instrumental: finalManifest.filter((entry) => entry.mode === \"Instrumental\").length,\n  song: finalManifest.filter((entry) => entry.mode === \"Song\").length,\n  failed,\n}, null, 2));\n"}}
