ar body: some View {\n+        VStack(alignment: .leading, spacing: 18) {\n+            HStack(alignment: .top, spacing: 14) {\n+                ZStack {\n+                    Circle()\n+                        .fill(Color(red: 0.05, green: 0.58, blue: 0.49))\n+                    Text(\"A\")\n+                        .font(.system(size: 28, weight: .black))\n+                        .foregroundStyle(.white)\n+                }\n+                .frame(width: 68, height: 68)\n+\n+                VStack(alignment: .leading, spacing: 6) {\n+                    Text(\"Muse User\")\n+                        .font(.title2.bold())\n+                    Text(localized(\"AiMuse member\", language))\n+                        .font(.subheadline.weight(.semibold))\n+                        .foregroundStyle(.secondary)\n+                }\n+                Spacer()\n+                CreatePill(text: localized(\"Active\", language), system: \"checkmark.seal.fill\")\n+            }\n+\n+            HStack(spacing: 10) {\n+                AccountCreditTile(value: \"12,800\", title: localized(\"Credits\", language))\n+                AccountCreditTile(value: \"\\(worksCount)\", title: localized(\"Works\", language))\n+                AccountCreditTile(value: \"\\(favoriteCount)\", title: localized(\"Saved\", language))\n+            }\n+\n+            Button(action: {}) {\n+                Label(localized(\"Recharge\", language), systemImage: \"plus.circle.fill\")\n+                    .font(.headline)\n+                    .frame(maxWidth: .infinity)\n+                    .padding(.vertical, 16)\n+                    .foregroundStyle(.white)\n+                    .background(Color(red: 0.05, green: 0.58, blue: 0.49), in: RoundedRectangle(cornerRadius: 18))\n+            }\n+        }\n+        .padding(18)\n+        .background {\n+            ZStack {\n+                AnimatedMusicBackground(track: nil, isPlaying: true)\n+                    .opacity(0.34)\n+                Line