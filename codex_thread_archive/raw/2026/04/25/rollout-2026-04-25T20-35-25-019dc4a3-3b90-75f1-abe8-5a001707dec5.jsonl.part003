                     store.cyclePlaybackMode()\n   527\t                        }\n   528\t                    }\n   529\t                }\n   530\t                Spacer()\n   531\t                if let track = store.currentTrack {\n   532\t                    VStack(alignment: .leading, spacing: 12) {\n   533\t                        HStack {\n   534\t                            tag(track.mode.rawValue)\n   535\t                            tag(track.mood)\n   536\t                            if let duration = track.durationMs {\n   537\t                                tag(formatDuration(duration))\n   538\t                            }\n   539\t                        }\n   540\t                        Text(track.title)\n   541\t                            .font(.system(size: 30, weight: .black))\n   542\t                            .foregroundStyle(Color(red: 0.08, green: 0.11, blue: 0.18))\n   543\t                            .lineLimit(3)\n   544\t                        ProgressView(value: store.progress)\n   545\t                            .tint(Color(red: 0.05, green: 0.58, blue: 0.49))\n   546\t                            .opacity(0.7)\n   547\t                    }\n   548\t                }\n   549\t            }\n   550\t            .padding(.horizontal, 18)\n   551\t            .padding(.top, 16)\n   552\t            .padding(.bottom, 104)\n   553\t\n   554\t            if !store.isPlaying {\n   555\t                Button {\n   556\t                    store.playCurrent()\n   557\t                } label: {\n   558\t                    Image(systemName: \"play.fill\")\n   559\t                        .font(.system(size: 34, weight: .bold))\n   560\t                        .foregroundStyle(.white)\n   561\t                        .frame(width: 92, height: 92)\n   562\t                        .background(.black.opacity(0.28), in: Circle())\n   563\t                }\n   564\t                .buttonStyle(.plain)\n   565\t            }\n   566\t        }\n   567\t        .gesture(\n   568\t            DragGesture(minimumDistance: 30).onEnded { value in\n   569\t                if value.translation.height < -40 { store.nextTrack() }\n   570\t                if value.translation.height > 40 { store.previousTrack() }\n   571\t            }\n   572\t        )\n   573\t        .onReceive(Timer.publish(every: 0.5, on: .main, in: .common).autoconnect()) { _ in\n   574\t            store.updateProgress()\n   575\t        }\n   576\t    }\n   577\t\n   578\t    private func tag(_ text: String) -> some View {\n   579\t        Text(text)\n   580\t            .font(.caption.weight(.semibold))\n   581\t            .padding(.horizontal, 12)\n   582\t            .padding(.vertical, 8)\n   583\t            .background(.white.opacity(0.72), in: Capsule())\n   584\t    }\n   585\t}\n   586\t\n   587\tstruct ScopeBar: View {\n   588\t    @EnvironmentObject private var store: MusicStore\n   589\t\n   590\t    var body: some View {\n   591\t        ScrollView(.horizontal, showsIndicators: false) {\n   592\t            HStack(spacing: 8) {\n   593\t                ForEach(FeedScope.allCases) { scope in\n   594\t                    Button {\n   595\t                        store.setScope(scope)\n   596\t                    } label: {\n   597\t                        Text(scope.rawValue)\n   598\t                            .font(.caption.weight(.bold))\n   599\t                            .padding(.horizontal, 16)\n   600\t                            .padding(.vertical, 12)\n   601\t                            .foregroundStyle(store.scope == scope ? .white : Color(red: 0.17, green: 0.2, blue: 0.27))\n   602\t                            .background(store.scope == scope ? Color(red: 0.08, green: 0.11, blue: 0.18) : .white.opacity(0.72), in: Capsule())\n   603\t                    }\n   604\t                }\n   605\t            }\n   606\t        }\n   607\t    }\n   608\t}\n   609\t\n   610\tstruct CreateView: View {\n   611\t    @Envir