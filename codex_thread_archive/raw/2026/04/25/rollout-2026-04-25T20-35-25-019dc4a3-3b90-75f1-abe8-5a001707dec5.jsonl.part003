{"timestamp":"2026-04-30T12:49:00.625Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_rF7TFLYemeWeqJx7T9Hk9iV8","process_id":"51048","turn_id":"019dde6e-ddc9-7793-a7af-e76edb1fee05","command":["/bin/zsh","-lc","sed -n '1,220p' scripts/generate_ios_app_icon.mjs"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"read","cmd":"sed -n '1,220p' scripts/generate_ios_app_icon.mjs","name":"generate_ios_app_icon.mjs","path":"scripts/generate_ios_app_icon.mjs"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"import fs from \"node:fs\";\nimport path from \"node:path\";\nimport zlib from \"node:zlib\";\n\nconst outputDir = \"ios/AiMuse/AiMuse/Assets.xcassets/AppIcon.appiconset\";\nfs.mkdirSync(outputDir, { recursive: true });\n\nconst entries = [\n  [\"Icon-20@2x.png\", \"iphone\", \"20x20\", \"2x\"],\n  [\"Icon-20@3x.png\", \"iphone\", \"20x20\", \"3x\"],\n  [\"Icon-29@2x.png\", \"iphone\", \"29x29\", \"2x\"],\n  [\"Icon-29@3x.png\", \"iphone\", \"29x29\", \"3x\"],\n  [\"Icon-40@2x.png\", \"iphone\", \"40x40\", \"2x\"],\n  [\"Icon-40@3x.png\", \"iphone\", \"40x40\", \"3x\"],\n  [\"Icon-60@2x.png\", \"iphone\", \"60x60\", \"2x\"],\n  [\"Icon-60@3x.png\", \"iphone\", \"60x60\", \"3x\"],\n  [\"Icon-20-ipad.png\", \"ipad\", \"20x20\", \"1x\"],\n  [\"Icon-20@2x-ipad.png\", \"ipad\", \"20x20\", \"2x\"],\n  [\"Icon-29-ipad.png\", \"ipad\", \"29x29\", \"1x\"],\n  [\"Icon-29@2x-ipad.png\", \"ipad\", \"29x29\", \"2x\"],\n  [\"Icon-40-ipad.png\", \"ipad\", \"40x40\", \"1x\"],\n  [\"Icon-40@2x-ipad.png\", \"ipad\", \"40x40\", \"2x\"],\n  [\"Icon-76-ipad.png\", \"ipad\", \"76x76\", \"1x\"],\n  [\"Icon-76@2x-ipad.png\", \"ipad\", \"76x76\", \"2x\"],\n  [\"Icon-83.5@2x-ipad.png\", \"ipad\", \"83.5x83.5\", \"2x\"],\n  [\"Icon-1024.png\", \"ios-marketing\", \"1024x1024\", \"1x\"],\n];\n\nconst crcTable = Array.from({ length: 256 }, (_, value) => {\n  let crc = value;\n  for (let bit = 0; bit < 8; bit += 1) {\n    crc = crc & 1 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;\n  }\n  return crc >>> 0;\n});\n\nfunction crc32(buffer) {\n  let crc = -1;\n  for (const byte of buffer) {\n    crc = (crc >>> 8) ^ crcTable[(crc ^ byte) & 255];\n  }\n  return (crc ^ -1) >>> 0;\n}\n\nfunction chunk(type, data) {\n  const typeBuffer = Buffer.from(type);\n  const length = Buffer.alloc(4);\n  length.writeUInt32BE(data.length);\n  const checksum = Buffer.alloc(4);\n  checksum.writeUInt32BE(crc32(Buffer.concat([typeBuffer, data])));\n  return Buffer.concat([length, typeBuffer, data, checksum]);\n}\n\nfunction png(width, height, rgba) {\n  const raw = Buffer.alloc((width * 4 + 1) * height);\n  for (let y = 0; y < height; y += 1) {\n    raw[y * (width * 4 + 1)] = 0;\n    rgba.copy(raw, y * (width * 4 + 1) + 1, y * width * 4, (y + 1) * width * 4);\n  }\n  const header = Buffer.alloc(13);\n  header.writeUInt32BE(width, 0);\n  header.writeUInt32BE(height, 4);\n  header[8] = 8;\n  header[9] = 6;\n  return Buffer.concat([\n    Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),\n    chunk(\"IHDR\", header),\n    chunk(\"IDAT\", zlib.deflateSync(raw, { level: 9 })),\n    chunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n}\n\nfunction blend(buffer, width, height, cx, cy, radius, color) {\n  const minY = Math.max(0, Math.floor(cy - radius));\n  const maxY = Math.min(height, Math.ceil(cy + radius));\n  const minX = Math.max(0, Math.floor(cx - radius));\n  const maxX = Math.min(width, Math.ceil(cx + radius));\n  for (let y = minY; y < maxY; y += 1) {\n    for (let x = minX; x < maxX; x += 1) {\n      const dx = x + 0.5 - cx;\n      const dy = y + 0.5 - cy;\n      const distance = Math.sqrt(dx * dx + dy * dy);\n      if (distance > radius) continue;\n      const coverage = Math.max(0, Math.min(1, (radius - distance) * 1.2));\n      const alpha = coverage * color[3];\n      const offset = (y * width + x) * 4;\n      buffer[offset] = Math.round(buffer[offset] * (1 - alpha) + color[0] * alpha);\n      buffer[offset + 1] = Math.round(buffer[offset + 1] * (1 - alpha) + color[1] * alpha);\n      buffer[offset + 2] = Math.round(buffer[offset + 2] * (1 - alpha) + color[2] * alpha);\n      buffer[offset + 3] = 255;\n    }\n  }\n}\n\nfunction render(size) {\n  const scale = 4;\n  const width = size * scale;\n  const high = Buffer.alloc(width * width * 4);\n  for (let y = 0; y < width; y += 1) {\n    for (let x = 0; x < width; x += 1) {\n      const offset = (y * width + x) * 4;\n      high[offset] = 167;\n      high[offset + 1] = 232;\n      high[offset + 2] = 211;\n      high[offset + 3] = 255;\n    }\n  }\n\n  const cx = width * 0.5;\n  const cy = width * 0.52;\n  blend(high, width, width, cx + width * 0.04, width * 0.75, width * 0.18, [0, 0, 0, 0.14]);\n  blend(high, width, width, cx + width * 0.03, cy + width * 0.05, width * 0.225, [158, 101, 0, 1]);\n  blend(high, width, width, cx + width * 0.015, cy + width * 0.025, width * 0.21, [200, 135, 0, 1]);\n  blend(high, width, width, cx, cy, width * 0.195, [243, 178, 27, 1]);\n  blend(high, width, width, cx - width * 0.045, cy - width * 0.055, width * 0.145, [255, 216, 77, 1]);\n  blend(high, width, width, cx - width * 0.092, cy - width * 0.13, width * 0.078, [255, 239, 163, 1]);\n  blend(high, width, width, cx - width * 0.123, cy - width * 0.158, width * 0.032, [255, 255, 255, 0.7]);\n  blend(high, width, width, cx + width * 0.11, cy + width * 0.14, width * 0.13, [158, 101, 0, 0.23]);\n\n  const out = Buffer.alloc(size * size * 4);\n  for (let y = 0; y < size; y += 1) {\n    for (let x = 0; x < size; x += 1) {\n      let red = 0;\n      let green = 0;\n      let blue = 0;\n      let alpha = 0;\n      for (let yy = 0; yy < scale; yy += 1) {\n        for (let xx = 0; xx < scale; xx += 1) {\n          const offset = ((y * scale + yy) * width + (x * scale + xx)) * 4;\n          red += high[offset];\n          green += high[offset + 1];\n          blue += high[offset + 2];\n          alpha += high[offset + 3];\n        }\n      }\n      const offset = (y * size + x) * 4;\n      const count = scale * scale;\n      out[offset] = Math.round(red / count);\n      out[offset + 1] = Math.round(green / count);\n      out[offset + 2] = Math.round(blue / count);\n      out[offset + 3] = Math.round(alpha / count);\n    }\n  }\n  return png(size, size, out);\n}\n\nfunction pixels(entry) {\n  const [width] = entry[2].split(\"x\");\n  return Math.round(Number.parseFloat(width) * Number.parseInt(entry[3], 10));\n}\n\nfor (const entry of entries) {\n  fs.writeFileSync(path.join(outputDir, entry[0]), render(pixels(entry)));\n}\n\nfs.writeFileSync(\n  \"ios/AiMuse/AiMuse/Assets.xcassets/Contents.json\",\n  `${JSON.stringify({ info: { author: \"xcode\", version: 1 } }, null, 2)}\\n`\n);\n\nfs.writeFileSync(\n  path.join(outputDir, \"Contents.json\"),\n  `${JSON.stringify(\n    {\n      images: entries.map(([filename, idiom, size, scale]) => ({ filename, idiom, size, scale })),\n      info: { author: \"xcode\", version: 1 },\n    },\n    null,\n    2\n  )}\\n`\n);\n\nconsole.log(`Generated ${entries.length} iOS app icon files.`);\n","exit_code":0,"duration":{"secs":0,"nanos":7125},"formatted_output":"","status":"completed"}}
