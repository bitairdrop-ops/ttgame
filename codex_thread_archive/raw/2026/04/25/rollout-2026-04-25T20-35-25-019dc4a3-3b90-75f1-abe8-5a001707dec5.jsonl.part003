{"timestamp":"2026-04-30T14:51:09.736Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_K5pVMaPez0oDkuE4bsQgMh7k","process_id":"10038","turn_id":"019ddedf-04e1-7982-b074-fc10c21dc740","command":["/bin/zsh","-lc","sed -n '1,260p' scripts/generate_ios_random_instrumentals.mjs"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' scripts/generate_ios_random_instrumentals.mjs","name":"generate_ios_random_instrumentals.mjs","path":"scripts/generate_ios_random_instrumentals.mjs"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"import fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst rootDir = path.resolve(import.meta.dirname, \"..\");\nconst promptBankPath = path.join(rootDir, \"ios/AiMuse/AiMuse/Resources/prompt_bank.json\");\nconst outputDir = path.join(rootDir, \"ios/AiMuse/AiMuse/Resources/seed_music\");\nconst manifestPath = path.join(outputDir, \"manifest.json\");\nconst endpoint = process.env.MINIMAX_BASE_URL || \"https://api.minimax.io/v1/music_generation\";\nconst model = process.env.MINIMAX_MODEL || \"music-2.6\";\nconst targetCount = Number.parseInt(process.argv[2] || \"50\", 10);\nconst batchPrefix = process.env.IOS_MUSIC_BATCH_PREFIX || \"ios-random-instrumental\";\n\nfunction readProperties(filePath) {\n  if (!fs.existsSync(filePath)) return {};\n  return Object.fromEntries(\n    fs\n      .readFileSync(filePath, \"utf8\")\n      .split(/\\r?\\n/)\n      .map((line) => line.trim())\n      .filter((line) => line && !line.startsWith(\"#\") && line.includes(\"=\"))\n      .map((line) => {\n        const index = line.indexOf(\"=\");\n        return [line.slice(0, index).trim(), line.slice(index + 1).trim()];\n      }),\n  );\n}\n\nfunction apiKey() {\n  return (\n    process.env.MINIMAX_API_KEY?.trim() ||\n    readProperties(path.join(rootDir, \".env.local\")).MINIMAX_API_KEY ||\n    readProperties(path.join(rootDir, \"android/secrets.properties\")).MINIMAX_API_KEY ||\n    (() => {\n      throw new Error(\"MINIMAX_API_KEY is missing.\");\n    })()\n  );\n}\n\nfunction slug(value) {\n  return String(value || \"instrumental\")\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"-\")\n    .replace(/^-+|-+$/g, \"\")\n    .slice(0, 54) || \"instrumental\";\n}\n\nfunction readManifest() {\n  if (!fs.existsSync(manifestPath)) return [];\n  return JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));\n}\n\nfunction writeManifest(entries) {\n  fs.mkdirSync(outputDir, { recursive: true });\n  fs.writeFileSync(manifestPath, JSON.stringify(entries, null, 2) + \"\\n\");\n}\n\nfunction seededRandom(seed) {\n  let state = seed >>> 0;\n  return () => {\n    state = (state * 1664525 + 1013904223) >>> 0;\n    return state / 0x100000000;\n  };\n}\n\nfunction shuffled(items, seed) {\n  const copy = [...items];\n  const random = seededRandom(seed);\n  for (let i = copy.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(random() * (i + 1));\n    [copy[i], copy[j]] = [copy[j], copy[i]];\n  }\n  return copy;\n}\n\nfunction fileNameFor(item, index) {\n  return `${batchPrefix}-${String(index).padStart(2, \"0\")}-${slug(item.title)}.mp3`;\n}\n\nasync function fetchWithRetry(url, options, attempts = 3) {\n  let lastError;\n  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    try {\n      const response = await fetch(url, options);\n      if (response.status < 500 || attempt === attempts) return response;\n      lastError = new Error(`server returned ${response.status}: ${await response.text()}`);\n    } catch (error) {\n      lastError = error;\n      if (attempt === attempts) throw error;\n    }\n    await new Promise((resolve) => setTimeout(resolve, attempt * 5000));\n  }\n  throw lastError;\n}\n\nasync function generateOne(item, index) {\n  const prompt = `${item.prompt.replace(/\\b30 seconds?\\b,?\\s*/gi, \"\").trim()} Full instrumental arrangement with a clear motif, evolving sections, polished mix, no vocals.`;\n  const response = await fetchWithRetry(endpoint, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${apiKey()}`,\n    },\n    body: JSON.stringify({\n      model,\n      prompt,\n      is_instrumental: true,\n      output_format: \"url\",\n      audio_setting: {\n        sample_rate: 44100,\n        bitrate: 256000,\n        format: \"mp3\",\n      },\n    }),\n  });\n\n  const raw = await response.text();\n  if (!response.ok) throw new Error(`request failed ${response.status}: ${raw}`);\n\n  const json = JSON.parse(raw);\n  const baseResp = json.base_resp || {};\n  if (baseResp.status_code !== 0) {\n    throw new Error(baseResp.status_msg || \"music generation failed\");\n  }\n\n  const audioUrl = json.data?.audio;\n  if (!audioUrl || !/^https?:\\/\\//.test(audioUrl)) {\n    throw new Error(\"music generation returned no audio url\");\n  }\n\n  const fileName = fileNameFor(item, index);\n  const outputPath = path.join(outputDir, fileName);\n  const audioResponse = await fetchWithRetry(audioUrl, {}, 3);\n  if (!audioResponse.ok) {\n    throw new Error(`download failed ${audioResponse.status}: ${await audioResponse.text()}`);\n  }\n  const bytes = Buffer.from(await audioResponse.arrayBuffer());\n  fs.writeFileSync(outputPath, bytes);\n\n  return {\n    title: item.title,\n    mode: \"Instrumental\",\n    prompt,\n    file: `seed_music/${fileName}`,\n    bytes: bytes.length,\n    durationMs: json.extra_info?.music_duration ?? null,\n    source: \"iOS random prompt bank\",\n    generatedAt: new Date().toISOString(),\n  };\n}\n\nasync function generateWithRetry(item, index, attempts = 4) {\n  let lastError;\n  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    try {\n      console.log(`[${index}/${targetCount}] ${attempt > 1 ? `retry ${attempt}/${attempts}: ` : \"\"}${item.title}`);\n      const entry = await generateOne(item, index);\n      console.log(`[${index}/${targetCount}] done ${(entry.bytes / 1024 / 1024).toFixed(2)} MB: ${entry.title}`);\n      return entry;\n    } catch (error) {\n      lastError = error;\n      console.error(`[${index}/${targetCount}] attempt ${attempt} failed: ${error.message}`);\n      if (/daily usage limit reached|insufficient|quota/i.test(error.message)) throw error;\n      if (attempt < attempts) await new Promise((resolve) => setTimeout(resolve, attempt * 12000));\n    }\n  }\n  throw lastError;\n}\n\nfunction summarize(entries) {\n  return {\n    totalManifest: entries.length,\n    instrumental: entries.filter((entry) => entry.mode === \"Instrumental\").length,\n    song: entries.filter((entry) => entry.mode === \"Song\").length,\n    iosRandomInstrumental: entries.filter((entry) => String(entry.file || \"\").includes(`${batchPrefix}-`)).length,\n  };\n}\n\nasync function main() {\n  fs.mkdirSync(outputDir, { recursive: true });\n  const promptBank = JSON.parse(fs.readFileSync(promptBankPath, \"utf8\"));\n  const manifest = readManifest();\n  const existingPrompts = new Set(manifest.map((entry) => String(entry.prompt || \"\").replace(/\\b30 seconds?\\b,?\\s*/gi, \"\").trim()));\n  const candidates = promptBank\n    .filter((item) => item.mode !== \"Song\")\n    .filter((item) => item.prompt && !existingPrompts.has(String(item.prompt).replace(/\\b30 seconds?\\b,?\\s*/gi, \"\").trim()));\n\n  const seed = Number.parseInt(process.env.IOS_RANDOM_SEED || new Date().toISOString().slice(0, 10).replaceAll(\"-\", \"\"), 10);\n  const queue = shuffled(candidates, seed).slice(0, targetCount);\n  if (queue.length < targetCount) {\n    throw new Error(`Only ${queue.length} unused instrumental prompts available.`);\n  }\n\n  let generated = 0;\n  let failed = 0;\n  for (const [offset, item] of queue.entries()) {\n    const index = offset + 1;\n    const fileName = fileNameFor(item, index);\n    const latestManifest = readManifest();\n    const alreadyDone = latestManifest.some((entry) => path.basename(entry.file || \"\") === fileName)\n      && fs.existsSync(path.join(outputDir, fileName));\n    if (alreadyDone) {\n      console.log(`[${index}/${targetCount}] skip existing: ${item.title}`);\n      continue;\n    }\n\n    try {\n      const entry = await generateWithRetry(item, index);\n      writeManifest(\n        readManifest()\n          .filter((track) => path.basename(track.file || \"\") !== fileName)\n          .concat(entry),\n      );\n      generated += 1;\n    } catch (error) {\n      failed += 1;\n      console.error(`[${index}/${targetCount}] failed permanently: ${error.message}`);\n      if (/daily usage limit reached|insufficient|quota/i.test(error.message)) break;\n    }\n  }\n\n  console.log(JSON.stringify({ generated, failed, ...summarize(readManifest()) }, null, 2));\n}\n\nmain().catch((error) => {\n  console.error(error.message);\n  process.exit(1);\n});\n","exit_code":0,"duration":{"secs":0,"nanos":4667},"formatted_output":"","status":"completed"}}
