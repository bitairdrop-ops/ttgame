5\t}\n    76\t\n    77\tfunction readRequestBody(request, limitBytes = 1024 * 1024) {\n    78\t  return new Promise((resolve, reject) => {\n    79\t    let body = \"\";\n    80\t    request.setEncoding(\"utf8\");\n    81\t    request.on(\"data\", (chunk) => {\n    82\t      body += chunk;\n    83\t      if (Buffer.byteLength(body) > limitBytes) {\n    84\t        reject(new Error(\"request body too large\"));\n    85\t        request.destroy();\n    86\t      }\n    87\t    });\n    88\t    request.on(\"end\", () => resolve(body));\n    89\t    request.on(\"error\", reject);\n    90\t  });\n    91\t}\n    92\t\n    93\tasync function fetchWithRetry(url, options, attempts = 3, timeoutMs = 300000) {\n    94\t  let lastError;\n    95\t  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    96\t    const controller = new AbortController();\n    97\t    const timeout = setTimeout(() => controller.abort(new Error(`request timed out after ${timeoutMs}ms`)), timeoutMs);\n    98\t    try {\n    99\t      log(\"fetch:attempt\", { url: safeUrl(url), attempt, timeoutMs });\n   100\t      const response = await fetch(url, { ...options, signal: controller.signal });\n   101\t      if (response.status < 500 || attempt === attempts) return response;\n   102\t      lastError = new Error(`server returned ${response.status}: ${await response.text()}`);\n   103\t      log(\"fetch:retryable-status\", { url: safeUrl(url), attempt, status: response.status });\n   104\t    } catch (error) {\n   105\t      lastError = error;\n   106\t      log(\"fetch:failed\", {\n   107\t        url: safeUrl(url),\n   108\t        attempt,\n   109\t        name: error.name,\n   110\t        code: error.code || error.cause?.code,\n   111\t        cause: error.cause?.message,\n   112\t        message: error.message,\n   113\t      });\n   114\t      if (attempt === attempts) throw e…645 chars truncated… = String(payload.title || \"Generated Track\").trim() || \"Generated Track\";\n   136\t  const p