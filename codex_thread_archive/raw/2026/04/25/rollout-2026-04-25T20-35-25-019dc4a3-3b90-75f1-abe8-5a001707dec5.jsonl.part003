gle(cornerRadius: 24).stroke(.white.opacity(0.78), lineWidth: 1))\n+    }\n+}\n+\n+struct AccountSettings: View {\n+    @Binding var language: AppLanguage\n+\n+    var body: some View {\n+        VStack(alignment: .leading, spacing: 12) {\n+            Text(localized(\"Settings\", language))\n+                .font(.headline)\n+            HStack(spacing: 12) {\n+                Image(systemName: \"globe\")\n+                    .font(.system(size: 16, weight: .bold))\n+                    .foregroundStyle(Color(red: 0.05, green: 0.58, blue: 0.49))\n+                    .frame(width: 38, height: 38)\n+                    .background(Color(red: 0.86, green: 0.96, blue: 0.93), in: Circle())\n+                VStack(alignment: .leading, spacing: 3) {\n+                    Text(localized(\"Language\", language))\n+                        .font(.subheadline.weight(.bold))\n+                    Text(language.rawValue)\n+                        .font(.caption.weight(.semibold))\n+                        .foregroundStyle(.secondary)\n+                }\n+                Spacer()\n+                LanguageMenu(language: $language, compact: false)\n+            }\n+        }\n+        .padding(16)\n+        .background(.white.opacity(0.9), in: RoundedRectangle(cornerRadius: 24))\n+        .overlay(RoundedRectangle(cornerRadius: 24).stroke(.white.opacity(0.78), lineWidth: 1))\n+    }\n+}\n+\n+struct AccountRow: View {\n+    let icon: String\n+    let title: String\n+    let value: String\n+\n+    var body: some View {\n+        HStack(spacing: 12) {\n+            Image(systemName: icon)\n+                .font(.system(size: 15, weight: .bold))\n+                .foregroundStyle(Color(red: 0.05, green: 0.58, blue: 0.49))\n+                .frame(width: 36, height: 36)\n+                .background(Color(red: 0.86, green: 0.96, blue: 0.93), in: Circle())\n+            Text(title)\n+                .font(.subheadline.weight(.bold))\n+            Spacer()\n+            Text(value)\n+                .font(.subheadline.weight(.black))\n+                .foregroundStyle(.secondary)\n+        }\n+        .padding(.vertical, 4)\n+    }\n+}\n+\n+struct LanguageMenu: View {\n+    @Binding var language: AppLanguage\n+    let compact: Bool\n+\n+    var body: some View {\n+        Menu {\n+            ForEach(AppLanguage.allCases) { option in\n+                Button(option.rawValue) { language = option }\n+            }\n+        } label: {\n+            HStack(spacing: compact ? 0 : 6) {\n+                Image(systemName: \"globe\")\n+                    .font(.system(size: 16, weight: .bold))\n+                if !compact {\n+                    Text(language.rawValue)\n+                        .font(.caption.weight(.bold))\n+                        .lineLimit(1)\n+                    Image(systemName: \"chevron.down\")\n+                        .font(.caption2.weight(.bold))\n+                }\n+            }\n+            .foregroundStyle(Color(red: 0.08, green: 0.11, blue: 0.18))\n+            .frame(width: compact ? 44 : nil, height: 44)\n+            .padding(.horizontal, compact ? 0 : 14)\n+            .background(.white.opacity(0.86), in: Capsule())\n+            .shadow(color: .black.opacity(0.05), radius: 12, y: 6)\n+        }\n+    }\n+}\n+\n struct BottomTabs: View {\n*** End Patch\n"}}
