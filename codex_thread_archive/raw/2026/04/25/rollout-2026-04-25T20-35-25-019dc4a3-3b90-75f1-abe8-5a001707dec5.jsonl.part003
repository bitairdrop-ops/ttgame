{"timestamp":"2026-04-30T11:01:35.185Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_rlOi3QZlxKokpFN9PVBZFUtO","process_id":"98658","turn_id":"019dde0b-b897-7a70-804a-4698c858020b","command":["/bin/zsh","-lc","node <<'NODE'\nconst fs = require('fs');\nconst files = [\n  'android/app/src/main/assets/prompt_bank.json',\n  'ios/AiMuse/AiMuse/Resources/prompt_bank.json'\n];\nconst themeMap = [\n  [/^rain on a quiet balcony\\b/i, 'Rain Balcony'],\n  [/^walking home after the last bus\\b/i, 'Last Bus'],\n  [/^a rooftop above traffic\\b/i, 'Rooftop Traffic'],\n  [/^a skyline reflected in water\\b/i, 'Water Skyline'],\n  [/^a tiny apartment full of dreams\\b/i, 'Tiny Dreams'],\n  [/^city rain and soft headphones\\b/i, 'City Headphones']\n];\nconst moodWords = new Set('sunlit late dream emotional uplifting acoustic modern lofi lo-fi cinematic afro k-pop kpop latin city melodic ambient country punky dark jazz hyperpop lite introspective playful triumphant raw neon nostalgic driving tender melancholic serene glossy rain soaked expansive floating hopeful restless haunting meditative intimate oceanic nocturnal weightless warm romantic electric festival ready earthy bittersweet confident mysterious golden hour futuristic euphoric'.split(/\\s+/));\nconst stopWords = new Set('a an the and of in on at above after before with for to from full reflected quiet soft last'.split(/\\s+/));\nfunction words(value) {\n  return String(value).match(/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)?/g) || [];\n}\nfunction titleCase(value) {\n  return words(value).map((word) => {\n    if (/^(r&b|idm)$/i.test(word)) return word.toUpperCase();\n    if (/^(j|k|uk)$/i.test(word)) return word.toUpperCase();\n    if (/^lo-fi$/i.test(word)) return 'Lo-fi';\n    return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();\n  }).join(' ');\n}\nfunction compactSongTitle(title) {\n  const original = String(title).trim();\n  const stripped = original\n    .replace(/\\bSong\\b.*$/i, '')\n    .replace(/\\bInstrumental\\b.*$/i, '')\n    .replace(/\\s+\\d+\\s*$/g, '')\n    .trim();\n  if (words(original).length <= 4) return original;\n\n  for (const [pattern, base] of themeMap) {\n    if (!pattern.test(stripped)) continue;\n    const rest = stripped.replace(pattern, '').trim();\n    const style = words(rest)\n      .filter((word) => !moodWords.has(word.toLowerCase()))\n      .filter((word) => !stopWords.has(word.toLowerCase()))\n      .slice(-2);\n    const combined = [...words(base), ...style].slice(0, 4).join(' ');\n    return titleCase(combined || base);\n  }\n\n  const meaningful = words(stripped)\n    .filter((word) => !stopWords.has(word.toLowerCase()))\n    .slice(0, 4);\n  return titleCase(meaningful.join(' ') || 'Muse Song');\n}\nfor (const file of files) {\n  const data = JSON.parse(fs.readFileSync(file, 'utf8'));\n  let changed = 0;\n  for (const entry of data) {\n    if (entry.mode !== 'Song') continue;\n    const next = compactSongTitle(entry.title);\n    if (next !== entry.title) {\n      entry.title = next;\n      changed += 1;\n    }\n  }\n  fs.writeFileSync(file, `${JSON.stringify(data, null, 2)}\\n`);\n  const bad = data.filter((entry) => entry.mode === 'Song' && words(entry.title).length > 4);\n  console.log(`${file}: changed=${changed}, bad=${bad.length}`);\n  if (bad.length) console.log(bad.slice(0, 5).map((entry) => entry.title).join('\\n'));\n}\nNODE"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"unknown","cmd":"node <<'NODE'\nconst fs = require('fs');\nconst files = [\n  'android/app/src/main/assets/prompt_bank.json',\n  'ios/AiMuse/AiMuse/Resources/prompt_bank.json'\n];\nconst themeMap = [\n  [/^rain on a quiet balcony\\b/i, 'Rain Balcony'],\n  [/^walking home after the last bus\\b/i, 'Last Bus'],\n  [/^a rooftop above traffic\\b/i, 'Rooftop Traffic'],\n  [/^a skyline reflected in water\\b/i, 'Water Skyline'],\n  [/^a tiny apartment full of dreams\\b/i, 'Tiny Dreams'],\n  [/^city rain and soft headphones\\b/i, 'City Headphones']\n];\nconst moodWords = new Set('sunlit late dream emotional uplifting acoustic modern lofi lo-fi cinematic afro k-pop kpop latin city melodic ambient country punky dark jazz hyperpop lite introspective playful triumphant raw neon nostalgic driving tender melancholic serene glossy rain soaked expansive floating hopeful restless haunting meditative intimate oceanic nocturnal weightless warm romantic electric festival ready earthy bittersweet confident mysterious golden hour futuristic euphoric'.split(/\\s+/));\nconst stopWords = new Set('a an the and of in on at above after before with for to from full reflected quiet soft last'.split(/\\s+/));\nfunction words(value) {\n  return String(value).match(/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)?/g) || [];\n}\nfunction titleCase(value) {\n  return words(value).map((word) => {\n    if (/^(r&b|idm)$/i.test(word)) return word.toUpperCase();\n    if (/^(j|k|uk)$/i.test(word)) return word.toUpperCase();\n    if (/^lo-fi$/i.test(word)) return 'Lo-fi';\n    return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();\n  }).join(' ');\n}\nfunction compactSongTitle(title) {\n  const original = String(title).trim();\n  const stripped = original\n    .replace(/\\bSong\\b.*$/i, '')\n    .replace(/\\bInstrumental\\b.*$/i, '')\n    .replace(/\\s+\\d+\\s*$/g, '')\n    .trim();\n  if (words(original).length <= 4) return original;\n\n  for (const [pattern, base] of themeMap) {\n    if (!pattern.test(stripped)) continue;\n    const rest = stripped.replace(pattern, '').trim();\n    const style = words(rest)\n      .filter((word) => !moodWords.has(word.toLowerCase()))\n      .filter((word) => !stopWords.has(word.toLowerCase()))\n      .slice(-2);\n    const combined = [...words(base), ...style].slice(0, 4).join(' ');\n    return titleCase(combined || base);\n  }\n\n  const meaningful = words(stripped)\n    .filter((word) => !stopWords.has(word.toLowerCase()))\n    .slice(0, 4);\n  return titleCase(meaningful.join(' ') || 'Muse Song');\n}\nfor (const file of files) {\n  const data = JSON.parse(fs.readFileSync(file, 'utf8'));\n  let changed = 0;\n  for (const entry of data) {\n    if (entry.mode !== 'Song') continue;\n    const next = compactSongTitle(entry.title);\n    if (next !== entry.title) {\n      entry.title = next;\n      changed += 1;\n    }\n  }\n  fs.writeFileSync(file, `${JSON.stringify(data, null, 2)}\\n`);\n  const bad = data.filter((entry) => entry.mode === 'Song' && words(entry.title).length > 4);\n  console.log(`${file}: changed=${changed}, bad=${bad.length}`);\n  if (bad.length) console.log(bad.slice(0, 5).map((entry) => entry.title).join('\\n'));\n}\nNODE"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"android/app/src/main/assets/prompt_bank.json: changed=2540, bad=0\nios/AiMuse/AiMuse/Resources/prompt_bank.json: changed=2540, bad=0\n","exit_code":0,"duration":{"secs":0,"nanos":2250},"formatted_output":"","status":"completed"}}
