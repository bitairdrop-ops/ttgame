{"timestamp":"2026-05-01T23:17:29.537Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_63vW2ONukY4PjhRIKb9bLUmy","process_id":"86327","turn_id":"019de429-7121-70e2-a023-8b7cbaa4a54c","command":["/bin/zsh","-lc","sed -n '1,220p' scripts/generate_more_instrumentals.mjs"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"read","cmd":"sed -n '1,220p' scripts/generate_more_instrumentals.mjs","name":"generate_more_instrumentals.mjs","path":"scripts/generate_more_instrumentals.mjs"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"import fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst rootDir = path.resolve(import.meta.dirname, \"..\");\nconst promptBankPath = path.join(rootDir, \"android/app/src/main/assets/prompt_bank.json\");\nconst outputDir = path.join(rootDir, \"android/app/src/main/assets/seed_music\");\nconst manifestPath = path.join(outputDir, \"manifest.json\");\nconst endpoint = \"https://api.minimax.io/v1/music_generation\";\nconst model = \"music-2.6\";\nconst targetCount = Number.parseInt(process.argv[2] || \"30\", 10);\n\nfunction readProperties(filePath) {\n  if (!fs.existsSync(filePath)) return {};\n  return Object.fromEntries(\n    fs.readFileSync(filePath, \"utf8\")\n      .split(/\\r?\\n/)\n      .map((line) => line.trim())\n      .filter((line) => line && !line.startsWith(\"#\") && line.includes(\"=\"))\n      .map((line) => {\n        const index = line.indexOf(\"=\");\n        return [line.slice(0, index).trim(), line.slice(index + 1).trim()];\n      }),\n  );\n}\n\nfunction apiKey() {\n  return process.env.MINIMAX_API_KEY?.trim()\n    || readProperties(path.join(rootDir, \".env.local\")).MINIMAX_API_KEY\n    || readProperties(path.join(rootDir, \"android/secrets.properties\")).MINIMAX_API_KEY\n    || (() => { throw new Error(\"MINIMAX_API_KEY is missing.\"); })();\n}\n\nfunction slug(value) {\n  return value.toLowerCase().replace(/[^a-z0-9]+/g, \"-\").replace(/^-+|-+$/g, \"\").slice(0, 58);\n}\n\nfunction readManifest() {\n  if (!fs.existsSync(manifestPath)) return [];\n  return JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));\n}\n\nfunction writeManifest(entries) {\n  fs.writeFileSync(manifestPath, JSON.stringify(entries, null, 2) + \"\\n\");\n}\n\nasync function generateOne(item, successIndex) {\n  const response = await fetch(endpoint, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${apiKey()}`,\n    },\n    body: JSON.stringify({\n      model,\n      prompt: item.prompt,\n      is_instrumental: true,\n      output_format: \"url\",\n      audio_setting: { sample_rate: 44100, bitrate: 256000, format: \"mp3\" },\n    }),\n  });\n  const raw = await response.text();\n  if (!response.ok) throw new Error(`request failed ${response.status}: ${raw}`);\n  const json = JSON.parse(raw);\n  const baseResp = json.base_resp || {};\n  if (baseResp.status_code !== 0) throw new Error(`generation failed: ${baseResp.status_msg || \"unknown error\"}`);\n  const audioUrl = json.data?.audio;\n  if (!audioUrl || !/^https?:\\/\\//.test(audioUrl)) throw new Error(\"generation returned no audio url\");\n\n  const fileName = `extra-instrumental-${String(successIndex).padStart(2, \"0\")}-${slug(item.title)}.mp3`;\n  const outputPath = path.join(outputDir, fileName);\n  console.log(`[Instrumental ${successIndex}/${targetCount}] download: ${fileName}`);\n  const audio = await fetch(audioUrl);\n  if (!audio.ok) throw new Error(`download failed ${audio.status}: ${await audio.text()}`);\n  const bytes = Buffer.from(await audio.arrayBuffer());\n  fs.writeFileSync(outputPath, bytes);\n\n  const manifest = readManifest();\n  const entry = {\n    title: item.title,\n    mode: \"Instrumental\",\n    prompt: item.prompt,\n    file: `seed_music/${fileName}`,\n    durationMs: json.extra_info?.music_duration ?? null,\n    source: \"MiniMax batch\",\n  };\n  writeManifest(manifest.filter((track) => track.file !== entry.file).concat(entry));\n  console.log(`[Instrumental ${successIndex}/${targetCount}] done: ${(bytes.length / 1024 / 1024).toFixed(2)} MB`);\n}\n\nasync function tryGenerate(item, successIndex, attempts = 3) {\n  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    try {\n      console.log(`[Instrumental ${successIndex}/${targetCount}] request${attempt > 1 ? ` retry ${attempt}/${attempts}` : \"\"}: ${item.title}`);\n      await generateOne(item, successIndex);\n      return true;\n    } catch (error) {\n      console.error(`[Instrumental ${successIndex}/${targetCount}] failed attempt ${attempt}: ${error.message}`);\n      if (attempt < attempts) await new Promise((resolve) => setTimeout(resolve, 12000 * attempt));\n    }\n  }\n  console.error(`[Instrumental ${successIndex}/${targetCount}] skip prompt after repeated failures: ${item.title}`);\n  return false;\n}\n\nconst manifest = readManifest();\nconst usedPrompts = new Set(manifest.map((entry) => entry.prompt).filter(Boolean));\nconst existingExtra = manifest.filter((entry) => String(entry.file || \"\").includes(\"extra-instrumental-\")).length;\nlet success = existingExtra;\nconst bank = JSON.parse(fs.readFileSync(promptBankPath, \"utf8\"))\n  .filter((item) => item.mode !== \"Song\" && item.prompt && !usedPrompts.has(item.prompt));\n\nfor (const item of bank) {\n  if (success >= targetCount) break;\n  const nextIndex = success + 1;\n  const ok = await tryGenerate(item, nextIndex);\n  if (ok) success += 1;\n}\n\nif (success < targetCount) {\n  throw new Error(`Only generated ${success}/${targetCount} instrumentals.`);\n}\nconsole.log(`complete: ${success} extra instrumentals added to app assets`);\n","exit_code":0,"duration":{"secs":0,"nanos":1292},"formatted_output":"","status":"completed"}}
{"timestamp":"2026-05-01T23:17:29.537Z","type":"event_msg","payload":{"type":"exec_command_end","call_id":"call_31s0C91SKOM0KTfH51xbBfAf","process_id":"1332","turn_id":"019de429-7121-70e2-a023-8b7cbaa4a54c","command":["/bin/zsh","-lc","sed -n '1,220p' scripts/generate_batch_music.mjs"],"cwd":"/Users/vincet/Desktop/aigame2","parsed_cmd":[{"type":"read","cmd":"sed -n '1,220p' scripts/generate_batch_music.mjs","name":"generate_batch_music.mjs","path":"scripts/generate_batch_music.mjs"}],"source":"unified_exec_startup","stdout":"","stderr":"","aggregated_output":"import fs from \"node:fs\";\nimport path from \"node:path\";\n\nconst rootDir = path.resolve(import.meta.dirname, \"..\");\nconst promptBankPath = path.join(rootDir, \"android/app/src/main/assets/prompt_bank.json\");\nconst outputDir = path.join(rootDir, \"android/app/src/main/assets/seed_music\");\nconst manifestPath = path.join(outputDir, \"manifest.json\");\n\nconst totalSongs = Number.parseInt(process.argv[2] || \"20\", 10);\nconst totalInstrumentals = Number.parseInt(process.argv[3] || \"20\", 10);\nconst endpoint = \"https://api.minimax.io/v1/music_generation\";\nconst model = \"music-2.6\";\n\nfunction readProperties(filePath) {\n  if (!fs.existsSync(filePath)) return {};\n  return Object.fromEntries(\n    fs\n      .readFileSync(filePath, \"utf8\")\n      .split(/\\r?\\n/)\n      .map((line) => line.trim())\n      .filter((line) => line && !line.startsWith(\"#\") && line.includes(\"=\"))\n      .map((line) => {\n        const index = line.indexOf(\"=\");\n        return [line.slice(0, index).trim(), line.slice(index + 1).trim()];\n      }),\n  );\n}\n\nfunction apiKey() {\n  const envKey = process.env.MINIMAX_API_KEY?.trim();\n  if (envKey) return envKey;\n  const localEnv = readProperties(path.join(rootDir, \".env.local\")).MINIMAX_API_KEY;\n  if (localEnv) return localEnv;\n  const secrets = readProperties(path.join(rootDir, \"android/secrets.properties\")).MINIMAX_API_KEY;\n  if (secrets) return secrets;\n  throw new Error(\"MINIMAX_API_KEY is missing.\");\n}\n\nfunction slug(value) {\n  return value\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"-\")\n    .replace(/^-+|-+$/g, \"\")\n    .slice(0, 64);\n}\n\nfunction batchFileName(item, mode, index) {\n  const prefix = mode === \"Song\" ? \"song\" : \"instrumental\";\n  return `batch-${prefix}-${String(index).padStart(2, \"0\")}-${slug(item.title)}.mp3`;\n}\n\nfunction defaultLyrics(title) {\n  return `[Verse]\nI carry sparks through the quiet street\nEvery step finds a brighter beat\nIf the night gets heavy on my mind\nI leave a little silver line\n\n[Chorus]\n${title}, lift me into light\nTurn the dark into something bright\nHold the moment, make it strong\nLet my heart become the song`;\n}\n\nfunction readManifest() {\n  if (!fs.existsSync(manifestPath)) return [];\n  return JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));\n}\n\nfunction writeManifest(entries) {\n  fs.mkdirSync(outputDir, { recursive: true });\n  fs.writeFileSync(manifestPath, JSON.stringify(entries, null, 2) + \"\\n\");\n}\n\nasync function generateOne(item, mode, index, count) {\n  const isInstrumental = mode === \"Instrumental\";\n  const body = {\n    model,\n    prompt: item.prompt,\n    is_instrumental: isInstrumental,\n    output_format: \"url\",\n    audio_setting: {\n      sample_rate: 44100,\n      bitrate: 256000,\n      format: \"mp3\",\n    },\n  };\n  if (!isInstrumental) {\n    body.lyrics = defaultLyrics(item.title);\n    body.lyrics_optimizer = false;\n  }\n\n  console.log(`[${mode} ${index}/${count}] request: ${item.title}`);\n  const response = await fetch(endpoint, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Authorization: `Bearer ${apiKey()}`,\n    },\n    body: JSON.stringify(body),\n  });\n  const raw = await response.text();\n  if (!response.ok) {\n    throw new Error(`request failed ${response.status}: ${raw}`);\n  }\n  const json = JSON.parse(raw);\n  const baseResp = json.base_resp || {};\n  if (baseResp.status_code !== 0) {\n    throw new Error(`generation failed: ${baseResp.status_msg || \"unknown error\"}`);\n  }\n  const audioUrl = json.data?.audio;\n  if (!audioUrl || !/^https?:\\/\\//.test(audioUrl)) {\n    throw new Error(\"generation returned no audio url\");\n  }\n\n  const fileName = batchFileName(item, mode, index);\n  const filePath = path.join(outputDir, fileName);\n  console.log(`[${mode} ${index}/${count}] download: ${fileName}`);\n  const audioResponse = await fetch(audioUrl);\n  if (!audioResponse.ok) {\n    throw new Error(`download failed ${audioResponse.status}: ${await audioResponse.text()}`);\n  }\n  const bytes = Buffer.from(await audioResponse.arrayBuffer());\n  fs.writeFileSync(filePath, bytes);\n  console.log(`[${mode} ${index}/${count}] done: ${(bytes.length / 1024 / 1024).toFixed(2)} MB`);\n\n  return {\n    title: item.title,\n    mode,\n    prompt: item.prompt,\n    file: `seed_music/${fileName}`,\n    bytes: bytes.length,\n    durationMs: json.extra_info?.music_duration ?? null,\n    generatedAt: new Date().toISOString(),\n  };\n}\n\nasync function generateWithRetry(task, attempts = 5) {\n  let lastError;\n  for (let attempt = 1; attempt <= attempts; attempt += 1) {\n    try {\n      if (attempt > 1) {\n        console.log(`[${task.mode} ${task.index}/${task.count}] retry ${attempt}/${attempts}: ${task.item.title}`);\n      }\n      return await generateOne(task.item, task.mode, task.index, task.count);\n    } catch (error) {\n      lastError = error;\n      console.error(`[${task.mode} ${task.index}/${task.count}] attempt ${attempt} failed: ${error.message}`);\n      if (attempt < attempts) {\n        await new Promise((resolve) => setTimeout(resolve, 12000 * attempt));\n      }\n    }\n  }\n  throw lastError;\n}\n\nasync function main() {\n  fs.mkdirSync(outputDir, { recursive: true });\n  const bank = JSON.parse(fs.readFileSync(promptBankPath, \"utf8\"));\n  const songs = bank.filter((item) => item.mode === \"Song\").slice(0, totalSongs);\n  const instrumentals = bank.filter((item) => item.mode !== \"Song\").slice(0, totalInstrumentals);\n  const queue = [\n    ...songs.map((item, index) => ({ item, mode: \"Song\", index: index + 1, count: totalSongs })),\n    ...instrumentals.map((item, index) => ({ item, mode: \"Instrumental\", index: index + 1, count: totalInstrumentals })),\n  ];\n\n  const manifest = readManifest();\n  for (const task of queue) {\n    const expectedFile = batchFileName(task.item, task.mode, task.index);\n    const alreadyDone = manifest.find((entry) => path.basename(entry.file || \"\") === expectedFile);\n    if (alreadyDone && fs.existsSync(path.join(outputDir, expectedFile))) {\n      console.log(`[${task.mode} ${task.index}/${task.count}] skip existing: ${task.item.title}`);\n      continue;\n    }\n    const entry = await generateWithRetry(task);\n    manifest.push(entry);\n    writeManifest(manifest);\n  }\n\n  const songCount = manifest.filter((entry) => entry.mode === \"Song\").length;\n  const instrumentalCount = manifest.filter((entry) => entry.mode === \"Instrumental\").length;\n  console.log(`complete: ${songCount} songs, ${instrumentalCount} instrumentals`);\n  console.log(`app assets manifest: ${path.relative(rootDir, manifestPath)}`);\n}\n\nmain().catch((error) => {\n  console.error(error.message);\n  process.exit(1);\n});\n","exit_code":0,"duration":{"secs":0,"nanos":4916},"formatted_output":"","status":"completed"}}
