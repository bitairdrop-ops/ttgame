{"timestamp":"2026-05-01T20:18:37.667Z","type":"response_item","payload":{"type":"custom_tool_call","status":"completed","call_id":"call_c0PWU7J8Yk1sm75pDcnbH5CY","name":"apply_patch","input":"*** Begin Patch\n*** Update File: scripts/generate_ios_suno_style_instrumentals.mjs\n@@\n const rootDir = path.resolve(import.meta.dirname, \"..\");\n+const promptBankPath = path.join(rootDir, \"ios/AiMuse/AiMuse/Resources/prompt_bank.json\");\n const outputDir = path.join(rootDir, \"ios/AiMuse/AiMuse/Resources/seed_music\");\n const manifestPath = path.join(outputDir, \"manifest.json\");\n@@\n-async function fetchWithRetry(url, options, attempts = 3) {\n+async function fetchWithRetry(url, options, attempts = 1, timeoutMs = 240000) {\n   let lastError;\n   for (let attempt = 1; attempt <= attempts; attempt += 1) {\n+    const controller = new AbortController();\n+    const timeout = setTimeout(() => controller.abort(new Error(`request timed out after ${timeoutMs}ms`)), timeoutMs);\n     try {\n-      const response = await fetch(url, options);\n+      const response = await fetch(url, { ...options, signal: controller.signal });\n       if (response.status < 500 || attempt === attempts) return response;\n       lastError = new Error(`server returned ${response.status}: ${await response.text()}`);\n     } catch (error) {\n       lastError = error;\n       if (attempt === attempts) throw error;\n+    } finally {\n+      clearTimeout(timeout);\n     }\n     await new Promise((resolve) => setTimeout(resolve, attempt * 6000));\n   }\n@@\n async function generateOne([title, stylePrompt], index) {\n-  const prompt = `${stylePrompt}. Full instrumental arrangement with intro, development, breakdown, final hook, clean ending, commercial-quality dynamics, no artist names.`;\n+  const prompt = `${stylePrompt.replace(/\\b30 seconds?\\b,?\\s*/gi, \"\").trim()}, polished instrumental mix, clear hook, no vocals.`;\n@@\n-  const audioResponse = await fetchWithRetry(audioUrl, {}, 3);\n+  const audioResponse = await fetchWithRetry(audioUrl, {}, 3, 180000);\n@@\n-async function generateWithRetry(item, index, attempts = 4) {\n+async function generateWithRetry(item, index, attempts = 1) {\n@@\n fs.mkdirSync(outputDir, { recursive: true });\n let generated = 0;\n let failed = 0;\n+const promptBank = fs.existsSync(promptBankPath)\n+  ? JSON.parse(fs.readFileSync(promptBankPath, \"utf8\"))\n+  : [];\n+const bankPrompts = promptBank\n+  .filter((item) => item.mode !== \"Song\")\n+  .map((item) => [item.title, item.prompt])\n+  .filter(([title, prompt]) => title && prompt);\n+const queue = [...prompts, ...bankPrompts];\n \n-for (const [offset, item] of prompts.slice(0, targetCount).entries()) {\n+for (const [offset, item] of queue.entries()) {\n+  if (generated >= targetCount) break;\n   const index = offset + 1;\n*** End Patch\n"}}
