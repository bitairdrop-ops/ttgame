{"timestamp":"2026-04-30T11:02:26.248Z","type":"response_item","payload":{"type":"custom_tool_call","status":"completed","call_id":"call_bCdzWZ9XKqON2g3LfSx3nZX8","name":"apply_patch","input":"*** Begin Patch\n*** Update File: tools/expand_prompt_bank.mjs\n@@\n function uniqueTitle(base, suffix) {\n   let title = titleCase(`${base} ${suffix}`.replace(/\\s+/g, \" \"));\n   let n = 2;\n   while (usedTitles.has(title)) {\n     title = `${titleCase(`${base} ${suffix}`)} ${n}`;\n@@\n   usedTitles.add(title);\n   return title;\n }\n+\n+function compactWords(text) {\n+  return titleCase(text)\n+    .split(/\\s+/)\n+    .filter(Boolean);\n+}\n+\n+function shortSongBase(theme, genre) {\n+  const themeMap = new Map([\n+    [\"rain on a quiet balcony\", \"Rain Balcony\"],\n+    [\"walking home after the last bus\", \"Last Bus\"],\n+    [\"a rooftop above traffic\", \"Rooftop Traffic\"],\n+    [\"a skyline reflected in water\", \"Water Skyline\"],\n+    [\"a tiny apartment full of dreams\", \"Tiny Dreams\"],\n+    [\"city rain and soft headphones\", \"City Headphones\"]\n+  ]);\n+  const base = themeMap.get(theme) || theme\n+    .replace(/\\b(a|an|the|and|of|in|on|at|after|above|with|for|to|from)\\b/gi, \"\")\n+    .replace(/\\s+/g, \" \")\n+    .trim();\n+  return [...compactWords(base), ...compactWords(genre)].slice(0, 4).join(\" \");\n+}\n+\n+function uniqueShortSongTitle(theme, genre) {\n+  const baseWords = compactWords(shortSongBase(theme, genre)).slice(0, 4);\n+  let words = baseWords.length ? baseWords : [\"Muse\", \"Song\"];\n+  let title = words.join(\" \");\n+  let n = 2;\n+  while (usedTitles.has(title)) {\n+    const suffix = String(n);\n+    const next = words.length >= 4 ? [...words.slice(0, 3), suffix] : [...words, suffix];\n+    title = next.join(\" \");\n+    n += 1;\n+  }\n+  usedTitles.add(title);\n+  return title;\n+}\n@@\n   const era = eras[(i * 29) % eras.length];\n   additions.push({\n-    title: uniqueTitle(theme, `${mood} ${genre} song ${i + 1}`),\n+    title: uniqueShortSongTitle(theme, genre),\n     prompt: `${genre} anthem song about ${theme}, ${mood} emotional direction, ${bpm} BPM, ${key}, ${palette}, ${structure}, ${language} lyrics, ${era} production, strong memorable chorus, clear verse and chorus sections, no artist names, no copyrighted references.`,\n     mode: \"Song\"\n   });\n }\n*** End Patch\n"}}
